// Copy outside the repo (it names your domain), adjust, and pass to deploy/cloudflare.sh.
// Paths are relative to this file.
{
  "name": "redthread",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "example.com", "custom_domain": true }],
  "assets": {
    "directory": "../web/.cf-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // OG images, markdown twins and fulltext.json are in R2, and pages negotiate Accept:
    // text/markdown, so the Worker sees everything except static bundles and the JSON assets.
    // Exclusions win over inclusions, so /fulltext.json must not match any of them.
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/search-index/*", "!/v/*", "!/adjacency.json", "!/entries.json", "!/previews.json", "!/sources-index.json", "!/sources-uses.json", "!/tags-index.json", "!/timeline-data.json", "!/*.xml"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "redthread" }],
  "ai": { "binding": "AI" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Best-effort per-IP limit on /api/* and /mcp; Cloudflare keeps these counters per location and
  // lets bursts through, so pair it with a zone rate-limiting rule (docs/deployment.md).
  // namespace_id is any number unique in your account.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
