# Local config (template lives at config.example.json)
config.json

# Generated data — recreated by `py build/parse_vault.py`
data/*.json
data/*.jsonl
data/api/
data/md/

# Astro build artifacts
web/node_modules/
web/dist/
# Hardlink snapshot of the last good dist/, taken by rebuild.sh so a failed
# build can roll back instead of leaving the site empty. Transient.
web/.dist-rollback/
web/.astro/
web/src/content/generated/
# Same artifacts but at app/ root — happen when npm/astro gets run from
# this directory instead of app/web/. Harmless either way.
node_modules/
.astro/

# Content-addressed OG-card cache. Persisted across builds so unchanged
# entities don't re-render through satori+resvg. Safe to delete — next
# build just rebuilds whatever's missing.
web/.og-cache/

# Local preview output for OG card design work.
web/scripts/og-preview/out/

# Files copied into Astro public/ by the build scripts (regenerated)
web/public/previews.json
web/public/adjacency.json
web/public/api/
# Per-entity markdown companions for LLM consumption — one .md per
# entity, written by parse_vault → copied here by build.sh.
web/public/people/*.md
web/public/organizations/*.md
web/public/programs/*.md
web/public/events/*.md
web/public/concepts/*.md
web/public/places/*.md
web/public/sources/*.md
web/public/meta/*.md
web/public/misc/*.md
web/public/pages/*.md

# Python
__pycache__/
*.pyc
.venv/

# Secrets — Cloudflare Tunnel token etc. lives in deploy/.env or
# next to docker-compose.prod.yml on the server. Never committed.
.env
.env.local
.env.production

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
