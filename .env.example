# Path to your Obsidian vault. Relative paths start from this repo.
VAULT_PATH=../vault

# Public URL of the site, used for canonical links, social cards, the sitemap, and the feed.
SITE_URL=https://example.com
SITE_TITLE="My Archive"
SITE_DESCRIPTION="A linked archive of people, organizations, programs, and events."

# Local port for nginx. It binds to 127.0.0.1, so put a proxy or tunnel in front.
PORT=8080

# Optional analytics. Defaults to Umami's attribute; use data-domain for Plausible.
# ANALYTICS_ORIGIN is the script's origin, added to the Content-Security-Policy.
ANALYTICS_SRC=
ANALYTICS_ID=
ANALYTICS_ID_ATTR=
ANALYTICS_ORIGIN=

# deploy/rebuild.sh
# VAULT_PULL=1 runs `git pull --ff-only` in the vault before each check.
VAULT_PULL=0
REBUILD_INTERVAL=300
# healthchecks.io-style URL: pinged after each check, /fail when a build fails.
HEALTHCHECK_URL=
