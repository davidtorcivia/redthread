{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "packageRules": [
    { "matchManagers": ["npm"], "matchUpdateTypes": ["minor", "patch"], "groupName": "npm minor and patch" },
    { "matchManagers": ["pip_requirements"], "matchUpdateTypes": ["minor", "patch"], "groupName": "python minor and patch" },
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true },
    { "matchDepNames": ["astro"], "minimumReleaseAge": "14 days" }
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 5am on monday"] },
  "vulnerabilityAlerts": { "enabled": true }
}
