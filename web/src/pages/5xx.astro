---
import Base from '../layouts/Base.astro';
---
<Base
  title="Server error — The Info Web"
  description="Something went wrong on the server."
  noindex
>
  <article class="error-article">
    <div class="error-code">5xx</div>
    <h1 class="error-title">The signal dropped</h1>
    <p class="error-dek">
      Something went wrong on the server while loading this page.
      It's probably temporary — try again in a moment, or head back home.
    </p>

    <div class="error-actions">
      <a class="error-btn primary" href="/">Return home</a>
      <button type="button" class="error-btn" id="error-retry">Retry</button>
    </div>
  </article>

  {/* Listener instead of an inline onclick so a strict script-src CSP can't
      break it, matching how the rest of the site wires buttons. */}
  <script is:inline>
    document.getElementById('error-retry')?.addEventListener('click', () => {
      window.location.reload();
    });
  </script>
</Base>
