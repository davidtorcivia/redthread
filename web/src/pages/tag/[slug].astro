---
import Base from '../../layouts/Base.astro';
import {
  allTags,
  entitiesByTag,
  tagDisplayFor,
  hrefFor,
  renderInlineMd,
  TYPE_LABELS,
  TYPE_PLURALS,
} from '../../lib/data.ts';
import type { Entity, EntityType } from '../../lib/types.ts';

export function getStaticPaths() {
  return allTags().map((t) => ({
    params: { slug: t.slug },
    props: { tag: t.tag, count: t.count },
  }));
}

const { slug } = Astro.params as { slug: string };
const { tag, count } = Astro.props as { tag: string; count: number };

// Group entities by type so a tag like "Cold_War" splits neatly into
// People / Organizations / Events / Programs sections.
const ents = entitiesByTag(slug);
const TYPE_ORDER: EntityType[] = ['person', 'organization', 'program', 'event', 'concept', 'place'];
const byType: Record<string, Entity[]> = {};
for (const e of ents) {
  (byType[e.type] ||= []).push(e);
}
const groups = TYPE_ORDER
  .filter((t) => byType[t]?.length)
  .map((t) => ({
    type: t,
    label: TYPE_PLURALS[t],
    items: byType[t].slice().sort((a, b) => a.title.localeCompare(b.title)),
  }));
// Catch-all for any type not in TYPE_ORDER (source/meta/misc/page)
for (const [t, items] of Object.entries(byType)) {
  if (!TYPE_ORDER.includes(t as EntityType)) {
    groups.push({
      type: t as EntityType,
      label: TYPE_PLURALS[t as EntityType] ?? t,
      items: items.slice().sort((a, b) => a.title.localeCompare(b.title)),
    });
  }
}

// Type breakdown in the description so a tag with 23 people + 8 events reads
// differently from one with 5 concepts — better snippets, and LLMs can tell
// what kind of tag this is at a glance.
const breakdown = groups
  .map((g) => {
    const noun = g.items.length === 1 ? TYPE_LABELS[g.type] : g.label;
    return `${g.items.length} ${noun.toLowerCase()}`;
  })
  .join(', ');
const description = `${count.toLocaleString()} entr${count === 1 ? 'y' : 'ies'} tagged ${tag}${breakdown ? ` — ${breakdown}` : ''}.`;
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `#${tag} — The Info Web`,
  description,
  url: Astro.site ? new URL(`/tag/${slug}/`, Astro.site).href : `/tag/${slug}/`,
  ...(Astro.site ? { isPartOf: { '@id': `${new URL('/', Astro.site).href}#website` } } : {}),
  mainEntity: { '@type': 'ItemList', numberOfItems: count },
};
const breadcrumbs = [
  { name: 'Tags', item: '/tags/' },
  { name: `#${tag}`, item: `/tag/${slug}/` },
];
---
<Base
  title={`#${tag} — The Info Web`}
  description={description}
  jsonLd={collectionSchema}
  breadcrumbs={breadcrumbs}
>
  <header class="browse-header">
    <div class="kicker">
      <a href="/tags/">Tags</a>
    </div>
    <h1>#{tag}</h1>
    <p class="lead">
      {count.toLocaleString()} entr{count === 1 ? 'y' : 'ies'} tagged <em>{tag}</em>.
    </p>
  </header>

  <section class="browse-body">
    {groups.map((g) => (
      <section class="cat-section" data-collapsed="false">
        <h2>
          {g.label}
          <span class="count">({g.items.length})</span>
        </h2>
        <ul class="cat-list">
          {g.items.map((e) => (
            <li>
              <a class="entry-title" href={hrefFor({ id: e.id, type: e.type })}>
                {e.title}
              </a>
              {e.summary && <span class="entry-summary" set:html={renderInlineMd(e.summary)} />}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</Base>
