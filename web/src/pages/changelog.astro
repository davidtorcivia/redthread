---
import Base from '../layouts/Base.astro';
import { activity, hrefFor, renderInlineMd, TYPE_LABELS } from '../lib/data.ts';

const entries = activity().slice(0, 50);

// UTC, so a bare YYYY-MM-DD (parsed as UTC midnight) shows the same day on any build host.
function monthLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return 'Unknown';
  return d.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}
function dayLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
}

// Group by month so a long history stays scannable.
const grouped: { label: string; items: typeof entries }[] = [];
for (const e of entries) {
  const label = monthLabel(e.mtime);
  const last = grouped[grouped.length - 1];
  if (last && last.label === label) last.items.push(e);
  else grouped.push({ label, items: [e] });
}
---
<Base
  bodyClass="utility"
  title="Changelog"
  description="Recent additions and revisions to entries in the vault."
>
  <article class="changelog-article">
    <h1 class="entity-title">Changelog</h1>

    {entries.length === 0 && (
      <p class="changelog-empty">No activity recorded.</p>
    )}

    {grouped.map((group) => (
      <section class="cl-group">
        <h2 class="cl-month">{group.label}</h2>
        <ol class="cl-list">
          {group.items.map((e) => (
            <li class={`cl-entry type-${e.type}`}>
              <div class="cl-head">
                <span class="cl-day">{dayLabel(e.mtime)}</span>
                <span class="cl-type">{TYPE_LABELS[e.type]}</span>
                {e.category && <span class="cl-cat">{e.category}</span>}
              </div>
              <a class="cl-title" href={hrefFor(e)}>
                {e.title}
              </a>
              {e.summary && <p class="cl-summary" set:html={renderInlineMd(e.summary)} />}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </article>
</Base>
