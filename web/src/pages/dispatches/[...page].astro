---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Headline from '../../components/Headline.astro';
import { dispatches, dispatchHref, DISPATCHES_PER_PAGE, entity, hrefFor, renderInlineMd, TYPE_LABELS } from '../../lib/data.ts';

export const getStaticPaths = (({ paginate }) => paginate(dispatches(), { pageSize: DISPATCHES_PER_PAGE })) satisfies GetStaticPaths;

const { page } = Astro.props;
const items = page.data;
// Pages shift as dispatches are added, so an old /dispatches/#id link may now live on another page.
const homes = Object.fromEntries(dispatches().map((d) => [d.id, dispatchHref(d.id)]));

function dayLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---
<Base
  bodyClass="entity type-page"
  title={page.currentPage > 1 ? `Dispatches, page ${page.currentPage}` : 'Dispatches'}
  description="Findings that connect records across the vault, newest first."
>
  <article class="entity-article dispatches">
    <header class="statement-band entry-band">
      <Headline class="entity-title" title="Dispatches" />
      <div class="band-row">
        <p class="band-lede">Findings that connect records across the vault, newest first.</p>
        {page.lastPage > 1 && <div class="band-facts"><div>Page {page.currentPage} of {page.lastPage} · {page.total} dispatches</div></div>}
      </div>
    </header>

    {items.length === 0 && (
      <div class="statement-wrap"><div class="statement-read"><div class="prose"><p>No dispatches yet.</p></div></div></div>
    )}

    {items.map((d) => (
      <section class="dispatch" id={d.id}>
        <div class="statement-wrap">
          <div class="statement-read">
            <div class="prose">
              <h2><a href={`#${d.id}`}>{d.title}</a></h2>
              <p><time datetime={d.date}>{dayLabel(d.date)}</time></p>
              <Fragment set:html={d.body_html} />
            </div>
          </div>

        {d.footnotes.length > 0 && (
          <section class="footnotes-block">
            <h2 class="section-label">Sources</h2>
            <ol>
              {d.footnotes.map((f) => (
                <li id={`${d.id}-fn-${f.id}`}>
                  <span set:html={f.html ?? renderInlineMd(f.text)} />
                  {' '}<a class="fn-back" href={`#${d.id}-fnref-${f.id}`} aria-label="back to reference">↩</a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {d.entities.length > 0 && (
          <section class="backlinks hc-list-section" data-pagefind-ignore>
            <h2 class="section-heading">Entries <span class="hc-count-badge">{d.entities.length}</span></h2>
            <ul class="hc-list">
              {d.entities.map((id) => entity(id)).filter(Boolean).map((e) => (
                <li class={`hc-item type-${e!.type}`}>
                  <a href={hrefFor(e!)} data-preview>
                    <span class="hc-eyebrow">{TYPE_LABELS[e!.type]}</span>
                    <span class="hc-title">{e!.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        </div>
      </section>
    ))}

    {page.lastPage > 1 && (
      <div class="statement-wrap">
        <nav class="entry-pagination" aria-label="Dispatch pages">
          <span>{page.url.prev && <a href={page.url.prev}>← Newer</a>}</span>
          <span class="dispatch-pages">{Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => n === page.currentPage
            ? <b aria-current="page">{n}</b>
            : <a href={n === 1 ? '/dispatches/' : `/dispatches/${n}/`}>{n}</a>)}</span>
          <span>{page.url.next && <a href={page.url.next}>Older →</a>}</span>
        </nav>
      </div>
    )}
  </article>
  <script is:inline define:vars={{ homes }}>
    const id = decodeURIComponent(location.hash.slice(1));
    if (id && !document.getElementById(id) && homes[id]) location.replace(homes[id]);
  </script>
</Base>
