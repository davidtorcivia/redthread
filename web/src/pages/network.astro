---
import Base from '../layouts/Base.astro';
import GraphTools from '../components/GraphTools.astro';
import GraphCaption from '../components/GraphCaption.astro';
import GraphOverlay from '../components/GraphOverlay.astro';
import { entities } from '../lib/data.ts';

const total = entities().length;
---
<Base
  bodyClass="utility"
  title="Full network"
  description="Every entry in the vault rendered as a single navigable graph."
  preloadAdjacency
>
  <article class="network-article">
    <header class="network-header">
      <div class="network-heading"><h1 class="entity-title">Follow the connections.</h1><span class="network-total">{total.toLocaleString()} entries</span></div>
      <p class="entity-dek">Search for a name, select a node to see its links, or use Options to filter the graph.</p>
    </header>

    <GraphTools full id="full-network" />
    <section class="net-shell">
      <canvas
        class="net-canvas"
        role="img"
        aria-label={`Network graph of ${total.toLocaleString()} connected entries. Search or select an entry to explore its connections.`}
      ></canvas>
      <p class="sr-only">
        This is an interactive network visualization drawn on a canvas and explored
        with a pointer. For a keyboard- and screen-reader-accessible view of the same
        connections, browse entries by type from the site navigation, or use the
        <a href="/path/">path finder</a> to trace the chain between any two entries.
      </p>

      <div class="net-status">
        <button type="button" class="net-load">
          Load network <span class="net-load-hint">({total.toLocaleString()} nodes)</span>
        </button>
        <p class="net-load-warn">
          Load all entries and their connections.
        </p>
      </div>

      <GraphOverlay />
    </section>
    <GraphCaption />
  </article>

  <script>
    import { GraphEngine, nodeFromAdjacency, adjacencyEdges } from '../scripts/graph-canvas';
    import { closeness } from '../scripts/graph-rank';
    import { loadAdjacency } from '../scripts/adjacency';
    import { el, entityHref } from '../scripts/entity-types';
    // The whole vault. This file loads every node, supplies the whole-graph
    // layouts and wires the type chips; scripts/graph-canvas does the rest.

    const article = document.querySelector('.network-article');
    const status = article.querySelector('.net-status');
    const loadBtn = article.querySelector('.net-load');
    // Scales the parser's 0-1000 spring layout until clusters read at fit zoom.
    const FORCE_BASELINE = 6;
    // Chips only cover the main types; the rest always show.
    const activeTypes = new Set(['person', 'organization', 'program', 'event', 'concept', 'place', 'source', 'meta', 'misc', 'page']);
    let positions = null;
    let clusterPositions = null;
    let initStarted = false;

    const engine = new GraphEngine(article, {
      profile: 'full',
      showImplicit: false,
      fullscreenEl: article,
      layouts: [
        { key: 'clusters', label: 'Clusters', apply: applyClusterLayout },
        { key: 'force', label: 'Force', apply: applyForceLayout },
        { key: 'concentric', label: 'Concentric', apply: applyConcentricLayout },
      ],
      describe: (i) => {
        const n = engine.nodes[i];
        const near = engine.neighborSets[i];
        const lines = [[`${near.size.toLocaleString()} connections in this view`]];
        if (n.community >= 0 && engine.communityLabels[n.community]) lines.unshift([`Cluster: ${engine.communityLabels[n.community]}`]);
        // Closest: specific ties first, not the hubs that link to everything.
        const score = (j) => {
          let shared = 0;
          for (const x of engine.neighborSets[j]) if (near.has(x)) shared++;
          return closeness(shared, engine.neighborSets[j].size || 1, near.size);
        };
        const closest = [...near].map((j) => [j, score(j)]).sort((a, b) => b[1] - a[1]).slice(0, 5);
        if (closest.length) {
          const line = ['Closest: '];
          closest.forEach(([j], k) => {
            const a = el('a', '', engine.nodes[j].title);
            a.href = entityHref(engine.nodes[j].type, engine.nodes[j].id);
            line.push(...(k ? [', '] : []), a);
          });
          lines.push(line);
        }
        return lines;
      },
    });

    async function init() {
      if (initStarted) return;
      initStarted = true;
      loadBtn.disabled = true;
      loadBtn.textContent = 'Loading data…';
      let data;
      try {
        data = await loadAdjacency();
      } catch (err) {
        initStarted = false; // let the button retry
        loadBtn.disabled = false;
        loadBtn.textContent = 'Load network';
        status.querySelector('.net-load-warn').textContent =
          'Failed to load network data. Try again or check your connection.';
        console.error('[net]', err);
        return;
      }
      positions = data.positions;
      clusterPositions = data.clusterPositions ?? null;
      const nodes = data.ids.map((_, i) => {
        // Small dots: a constellation at fit zoom, not boulders.
        const size = 2 + Math.log2(1 + (data.mentions[i] || 0)) * 0.9 + (data.bridges[i] ? 1 : 0);
        // Entries with no connections add nothing to a graph view.
        const isolated = data.adj[i].length === 0;
        return { ...nodeFromAdjacency(data, i, Math.min(8, size)), g: i, isolated, visible: !isolated };
      });
      // The most-mentioned entry of each cluster is always labelled, so the force and
      // concentric layouts have something to orient by. (Clusters get their own names.)
      const top = new Map();
      for (const n of nodes) if (!n.isolated && n.count > (top.get(n.community)?.count ?? -1)) top.set(n.community, n);
      for (const n of top.values()) n.isLandmark = true;
      const { edges, implicit } = adjacencyEdges(data, new Map(nodes.map((_, i) => [i, i])));

      engine.communityLabels = data.communityLabels;
      engine.colorMode = 'community';
      engine.setGraph(nodes, edges, implicit);
      status.hidden = true;
      article.querySelector('.net-controls').hidden = false;
      engine.resize();
      engine.applyLayout();
      engine.wire();

      for (const chip of article.querySelectorAll('.net-chip')) {
        chip.addEventListener('click', () => {
          const on = chip.classList.toggle('active');
          chip.setAttribute('aria-pressed', String(on));
          if (on) activeTypes.add(chip.dataset.type); else activeTypes.delete(chip.dataset.type);
          for (const n of engine.nodes) n.visible = !n.isolated && activeTypes.has(n.type);
          engine.selectionChanged();
        });
      }
    }

    // --- Layouts (mutate g.nodes in place) ------------------------------
    // Pack each link community into its own island, biggest first, as close to
    // the centre as the canvas aspect allows. Force keeps the raw topology.
    function applyClusterLayout(g) {
      const communities = new Map();
      for (const n of g.nodes) {
        if (!n.visible) continue;
        if (!communities.has(n.community)) communities.set(n.community, []);
        communities.get(n.community).push(n);
      }
      const groups = [...communities.values()].filter((members) => members.length >= 8);
      const fragments = [...communities.values()].filter((members) => members.length < 8).flat();
      if (fragments.length) groups.push(fragments);
      groups.sort((a, b) => b.length - a.length);
      const placed = [];
      const { W, H } = g.canvasSize();
      const aspect = Math.max(.7, Math.min(2.1, W / H));
      for (const members of groups) {
        const radius = Math.sqrt(members.length) * 21 + 50;
        let best = { x: 0, y: 0, score: placed.length ? Infinity : 0 };
        for (const other of placed) {
          for (let step = 0; step < 96; step++) {
            const angle = step / 96 * Math.PI * 2;
            const x = other.x + Math.cos(angle) * (radius + other.radius + 65);
            const y = other.y + Math.sin(angle) * (radius + other.radius + 65);
            if (placed.some((p) => Math.hypot(p.x - x, p.y - y) < p.radius + radius + 60)) continue;
            const score = (x * x) / (aspect * aspect) + y * y;
            if (score < best.score) best = { x, y, score };
          }
        }
        placed.push({ x: best.x, y: best.y, radius });
        const c = members[0].community;
        const named = members.length >= 8 && members.every((n) => n.community === c) && g.communityLabels[c];
        // Inside an island, the parser's weighted layout puts entries that cite each
        // other most side by side. The mixed bag of small fragments gets a spiral.
        if (clusterPositions && members.every((n) => n.community === c)) {
          let extent = 0;
          for (const n of members) {
            n.x = best.x + clusterPositions[n.g][0] * (radius - 45);
            n.y = best.y + clusterPositions[n.g][1] * (radius - 45);
            extent = Math.max(extent, Math.hypot(n.x - best.x, n.y - best.y));
          }
          // The name hugs the dots, not the island's nominal radius.
          if (named) g.annotations.push({ x: best.x, y: best.y, r: extent + 6, text: g.communityLabels[c] });
          continue;
        }
        if (named) g.annotations.push({ x: best.x, y: best.y, r: radius - 40, text: g.communityLabels[c] });
        members.sort((a, b) => b.count - a.count || a.title.localeCompare(b.title));
        // Sunflower spiral: the most-mentioned sit at the island's centre.
        members.forEach((n, i) => {
          const angle = i * 2.399963229728653;
          const distance = Math.sqrt(i / Math.max(1, members.length - 1)) * (radius - 45);
          n.x = best.x + Math.cos(angle) * distance;
          n.y = best.y + Math.sin(angle) * distance;
        });
      }
    }
    function applyForceLayout(g) {
      const scale = FORCE_BASELINE * g.forceMult;
      g.nodes.forEach((n, i) => { n.x = positions[i][0] * scale; n.y = positions[i][1] * scale; });
    }
    // Bridges in the middle by rank, then by mentions outward, eight rings.
    function applyConcentricLayout(g) {
      const sorted = g.nodes.filter((n) => n.visible).sort((a, b) =>
        (b.bridgeRank ? 1 : 0) - (a.bridgeRank ? 1 : 0) || a.bridgeRank - b.bridgeRank || b.count - a.count);
      const perRing = Math.ceil(sorted.length / 8);
      sorted.forEach((n, i) => {
        const r = 80 + Math.floor(i / perRing) * 90;
        const angle = (i % perRing) * ((2 * Math.PI) / Math.max(1, perRing));
        n.x = Math.cos(angle) * r;
        n.y = Math.sin(angle) * r;
      });
    }

    loadBtn.addEventListener('click', init);
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { observer.disconnect(); init(); }
    }, { rootMargin: '200px' });
    observer.observe(article);
  </script>
</Base>
