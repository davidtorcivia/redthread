---
import Base from '../layouts/Base.astro';
import { entities } from '../lib/data.ts';

const total = entities().length;
---
<Base
  title="Full network — The Info Web"
  description="Every entry in the vault rendered as a single navigable graph."
  preloadAdjacency
>
  <article class="network-article" id="net-article">
    <header class="network-header">
      <div class="entity-eyebrow"><span>Tools</span></div>
      <h1 class="entity-title">The full network</h1>
      <p class="entity-dek">
        Every {total.toLocaleString()} entries in the vault on one map.
        <strong>Scroll</strong> to zoom, <strong>drag</strong> to pan,
        <strong>click</strong> a node or connection line to select,
        <strong>double-click</strong> a node to navigate.
        Use the sliders to dim everything or spread Force layout farther apart.
        Bridge entities are ringed in gold; edges that touch them tint gold too.
      </p>
    </header>

    <section class="net-shell" id="net-shell">
      <canvas
        class="net-canvas"
        id="net-canvas"
        role="img"
        aria-label={`Network graph of ${total.toLocaleString()} connected entries — a pointer-driven visual tool.`}
      ></canvas>
      {/* The canvas can't be navigated by keyboard or screen reader; point AT
          users at the structured, fully-accessible views of the same data. */}
      <p class="sr-only">
        This is an interactive network visualization drawn on a canvas and explored
        with a pointer. For a keyboard- and screen-reader-accessible view of the same
        connections, browse entries by type from the site navigation, or use the
        <a href="/path/">path finder</a> to trace the chain between any two entries.
      </p>

      <div class="net-status" id="net-status">
        <button type="button" class="net-load" id="net-load">
          Load network <span class="net-load-hint">({total.toLocaleString()} nodes)</span>
        </button>
        <p class="net-load-warn">
          Renders the entire vault as a single canvas. Should be near-instant on modern browsers.
        </p>
      </div>

      <div class="net-controls net-drawer net-drawer-right" hidden id="net-controls">
        <button class="net-drawer-toggle" id="net-controls-toggle" type="button" aria-label="Toggle settings" aria-expanded="true">
          <span class="net-carrot" aria-hidden="true"></span>
        </button>
        <div class="net-drawer-body net-controls-body">
          <button class="graph-btn net-layout" type="button">Layout: Force</button>
          <button class="graph-btn net-fit" type="button">Refit</button>
          <button class="graph-btn net-edges" type="button" aria-pressed="true">Hide edges</button>
          <button class="graph-btn net-implicit" type="button" aria-pressed="false">+ Inferred</button>
          <button class="graph-btn net-multi" type="button" aria-pressed="false">Multi: off</button>
          <button class="graph-btn net-fullscreen" type="button" aria-pressed="false">Fullscreen</button>
        </div>
      </div>

      <div class="net-sliders net-drawer net-drawer-right" hidden id="net-sliders">
        <button class="net-drawer-toggle" id="net-sliders-toggle" type="button" aria-label="Toggle sliders" aria-expanded="true">
          <span class="net-carrot" aria-hidden="true"></span>
        </button>
        <div class="net-drawer-body net-sliders-body">
          <label class="net-slider" id="net-opacity-slider">
            <span class="net-slider-label">Opacity</span>
            <input type="range" class="net-slider-input" id="net-opacity" min="0" max="100" value="100" />
            <span class="net-slider-val" id="net-opacity-val">100%</span>
          </label>
          <label class="net-slider" id="net-highlight-slider" title="How much non-related elements fade when something is selected. Lower = selection overlays the full network; higher = quick read.">
            <span class="net-slider-label">Highlight</span>
            <input type="range" class="net-slider-input" id="net-highlight" min="0" max="100" value="100" />
            <span class="net-slider-val" id="net-highlight-val">100%</span>
          </label>
          <label class="net-slider" id="net-force-slider">
            <span class="net-slider-label">Force</span>
            <input type="range" class="net-slider-input" id="net-force" min="50" max="400" value="100" />
            <span class="net-slider-val" id="net-force-val">100%</span>
          </label>
        </div>
      </div>

      <div class="net-filters net-drawer net-drawer-left" hidden id="net-filters" aria-label="Filter by type">
        <div class="net-drawer-body net-filters-body">
          <span class="net-filters-label">Show</span>
          <button class="net-chip active type-person" data-type="person" aria-pressed="true">People</button>
          <button class="net-chip active type-organization" data-type="organization" aria-pressed="true">Orgs</button>
          <button class="net-chip active type-program" data-type="program" aria-pressed="true">Programs</button>
          <button class="net-chip active type-event" data-type="event" aria-pressed="true">Events</button>
          <button class="net-chip active type-concept" data-type="concept" aria-pressed="true">Concepts</button>
          <button class="net-chip active type-place" data-type="place" aria-pressed="true">Places</button>
        </div>
        <button class="net-drawer-toggle" id="net-filters-toggle" type="button" aria-label="Toggle filters" aria-expanded="true">
          <span class="net-carrot" aria-hidden="true"></span>
        </button>
      </div>

      <div class="graph-selection net-selection" hidden id="net-selection">
        <div class="gs-row">
          <span class="gs-eyebrow"></span>
          <span class="gs-title"></span>
        </div>
        <div class="gs-meta"><span class="gs-count"></span> mentions across the vault</div>
        <div class="gs-bridge" hidden>Bridge entity (rank <span class="gs-bridge-rank"></span>)</div>
        <div class="gs-hub" hidden>Hub entity (rank <span class="gs-hub-rank"></span>)</div>
        <div class="gs-summary" hidden></div>
        <div class="gs-actions">
          <a class="gs-go" href="#">Go to page &rarr;</a>
          <button class="gs-deselect" type="button">Clear</button>
        </div>
      </div>

      <div class="graph-tooltip net-tooltip" hidden id="net-tooltip"></div>
    </section>

    {/* Legend — the canvas encodes type/size/edge-kind/bridge with no
        on-screen key, so spell them out. Native <details> keeps it
        collapsed by default and needs no JS. */}
    <details class="net-legend">
      <summary>Legend — how to read this graph</summary>
      <div class="net-legend-body">
        <div class="nl-group">
          <span class="nl-group-label">Node colour — type</span>
          <ul class="nl-types">
            <li><span class="nl-dot t-person"></span>People</li>
            <li><span class="nl-dot t-organization"></span>Organizations</li>
            <li><span class="nl-dot t-program"></span>Programs</li>
            <li><span class="nl-dot t-event"></span>Events</li>
            <li><span class="nl-dot t-concept"></span>Concepts</li>
            <li><span class="nl-dot t-place"></span>Places</li>
          </ul>
        </div>
        <div class="nl-group">
          <span class="nl-group-label">Node size</span>
          <p class="nl-row">
            <span class="nl-dot nl-dot-sm"></span><span class="nl-dot nl-dot-lg"></span>
            Larger = more mentions across the vault.
          </p>
        </div>
        <div class="nl-group">
          <span class="nl-group-label">Connections</span>
          <p class="nl-row"><span class="nl-line"></span> Explicit link (wikilink between entries).</p>
          <p class="nl-row"><span class="nl-line dashed"></span> Inferred connection (name co-mention) — shown via “+ Inferred”.</p>
        </div>
        <div class="nl-group">
          <span class="nl-group-label">Highlights</span>
          <p class="nl-row"><span class="nl-ring gold"></span> Gold ring (and gold edges) — a bridge entity linking distant clusters.</p>
          <p class="nl-row"><span class="nl-ring accent"></span> Accent ring — your current selection.</p>
        </div>
      </div>
    </details>
  </article>

  <script is:inline>
    /**
     * Pure-canvas network renderer. Cytoscape (used elsewhere in this site
     * for the per-entity graph) pays a per-element abstraction cost that
     * adds up to ~10 seconds of frozen tab at 1,811 nodes + 12,000 edges.
     * Drawing the same data into a canvas takes ~10 ms.
     *
     * State lives in plain arrays + a transform; redraws are triggered
     * by mouse handlers and run on rAF so input never blocks paint.
     */
    (function () {
      const article = document.getElementById('net-article');
      const shell = document.getElementById('net-shell');
      const canvas = document.getElementById('net-canvas');
      const ctx = canvas.getContext('2d');
      const status = document.getElementById('net-status');
      const loadBtn = document.getElementById('net-load');
      const controls = document.getElementById('net-controls');
      const filters = document.getElementById('net-filters');
      const layoutBtn = controls.querySelector('.net-layout');
      const fitBtn = controls.querySelector('.net-fit');
      const edgesBtn = controls.querySelector('.net-edges');
      const fullscreenBtn = controls.querySelector('.net-fullscreen');
      const sliders = document.getElementById('net-sliders');
      const opacityInput = document.getElementById('net-opacity');
      const opacityVal = document.getElementById('net-opacity-val');
      const forceSlider = document.getElementById('net-force-slider');
      const forceInput = document.getElementById('net-force');
      const forceVal = document.getElementById('net-force-val');
      const highlightInput = document.getElementById('net-highlight');
      const highlightVal = document.getElementById('net-highlight-val');
      const panel = document.getElementById('net-selection');
      const tooltip = document.getElementById('net-tooltip');

      const TYPE_DIRS = {
        person: 'people', organization: 'organizations', program: 'programs',
        event: 'events', concept: 'concepts', place: 'places',
        source: 'sources', meta: 'meta', misc: 'misc', page: 'pages',
      };
      const TYPE_LABELS = {
        person: 'Person', organization: 'Organization', program: 'Program',
        event: 'Event', concept: 'Concept', place: 'Place',
        source: 'Source', meta: 'Meta', misc: 'Misc', page: 'Page',
      };

      function readColors() {
        const cs = getComputedStyle(document.documentElement);
        const get = (v, f) => (cs.getPropertyValue(v).trim() || f);
        return {
          person: get('--t-person', '#8a5a1f'),
          organization: get('--t-organization', '#2d6864'),
          program: get('--t-program', '#3f3d8b'),
          event: get('--t-event', '#94322a'),
          concept: get('--t-concept', '#5e6b32'),
          place: get('--t-place', '#735237'),
          source: get('--t-source', '#6a6258'),
          muted: get('--muted', '#6a6258'),
          line: get('--line-2', '#c8bca0'),
          accent: get('--accent', '#94322a'),
          accentSoft: get('--accent-soft', '#c97a6a'),
          ink: get('--ink', '#1a1814'),
          paper: get('--paper', '#f7f2e7'),
          gold: get('--gold', '#8a6e25'),
        };
      }

      // --- Renderer state -------------------------------------------------
      const COLORS = readColors();
      /** @type {{id:string,title:string,type:string,x:number,y:number,size:number,
                  color:string,bridgeRank:number,bridgeScore:number,
                  hubRank:number,hubScore:number,count:number,
                  visible:boolean}[]} */
      let nodes = [];
      /** @type {[number,number][]} pairs of node indices */
      let edges = [];
      let edgesVisible = true;
      /** Implicit (NER-inferred) edges are hidden by default. Toggling
       *  "+ Inferred" includes them, drawn as dashed lines so the user
       *  can tell which connections are confirmed wikilinks vs guesses. */
      let showImplicit = false;
      /** Set of edge indices (into the `edges` array) whose underlying
       *  pair is implicit-only (no explicit wikilink). Built in init(). */
      let implicitEdgeIdx = null;
      const activeTypes = new Set([
        'person','organization','program','event','concept','place',
        'source','meta','misc','page',
      ]);
      let hoveredIdx = -1;
      let hoveredEdge = -1;
      /** Selections are Sets so multi-select (shift-click or Multi mode)
       *  can hold an arbitrary number of nodes and/or edges. The old
       *  scalar selectedIdx / selectedEdge state is gone. */
      const selectedNodes = new Set();
      const selectedEdges = new Set();
      let multiMode = false;
      /** When anything is selected, this set holds the node indices that
       *  remain "in focus" (selected nodes + their neighbors + endpoints
       *  of selected edges). Everything outside the set fades back. */
      let focusNodes = null;
      /** transform: model (x,y) maps to screen (x*scale + tx, y*scale + ty) */
      const view = { tx: 0, ty: 0, scale: 1 };
      /** Active layout key — controls visibility of the Force slider. */
      let currentLayout = 'force';
      /** Tunable multipliers driven by the slider controls. */
      let opacityMult = 1.0;       // 0.0 .. 1.0, dims nodes + labels
      let forceMult = 1.0;         // 0.5 .. 4.0, scales Force layout spread
      /** How aggressively the selection fades non-related elements.
       *  1.0 = strong fade (out-of-focus at ~0.08), 0.0 = no fade
       *  (out-of-focus stays at its normal opacity, only the rings
       *  mark the selection). Lets the user trade between instant
       *  read and seeing the selection in full network context. */
      let highlightStrength = 1.0;
      /** Raw spring_layout positions in their parser-normalized 0-1000
       *  range. Force layout multiplies these by a baseline scale * the
       *  Force slider so the user can spread the graph apart on demand. */
      let rawForcePositions = null;
      /** Pre-computed for each node: set of neighbor indices. Built once
       *  in init(), used for fast neighbor lookup during selection. */
      let neighborSets = null;

      // --- Canvas + DPR ---------------------------------------------------
      let dpr = Math.max(1, window.devicePixelRatio || 1);
      function resizeCanvas() {
        const rect = shell.getBoundingClientRect();
        dpr = Math.max(1, window.devicePixelRatio || 1);
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
        requestDraw();
      }
      window.addEventListener('resize', () => { resizeCanvas(); });

      // --- Drawing --------------------------------------------------------
      let drawScheduled = false;
      function requestDraw() {
        if (drawScheduled) return;
        drawScheduled = true;
        requestAnimationFrame(() => { drawScheduled = false; draw(); });
      }
      function recomputeFocus() {
        if (selectedNodes.size === 0 && selectedEdges.size === 0) {
          focusNodes = null;
          return;
        }
        focusNodes = new Set();
        for (const idx of selectedNodes) {
          focusNodes.add(idx);
          if (neighborSets) {
            for (const n of neighborSets[idx]) focusNodes.add(n);
          }
        }
        for (const k of selectedEdges) {
          const e = edges[k];
          focusNodes.add(e[0]);
          focusNodes.add(e[1]);
        }
      }

      function modelToScreenX(x) { return x * view.scale + view.tx; }
      function modelToScreenY(y) { return y * view.scale + view.ty; }
      function screenToModelX(x) { return (x - view.tx) / view.scale; }
      function screenToModelY(y) { return (y - view.ty) / view.scale; }

      function draw() {
        if (!nodes.length) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = COLORS.paper;
        ctx.fillRect(0, 0, canvas.width / dpr, canvas.height / dpr);

        // Visible viewport in model coordinates — for culling. Culling is
        // a big win at high zoom where the user is looking at a small slice
        // of the graph.
        const viewport = {
          x0: screenToModelX(-50),
          y0: screenToModelY(-50),
          x1: screenToModelX(canvas.width / dpr + 50),
          y1: screenToModelY(canvas.height / dpr + 50),
        };

        // Selection state — used throughout the draw pass to decide
        // whether to fade non-related elements.
        const hasSelection = (selectedNodes.size > 0 || selectedEdges.size > 0);

        // Edges of interest: incident on any selected node, or any
        // selected edge itself, plus a softer hover set.
        const focusEdges = new Set();
        if (edgesVisible) {
          if (selectedNodes.size > 0) {
            for (let i = 0; i < edges.length; i++) {
              const e = edges[i];
              if (selectedNodes.has(e[0]) || selectedNodes.has(e[1])) focusEdges.add(i);
            }
          }
          for (const k of selectedEdges) focusEdges.add(k);
        }
        const hoverEdges = new Set();
        if (hoveredIdx >= 0 && !selectedNodes.has(hoveredIdx) && edgesVisible) {
          for (let i = 0; i < edges.length; i++) {
            const e = edges[i];
            if (e[0] === hoveredIdx || e[1] === hoveredIdx) hoverEdges.add(i);
          }
        }
        if (hoveredEdge >= 0 && !selectedEdges.has(hoveredEdge)) hoverEdges.add(hoveredEdge);

        // --- Edges (only if toggled on) -----------------------------------
        if (edgesVisible) {
          // When something is selected, non-focus edges fade according
          // to the Highlight slider. 1.0 → strong fade (0.06), 0.0 →
          // no fade (stay at the normal 0.32 background opacity).
          const fadedAlpha = 0.32 - (0.32 - 0.06) * highlightStrength;
          const bgAlpha = hasSelection ? fadedAlpha : 0.32;
          ctx.lineWidth = 0.7;

          // Helper: draw the subset of edges that match a kind predicate
          // and a bridge predicate, with the current stroke style. Edges
          // already claimed by hover or selection are skipped because
          // they're drawn on top later.
          function drawPass(kindOK, bridgeOK) {
            ctx.beginPath();
            for (let i = 0; i < edges.length; i++) {
              if (focusEdges.has(i) || hoverEdges.has(i)) continue;
              const isImpl = implicitEdgeIdx && implicitEdgeIdx.has(i);
              if (!kindOK(isImpl)) continue;
              const e = edges[i];
              const a = nodes[e[0]], b = nodes[e[1]];
              if (!a.visible || !b.visible) continue;
              if (!bridgeOK(a, b)) continue;
              if ((a.x < viewport.x0 && b.x < viewport.x0) ||
                  (a.x > viewport.x1 && b.x > viewport.x1) ||
                  (a.y < viewport.y0 && b.y < viewport.y0) ||
                  (a.y > viewport.y1 && b.y > viewport.y1)) continue;
              ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
              ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
            }
            ctx.stroke();
          }

          // ----- Solid background edges (explicit wikilinks).
          ctx.setLineDash([]);
          ctx.strokeStyle = hexToRgba(COLORS.gold, bgAlpha * 0.8);
          drawPass((isImpl) => !isImpl, (a, b) => !!(a.bridgeRank || b.bridgeRank));
          ctx.strokeStyle = hexToRgba(COLORS.accentSoft || COLORS.line, bgAlpha);
          drawPass((isImpl) => !isImpl, (a, b) => !a.bridgeRank && !b.bridgeRank);

          // ----- Dashed background edges (NER-inferred). Only when the
          //       user opted in via the "+ Inferred" button.
          if (showImplicit) {
            ctx.setLineDash([4, 3]);
            ctx.lineWidth = 0.6;
            ctx.strokeStyle = hexToRgba(COLORS.gold, bgAlpha * 0.8);
            drawPass((isImpl) => isImpl, (a, b) => !!(a.bridgeRank || b.bridgeRank));
            ctx.strokeStyle = hexToRgba(COLORS.accentSoft || COLORS.line, bgAlpha);
            drawPass((isImpl) => isImpl, (a, b) => !a.bridgeRank && !b.bridgeRank);
            ctx.setLineDash([]);
            ctx.lineWidth = 0.7;
          }

          // ----- Hover overlay. ALWAYS shows implicit edges from the
          // hovered node, regardless of the global "+ Inferred" toggle —
          // when the user is asking "what is this connected to?" the
          // answer should include the NER-inferred connections too.
          // Style preserves dashed vs solid so the user can tell which
          // are wikilinked vs inferred.
          if (hoverEdges.size) {
            ctx.lineWidth = 1.1;
            ctx.strokeStyle = hexToRgba(COLORS.accent, 0.55);
            ctx.setLineDash([]);
            ctx.beginPath();
            hoverEdges.forEach((i) => {
              if (implicitEdgeIdx && implicitEdgeIdx.has(i)) return;
              const e = edges[i];
              const a = nodes[e[0]], b = nodes[e[1]];
              if (!a.visible || !b.visible) return;
              ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
              ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
            });
            ctx.stroke();
            ctx.setLineDash([4, 3]);
            ctx.beginPath();
            hoverEdges.forEach((i) => {
              if (!(implicitEdgeIdx && implicitEdgeIdx.has(i))) return;
              const e = edges[i];
              const a = nodes[e[0]], b = nodes[e[1]];
              if (!a.visible || !b.visible) return;
              ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
              ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
            });
            ctx.stroke();
            ctx.setLineDash([]);
          }

          // ----- Selected edges — thicker, full accent. Edges that
          // connect two SELECTED nodes get a slightly thicker treatment
          // (the gold-tinted "between selections" layer) so multi-select
          // makes the actual interconnections inside the chosen set
          // pop out from edges going outward. As with hover, implicit
          // edges from selected nodes always render regardless of the
          // global "+ Inferred" toggle.
          if (focusEdges.size) {
            const goldEdges = new Set();
            if (selectedNodes.size > 1) {
              focusEdges.forEach((i) => {
                const e = edges[i];
                if (selectedNodes.has(e[0]) && selectedNodes.has(e[1])) goldEdges.add(i);
              });
            }
            // Solid accent for non-implicit focus edges (excluding gold).
            ctx.lineWidth = 1.8;
            ctx.strokeStyle = COLORS.accent;
            ctx.setLineDash([]);
            ctx.beginPath();
            focusEdges.forEach((i) => {
              if (implicitEdgeIdx && implicitEdgeIdx.has(i)) return;
              if (goldEdges.has(i)) return;
              const e = edges[i];
              const a = nodes[e[0]], b = nodes[e[1]];
              if (!a.visible || !b.visible) return;
              ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
              ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
            });
            ctx.stroke();
            // Dashed accent for implicit focus edges (always shown).
            ctx.setLineDash([5, 4]);
            ctx.beginPath();
            focusEdges.forEach((i) => {
              if (!(implicitEdgeIdx && implicitEdgeIdx.has(i))) return;
              if (goldEdges.has(i)) return;
              const e = edges[i];
              const a = nodes[e[0]], b = nodes[e[1]];
              if (!a.visible || !b.visible) return;
              ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
              ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
            });
            ctx.stroke();
            ctx.setLineDash([]);
            // Between-selected edges — thicker + gold so the actual
            // interconnections among the chosen set are obvious.
            if (goldEdges.size) {
              ctx.lineWidth = 2.6;
              ctx.strokeStyle = COLORS.gold;
              ctx.beginPath();
              goldEdges.forEach((i) => {
                const isImpl = implicitEdgeIdx && implicitEdgeIdx.has(i);
                if (isImpl) return; // solid pass
                const e = edges[i];
                const a = nodes[e[0]], b = nodes[e[1]];
                if (!a.visible || !b.visible) return;
                ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
                ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
              });
              ctx.stroke();
              ctx.setLineDash([5, 4]);
              ctx.beginPath();
              goldEdges.forEach((i) => {
                const isImpl = implicitEdgeIdx && implicitEdgeIdx.has(i);
                if (!isImpl) return; // dashed pass
                const e = edges[i];
                const a = nodes[e[0]], b = nodes[e[1]];
                if (!a.visible || !b.visible) return;
                ctx.moveTo(modelToScreenX(a.x), modelToScreenY(a.y));
                ctx.lineTo(modelToScreenX(b.x), modelToScreenY(b.y));
              });
              ctx.stroke();
              ctx.setLineDash([]);
            }
          }
        }

        // --- Nodes --------------------------------------------------------
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          if (!n.visible) continue;
          // Cull off-screen
          const sx = modelToScreenX(n.x);
          const sy = modelToScreenY(n.y);
          const sr = n.size * view.scale;
          if (sx + sr < 0 || sx - sr > canvas.width / dpr ||
              sy + sr < 0 || sy - sr > canvas.height / dpr) continue;

          // Three opacity tiers:
          //   • Selected/hovered: full opacity, pops to the front
          //   • In the current focus set (or no selection active): default
          //   • Outside focus (selection active): faded so the picked
          //     subgraph reads clearly
          const isSelected = selectedNodes.has(i);
          const isMain = isSelected || i === hoveredIdx;
          const inFocus = !focusNodes || focusNodes.has(i);
          // Out-of-focus alpha lerps between the in-focus value (0.55,
          // i.e. no fade) and the strong-fade value (0.08) based on
          // the Highlight slider. At 0 the selection makes nothing
          // dim; at 1 (default) it fully fades the rest back.
          const fadeAlpha = 0.55 - (0.55 - 0.08) * highlightStrength;
          const base = isMain ? 1 : (inFocus ? 0.55 : fadeAlpha);
          ctx.globalAlpha = isMain ? base : base * opacityMult;
          ctx.fillStyle = n.color;
          ctx.beginPath();
          ctx.arc(sx, sy, sr, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;

          // Bridge ring (gold). Fades with the node when not in focus.
          if (n.bridgeRank) {
            ctx.strokeStyle = inFocus
              ? COLORS.gold
              : hexToRgba(COLORS.gold, 0.18);
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(sx, sy, sr + 1.2, 0, Math.PI * 2);
            ctx.stroke();
          }

          // Selection / hover ring
          if (isSelected) {
            ctx.strokeStyle = COLORS.accent;
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(sx, sy, sr + 3, 0, Math.PI * 2);
            ctx.stroke();
          } else if (i === hoveredIdx) {
            ctx.strokeStyle = COLORS.accent;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(sx, sy, sr + 2, 0, Math.PI * 2);
            ctx.stroke();
          }
        }

        // --- Labels with collision detection.
        // Gather candidates ordered by priority:
        //   tier 0: hovered/selected (always — placed first, can't be skipped)
        //   tier 1: landmarks (top-20 by mention count) in mention order
        //   tier 2: any other node where screen radius > a hi threshold
        // For each candidate (in tier order), compute its label rect and
        // skip if it would overlap any already-placed rect. Result: dense
        // areas only show the most prominent node's label, sparse areas
        // fill in nicely as the user zooms.
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const W = canvas.width / dpr;
        const H = canvas.height / dpr;
        const candidates = [];
        // Non-focus labels are only hidden when the Highlight slider is
        // strong enough that they'd be barely visible anyway. At low
        // values the user wants to see the selection in network context,
        // so leave the landmark/zoom-driven labels alone.
        const suppressOuterLabels = hasSelection && highlightStrength > 0.4;
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          if (!n.visible) continue;
          if (suppressOuterLabels && focusNodes && !focusNodes.has(i)) {
            if (i !== hoveredIdx) continue;
          }
          const sx = modelToScreenX(n.x);
          const sy = modelToScreenY(n.y);
          if (sx < -200 || sx > W + 200 || sy < -40 || sy > H + 40) continue;
          const sr = n.size * view.scale;
          const isHover = i === hoveredIdx || selectedNodes.has(i);
          // Inside a selection, all focus-set nodes get a label even if
          // the zoom would normally hide them — that's the point.
          const inFocusSet = focusNodes && focusNodes.has(i);
          let tier;
          if (isHover) tier = 0;
          else if (inFocusSet) tier = 1;
          else if (n.isLandmark) tier = 1;
          else if (sr >= 9) tier = 2;
          else continue;
          candidates.push({ i, n, sx, sy, sr, tier, isHover });
        }
        // Sort: lower tier first; within a tier, higher mention count first
        candidates.sort((a, b) => a.tier - b.tier || b.n.count - a.n.count);

        const drawn = [];
        function boxesOverlap(a, b) {
          return !(a.x1 < b.x0 || b.x1 < a.x0 || a.y1 < b.y0 || b.y1 < a.y0);
        }
        for (const c of candidates) {
          const fontSize = c.isHover ? 13 : (c.n.isLandmark ? 11 : 10);
          ctx.font = `${c.isHover || c.n.isLandmark ? 600 : 500} ${fontSize}px "Inter Tight", sans-serif`;
          const text = c.n.title;
          const metrics = ctx.measureText(text);
          const padX = 4, padY = 2;
          const labelY = c.sy + c.sr + 4;
          const box = {
            x0: c.sx - metrics.width / 2 - padX,
            x1: c.sx + metrics.width / 2 + padX,
            y0: labelY - 1,
            y1: labelY + fontSize + 2 * padY,
          };
          // Hovered/selected labels always win (tier 0) — push everyone
          // else aside. Otherwise, skip if any previously-drawn label
          // would overlap.
          if (c.tier > 0) {
            let collide = false;
            for (let k = 0; k < drawn.length; k++) {
              if (boxesOverlap(drawn[k], box)) { collide = true; break; }
            }
            if (collide) continue;
          }
          // Dim labels along with nodes. Hover/select labels stay full
          // opacity so they remain legible at any slider position.
          const labelMult = c.isHover ? 1 : opacityMult;
          ctx.globalAlpha = labelMult;
          ctx.fillStyle = hexToRgba(COLORS.paper, c.isHover ? 0.95 : 0.85);
          ctx.fillRect(box.x0, box.y0, box.x1 - box.x0, box.y1 - box.y0);
          ctx.fillStyle = c.isHover ? COLORS.accent : COLORS.ink;
          ctx.fillText(text, c.sx, labelY + padY - 1);
          ctx.globalAlpha = 1;
          drawn.push(box);
        }
      }

      function hexToRgba(hex, a) {
        // Accepts #rgb, #rrggbb, or rgb()/rgba(). Returns rgba string.
        if (hex.startsWith('rgb')) return hex;
        let h = hex.replace('#', '');
        if (h.length === 3) h = h.split('').map((c) => c + c).join('');
        const r = parseInt(h.substring(0, 2), 16);
        const g = parseInt(h.substring(2, 4), 16);
        const b = parseInt(h.substring(4, 6), 16);
        return `rgba(${r},${g},${b},${a})`;
      }

      // --- Hit-testing ----------------------------------------------------
      function hitTest(sx, sy) {
        // Returns the index of the topmost node under (sx, sy) in screen
        // coordinates, or -1. Naive O(n) scan — at 1,811 nodes this runs
        // in well under a millisecond per mousemove.
        let best = -1;
        let bestRadius = -1;
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          if (!n.visible) continue;
          const nx = modelToScreenX(n.x);
          const ny = modelToScreenY(n.y);
          const r = Math.max(3, n.size * view.scale);
          const dx = nx - sx;
          const dy = ny - sy;
          if (dx * dx + dy * dy <= r * r && r > bestRadius) {
            best = i; bestRadius = r;
          }
        }
        return best;
      }
      function edgeHitTest(sx, sy, threshold) {
        // Distance from point (sx,sy) to each visible edge segment;
        // returns the index of the closest within `threshold` pixels, or
        // -1. Only checked when no node was hit, so we don't pay the
        // O(E) cost on every mousemove unless the cursor is actually
        // over empty space.
        if (!edgesVisible) return -1;
        threshold = threshold ?? 4;
        let best = -1;
        let bestD = threshold;
        const W = canvas.width / dpr;
        const H = canvas.height / dpr;
        for (let k = 0; k < edges.length; k++) {
          // Skip implicit edges if they're not currently shown — they
          // shouldn't be clickable when they're invisible.
          if (!showImplicit && implicitEdgeIdx && implicitEdgeIdx.has(k)) continue;
          const e = edges[k];
          const a = nodes[e[0]], b = nodes[e[1]];
          if (!a.visible || !b.visible) continue;
          const ax = modelToScreenX(a.x), ay = modelToScreenY(a.y);
          const bx = modelToScreenX(b.x), by = modelToScreenY(b.y);
          // Cheap viewport reject — both ends off the same side.
          if ((ax < -10 && bx < -10) || (ax > W + 10 && bx > W + 10) ||
              (ay < -10 && by < -10) || (ay > H + 10 && by > H + 10)) continue;
          const dx = bx - ax, dy = by - ay;
          const len2 = dx * dx + dy * dy;
          if (len2 === 0) continue;
          let t = ((sx - ax) * dx + (sy - ay) * dy) / len2;
          if (t < 0) t = 0; else if (t > 1) t = 1;
          const nx = ax + t * dx, ny = ay + t * dy;
          const d = Math.hypot(sx - nx, sy - ny);
          if (d < bestD) { bestD = d; best = k; }
        }
        return best;
      }

      // --- Fit / centring -------------------------------------------------
      function fitToCanvas(padding) {
        if (!nodes.length) return;
        padding = padding ?? 40;
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        for (const n of nodes) {
          if (!n.visible) continue;
          minX = Math.min(minX, n.x - n.size);
          maxX = Math.max(maxX, n.x + n.size);
          minY = Math.min(minY, n.y - n.size);
          maxY = Math.max(maxY, n.y + n.size);
        }
        const W = canvas.width / dpr, H = canvas.height / dpr;
        const w = Math.max(1, maxX - minX), h = Math.max(1, maxY - minY);
        view.scale = Math.min((W - 2 * padding) / w, (H - 2 * padding) / h);
        view.tx = (W - w * view.scale) / 2 - minX * view.scale;
        view.ty = (H - h * view.scale) / 2 - minY * view.scale;
        requestDraw();
      }

      // --- Layouts --------------------------------------------------------
      function nodeSize(mentions, isBridge) {
        // Radius (not diameter). Small dots — a constellation at fit
        // zoom, not boulders. Translucent fill lets overlaps stack
        // visibly rather than swallowing one another.
        const base = 2 + Math.log2(1 + (mentions || 0)) * 0.9;
        return Math.min(8, isBridge ? base + 1 : base);
      }

      const LAYOUTS = [
        { key: 'force', label: 'Force', apply: () => applyForceLayout() },
        { key: 'grid',  label: 'Grid',  apply: () => applyGridLayout() },
        { key: 'circle', label: 'Circle', apply: () => applyCircleLayout() },
        { key: 'concentric', label: 'Concentric', apply: () => applyConcentricLayout() },
      ];
      let layoutIdx = 0;

      // Baseline 6× spreads the natural spring output enough that clusters
      // are legible at fit zoom. The Force slider scales this further:
      // 50% gives the original tight layout, 100% is the new comfortable
      // default, 400% pulls everything way apart for dense-area exploration.
      const FORCE_BASELINE = 6;

      function applyForceLayout() {
        if (!rawForcePositions) return;
        const scale = FORCE_BASELINE * forceMult;
        for (let i = 0; i < nodes.length; i++) {
          const p = rawForcePositions[i];
          if (!p) continue;
          nodes[i].x = p[0] * scale;
          nodes[i].y = p[1] * scale;
        }
        fitToCanvas();
      }
      function applyGridLayout() {
        const visible = nodes.filter((n) => n.visible);
        const cols = Math.max(1, Math.ceil(Math.sqrt(visible.length)));
        const step = 90;
        const ordered = visible.slice().sort((a, b) => b.count - a.count);
        const nodeIdx = new Map(nodes.map((n, i) => [n, i]));
        for (let k = 0; k < ordered.length; k++) {
          const target = nodeIdx.get(ordered[k]);
          nodes[target].x = (k % cols) * step;
          nodes[target].y = Math.floor(k / cols) * step;
        }
        fitToCanvas();
      }
      function applyCircleLayout() {
        const visible = nodes.filter((n) => n.visible);
        // Interleave landmarks evenly around the ring so the labels that
        // do survive collision detection are spaced across the full
        // circumference — not bunched on one side because the parser
        // happened to walk that part of the alphabet first.
        const landmarks = visible.filter((n) => n.isLandmark);
        const others = visible.filter((n) => !n.isLandmark);
        const total = visible.length;
        const interval = landmarks.length > 0 ? Math.floor(total / landmarks.length) : total;
        const ordered = new Array(total);
        let li = 0, oi = 0;
        for (let k = 0; k < total; k++) {
          if (li < landmarks.length && (k % interval === 0)) ordered[k] = landmarks[li++];
          else if (oi < others.length) ordered[k] = others[oi++];
          else if (li < landmarks.length) ordered[k] = landmarks[li++];
        }
        const radius = Math.max(400, total * 6);
        // Build a lookup from node object to its target index so the
        // hot loop doesn't have to scan nodes[] for each entry.
        const nodeIdx = new Map(nodes.map((n, i) => [n, i]));
        for (let k = 0; k < total; k++) {
          const angle = (k / total) * 2 * Math.PI;
          const target = nodeIdx.get(ordered[k]);
          nodes[target].x = Math.cos(angle) * radius;
          nodes[target].y = Math.sin(angle) * radius;
        }
        fitToCanvas();
      }
      function applyConcentricLayout() {
        // Bucket by degree-ish proxy: bridges in middle, high-mention next,
        // tail on outer ring.
        const visible = nodes.filter((n) => n.visible);
        const sorted = visible.slice().sort((a, b) => {
          if (a.bridgeRank && !b.bridgeRank) return -1;
          if (b.bridgeRank && !a.bridgeRank) return 1;
          if (a.bridgeRank && b.bridgeRank) return a.bridgeRank - b.bridgeRank;
          return b.count - a.count;
        });
        const rings = 8;
        const perRing = Math.ceil(sorted.length / rings);
        const nodeIdx = new Map(nodes.map((n, i) => [n, i]));
        for (let i = 0; i < sorted.length; i++) {
          const r = Math.floor(i / perRing);
          const idxInRing = i % perRing;
          const radius = 80 + r * 90;
          const angleStep = (2 * Math.PI) / Math.max(1, perRing);
          const angle = idxInRing * angleStep;
          const target = nodeIdx.get(sorted[i]);
          nodes[target].x = Math.cos(angle) * radius;
          nodes[target].y = Math.sin(angle) * radius;
        }
        fitToCanvas();
      }

      // --- Init -----------------------------------------------------------
      // Guard against double-init: a second click after a failed-then-retried
      // load would otherwise double-bind every listener and push the node/edge
      // arrays twice. Reset on failure so a genuine retry can proceed.
      let initStarted = false;
      async function init() {
        if (initStarted) return;
        initStarted = true;
        loadBtn.disabled = true;
        loadBtn.textContent = 'Loading data…';
        let data;
        // Reuse the adjacency map the per-entity NetworkGraph widget already
        // fetched + parsed (cached on window._netAdj), so arriving here from an
        // entity page skips re-parsing ~450 KB of JSON.
        if (window._netAdj) {
          data = window._netAdj;
        } else {
          try {
            const r = await fetch('/adjacency.json?v=' + window.__V);
            if (!r.ok) throw new Error('fetch failed');
            data = await r.json();
            window._netAdj = data;
          } catch (err) {
            initStarted = false;
            loadBtn.disabled = false;
            loadBtn.textContent = 'Load network';
            status.querySelector('.net-load-warn').textContent =
              'Failed to load network data. Try again or check your connection.';
            console.error('[net]', err);
            return;
          }
        }

        // Keep the parser's natural 0-1000 spring_layout output verbatim;
        // applyForceLayout multiplies by FORCE_BASELINE × forceMult.
        rawForcePositions = data.positions || null;
        const baselineScale = FORCE_BASELINE * forceMult;
        for (let i = 0; i < data.ids.length; i++) {
          const br = data.bridges?.[String(i)];
          const isBridge = br != null;
          const bridgeRank = isBridge ? (typeof br === 'object' ? br.rank : br) : 0;
          const bridgeScore = isBridge && typeof br === 'object' ? br.score : 0;
          const hu = data.hubs?.[String(i)];
          const hubRank = hu ? (typeof hu === 'object' ? hu.rank : hu) : 0;
          const hubScore = hu && typeof hu === 'object' ? hu.score : 0;
          const p = rawForcePositions
            ? [rawForcePositions[i][0] * baselineScale, rawForcePositions[i][1] * baselineScale]
            : [Math.random() * 3000, Math.random() * 3000];
          nodes.push({
            id: data.ids[i],
            title: data.titles[i],
            type: data.types[i],
            x: p[0],
            y: p[1],
            size: nodeSize(data.mentions[i], isBridge),
            color: COLORS[data.types[i]] || COLORS.muted,
            bridgeRank,
            bridgeScore,
            hubRank,
            hubScore,
            count: data.mentions[i] || 0,
            visible: true,
          });
        }
        // Pre-mark the top-20 mention-count nodes for always-on labelling
        // — these are the landmarks (CIA, United States, Reagan...) that
        // orient the user no matter how zoomed out they are.
        const topByMentions = nodes
          .map((n, i) => ({ i, c: n.count }))
          .sort((a, b) => b.c - a.c)
          .slice(0, 20)
          .map((x) => x.i);
        for (const i of topByMentions) nodes[i].isLandmark = true;

        // Build edge array (deduped — adjacency is symmetric) and
        // simultaneously build neighborSets so selection focus is O(1)
        // lookup rather than scanning edges on every click.
        neighborSets = Array.from({ length: nodes.length }, () => new Set());
        const edgePairToIdx = new Map();
        for (let i = 0; i < data.adj.length; i++) {
          const neigh = data.adj[i];
          for (let k = 0; k < neigh.length; k++) {
            const j = neigh[k];
            neighborSets[i].add(j);
            if (j <= i) continue;
            edgePairToIdx.set(i * 100000 + j, edges.length);
            edges.push([i, j]);
          }
        }
        // Mark which edges are implicit-only (NER-inferred) so the
        // "+ Inferred" toggle can hide/show them and the renderer can
        // draw them dashed.
        implicitEdgeIdx = new Set();
        if (data.implicitPairs) {
          for (const [a, b] of data.implicitPairs) {
            const key = a < b ? a * 100000 + b : b * 100000 + a;
            const idx = edgePairToIdx.get(key);
            if (idx != null) implicitEdgeIdx.add(idx);
          }
        }
        // Mark isolated entries (zero in or out links) and hide them.
        // They're real vault entries but add no information to a graph
        // view — they're just dots floating in empty space. Type-filter
        // toggles AND with !isolated so they stay hidden either way.
        let isolatedCount = 0;
        for (let i = 0; i < nodes.length; i++) {
          if (neighborSets[i].size === 0) {
            nodes[i].isolated = true;
            nodes[i].visible = false;
            isolatedCount++;
          }
        }
        if (isolatedCount > 0) {
          console.info(`[net] hiding ${isolatedCount} orphan node(s) with no connections`);
        }

        status.setAttribute('hidden', '');
        controls.removeAttribute('hidden');
        filters.removeAttribute('hidden');
        sliders.removeAttribute('hidden');
        // On phone-sized viewports, auto-collapse the drawers so the
        // canvas isn't smothered by chrome. The user can still open any.
        if (window.matchMedia('(max-width: 720px)').matches) {
          for (const d of document.querySelectorAll('.net-drawer')) {
            d.classList.add('collapsed');
            const t = d.querySelector('.net-drawer-toggle');
            if (t) t.setAttribute('aria-expanded', 'false');
          }
        }
        resizeCanvas();
        fitToCanvas();
        wireInteractions();
      }

      // --- Interactions ---------------------------------------------------
      function wireInteractions() {
        // Pan + drag with mouse
        let isPanning = false;
        let panStart = null;
        let downAt = null;
        canvas.addEventListener('mousedown', (e) => {
          isPanning = true;
          panStart = { x: e.clientX, y: e.clientY, tx: view.tx, ty: view.ty };
          downAt = { x: e.clientX, y: e.clientY };
          canvas.style.cursor = 'grabbing';
        });
        window.addEventListener('mouseup', (e) => {
          if (!isPanning) return;
          isPanning = false;
          canvas.style.cursor = '';
          // Was this a click rather than a drag? Threshold = 4px.
          const moved = downAt && (Math.hypot(e.clientX - downAt.x, e.clientY - downAt.y) > 4);
          if (!moved) handleClick(e);
          downAt = null;
        });
        canvas.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          const sx = e.clientX - rect.left;
          const sy = e.clientY - rect.top;
          if (isPanning && panStart) {
            view.tx = panStart.tx + (e.clientX - panStart.x);
            view.ty = panStart.ty + (e.clientY - panStart.y);
            requestDraw();
            tooltip.setAttribute('hidden', '');
            return;
          }
          const hit = hitTest(sx, sy);
          let edgeHit = -1;
          if (hit < 0) edgeHit = edgeHitTest(sx, sy);
          if (hit !== hoveredIdx || edgeHit !== hoveredEdge) {
            hoveredIdx = hit;
            hoveredEdge = edgeHit;
            requestDraw();
          }
          if (hit >= 0) {
            canvas.style.cursor = 'pointer';
            showTooltip(nodes[hit], sx, sy);
          } else if (edgeHit >= 0) {
            canvas.style.cursor = 'pointer';
            const ed = edges[edgeHit];
            showEdgeTooltip(nodes[ed[0]], nodes[ed[1]], sx, sy);
          } else {
            canvas.style.cursor = '';
            tooltip.setAttribute('hidden', '');
          }
        });
        canvas.addEventListener('mouseleave', () => {
          if (hoveredIdx !== -1) { hoveredIdx = -1; requestDraw(); }
          tooltip.setAttribute('hidden', '');
          canvas.style.cursor = '';
        });

        // Zoom toward cursor
        canvas.addEventListener('wheel', (e) => {
          e.preventDefault();
          const rect = canvas.getBoundingClientRect();
          const sx = e.clientX - rect.left;
          const sy = e.clientY - rect.top;
          const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
          const newScale = Math.max(0.05, Math.min(50, view.scale * factor));
          const ratio = newScale / view.scale;
          view.tx = sx - (sx - view.tx) * ratio;
          view.ty = sy - (sy - view.ty) * ratio;
          view.scale = newScale;
          requestDraw();
          tooltip.setAttribute('hidden', '');
        }, { passive: false });

        // Double-click → navigate immediately
        canvas.addEventListener('dblclick', (e) => {
          const rect = canvas.getBoundingClientRect();
          const hit = hitTest(e.clientX - rect.left, e.clientY - rect.top);
          if (hit >= 0) {
            const n = nodes[hit];
            window.location.href = `/${TYPE_DIRS[n.type] || 'pages'}/${n.id}/`;
          }
        });

        // --- Touch: pan (1 finger), pinch-zoom (2 fingers), tap (=click),
        //     double-tap (=navigate). touch-action: none on .net-canvas
        //     in CSS prevents the browser from scroll-jacking.
        let pinchStart = null;
        let lastTap = 0;
        canvas.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) {
            const t = e.touches[0];
            isPanning = true;
            panStart = { x: t.clientX, y: t.clientY, tx: view.tx, ty: view.ty };
            downAt = { x: t.clientX, y: t.clientY };
          } else if (e.touches.length === 2) {
            isPanning = false;
            const a = e.touches[0], b = e.touches[1];
            const rect = canvas.getBoundingClientRect();
            pinchStart = {
              dist: Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY),
              scale: view.scale, tx: view.tx, ty: view.ty,
              midX: (a.clientX + b.clientX) / 2 - rect.left,
              midY: (a.clientY + b.clientY) / 2 - rect.top,
            };
          }
          e.preventDefault();
        }, { passive: false });
        canvas.addEventListener('touchmove', (e) => {
          if (e.touches.length === 2 && pinchStart) {
            const a = e.touches[0], b = e.touches[1];
            const dist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
            const ratio = dist / (pinchStart.dist || 1);
            const newScale = Math.max(0.05, Math.min(50, pinchStart.scale * ratio));
            const r = newScale / pinchStart.scale;
            view.scale = newScale;
            view.tx = pinchStart.midX - (pinchStart.midX - pinchStart.tx) * r;
            view.ty = pinchStart.midY - (pinchStart.midY - pinchStart.ty) * r;
            requestDraw();
          } else if (e.touches.length === 1 && isPanning && panStart) {
            const t = e.touches[0];
            view.tx = panStart.tx + (t.clientX - panStart.x);
            view.ty = panStart.ty + (t.clientY - panStart.y);
            requestDraw();
            tooltip.setAttribute('hidden', '');
          }
          e.preventDefault();
        }, { passive: false });
        canvas.addEventListener('touchend', (e) => {
          if (pinchStart && e.touches.length < 2) pinchStart = null;
          if (isPanning && e.touches.length === 0) {
            isPanning = false;
            const t = e.changedTouches[0];
            const moved = downAt && (Math.hypot(t.clientX - downAt.x, t.clientY - downAt.y) > 5);
            if (!moved) {
              // Double-tap navigates; single tap selects.
              const now = Date.now();
              if (now - lastTap < 320) {
                const rect = canvas.getBoundingClientRect();
                const hit = hitTest(t.clientX - rect.left, t.clientY - rect.top);
                if (hit >= 0) {
                  const n = nodes[hit];
                  window.location.href = `/${TYPE_DIRS[n.type] || 'pages'}/${n.id}/`;
                  return;
                }
              }
              lastTap = now;
              handleClick({ clientX: t.clientX, clientY: t.clientY, shiftKey: false });
            }
            downAt = null;
          }
        });
        canvas.addEventListener('touchcancel', () => {
          isPanning = false; pinchStart = null; downAt = null;
        });

        function handleClick(e) {
          const rect = canvas.getBoundingClientRect();
          const sx = e.clientX - rect.left;
          const sy = e.clientY - rect.top;
          const additive = multiMode || e.shiftKey;
          const hit = hitTest(sx, sy);

          if (hit < 0) {
            // Node miss — try edge.
            const edgeHit = edgeHitTest(sx, sy);
            if (edgeHit >= 0) {
              if (additive) {
                if (selectedEdges.has(edgeHit)) selectedEdges.delete(edgeHit);
                else selectedEdges.add(edgeHit);
              } else {
                selectedNodes.clear();
                selectedEdges.clear();
                selectedEdges.add(edgeHit);
              }
              recomputeFocus();
              updateSelectionPanel();
              requestDraw();
              return;
            }
            // Background click — clear only if we're in single-select
            // mode. In additive mode the user might be reaching for a
            // node and miss; better not to wipe their working set.
            if (!additive && (selectedNodes.size > 0 || selectedEdges.size > 0)) {
              selectedNodes.clear();
              selectedEdges.clear();
              recomputeFocus();
              updateSelectionPanel();
              requestDraw();
            }
            return;
          }

          // Node hit.
          if (additive) {
            if (selectedNodes.has(hit)) selectedNodes.delete(hit);
            else selectedNodes.add(hit);
          } else {
            const wasOnlySelection = selectedNodes.size === 1
              && selectedEdges.size === 0
              && selectedNodes.has(hit);
            selectedNodes.clear();
            selectedEdges.clear();
            if (!wasOnlySelection) selectedNodes.add(hit);
          }
          recomputeFocus();
          updateSelectionPanel();
          requestDraw();
        }

        // Layout cycle
        layoutBtn.addEventListener('click', () => {
          layoutIdx = (layoutIdx + 1) % LAYOUTS.length;
          currentLayout = LAYOUTS[layoutIdx].key;
          layoutBtn.textContent = `Layout: ${LAYOUTS[layoutIdx].label}`;
          // Force slider only meaningful when Force layout is active.
          forceSlider.classList.toggle('hidden', currentLayout !== 'force');
          LAYOUTS[layoutIdx].apply();
        });

        fitBtn.addEventListener('click', () => fitToCanvas());

        // Edges toggle — pure visibility flag here, no expensive add work
        edgesBtn.addEventListener('click', () => {
          edgesVisible = !edgesVisible;
          edgesBtn.setAttribute('aria-pressed', edgesVisible ? 'true' : 'false');
          edgesBtn.textContent = edgesVisible ? 'Hide edges' : 'Show edges';
          requestDraw();
        });

        // Type filter chips
        for (const chip of filters.querySelectorAll('.net-chip')) {
          chip.addEventListener('click', () => {
            const t = chip.dataset.type;
            const on = !chip.classList.contains('active');
            chip.classList.toggle('active', on);
            chip.setAttribute('aria-pressed', on ? 'true' : 'false');
            if (on) activeTypes.add(t); else activeTypes.delete(t);
            for (const n of nodes) n.visible = !n.isolated && activeTypes.has(n.type);
            // Drop any selections that point at now-invisible elements.
            for (const idx of [...selectedNodes]) {
              if (!nodes[idx].visible) selectedNodes.delete(idx);
            }
            for (const k of [...selectedEdges]) {
              const e = edges[k];
              if (!nodes[e[0]].visible || !nodes[e[1]].visible) selectedEdges.delete(k);
            }
            recomputeFocus();
            updateSelectionPanel();
            requestDraw();
          });
        }

        // Fullscreen
        fullscreenBtn.addEventListener('click', () => {
          const on = article.classList.toggle('fullscreen');
          fullscreenBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
          fullscreenBtn.textContent = on ? 'Exit' : 'Fullscreen';
          document.body.classList.toggle('net-fullscreen-active', on);
          requestAnimationFrame(() => { resizeCanvas(); fitToCanvas(); });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && article.classList.contains('fullscreen')) {
            article.classList.remove('fullscreen');
            fullscreenBtn.setAttribute('aria-pressed', 'false');
            fullscreenBtn.textContent = 'Fullscreen';
            document.body.classList.remove('net-fullscreen-active');
            requestAnimationFrame(() => { resizeCanvas(); fitToCanvas(); });
          }
        });

        // Selection panel "Clear" button — wipes everything.
        const selDeselect = panel.querySelector('.gs-deselect');
        selDeselect.addEventListener('click', () => {
          selectedNodes.clear();
          selectedEdges.clear();
          recomputeFocus();
          updateSelectionPanel();
          requestDraw();
        });

        // Multi-select toggle button — when on, every click adds/removes
        // (no shift required). Shift-click still works regardless.
        const multiBtn = document.querySelector('.net-multi');
        multiBtn?.addEventListener('click', () => {
          multiMode = !multiMode;
          multiBtn.setAttribute('aria-pressed', multiMode ? 'true' : 'false');
          multiBtn.textContent = multiMode ? 'Multi: on' : 'Multi: off';
        });

        // Inferred-edges toggle — adds the dashed NER-inferred edges to
        // the canvas. They're hidden by default because they're guesses,
        // not confirmed wikilinks.
        const implicitBtn = document.querySelector('.net-implicit');
        implicitBtn?.addEventListener('click', () => {
          showImplicit = !showImplicit;
          implicitBtn.setAttribute('aria-pressed', showImplicit ? 'true' : 'false');
          implicitBtn.textContent = showImplicit ? '− Inferred' : '+ Inferred';
          requestDraw();
        });

        // Opacity slider — dims nodes + labels in lockstep.
        opacityInput.addEventListener('input', () => {
          const pct = parseInt(opacityInput.value, 10);
          opacityMult = pct / 100;
          opacityVal.textContent = pct + '%';
          requestDraw();
        });

        // Highlight slider — how much the rest of the graph fades when
        // something is selected. 100 = strong fade (default), 0 = no
        // fade, just rings mark the selection.
        highlightInput.addEventListener('input', () => {
          const pct = parseInt(highlightInput.value, 10);
          highlightStrength = pct / 100;
          highlightVal.textContent = pct + '%';
          requestDraw();
        });

        // Drawer collapse toggles — same pattern for sliders, filters,
        // and controls. Each pair shares the .collapsed class and an
        // aria-expanded attribute so screen readers know what's happening.
        function wireDrawer(panelId, toggleId) {
          const panel = document.getElementById(panelId);
          const toggle = document.getElementById(toggleId);
          if (!panel || !toggle) return;
          toggle.addEventListener('click', () => {
            const collapsed = panel.classList.toggle('collapsed');
            toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          });
        }
        wireDrawer('net-sliders', 'net-sliders-toggle');
        wireDrawer('net-filters', 'net-filters-toggle');
        wireDrawer('net-controls', 'net-controls-toggle');

        // Force slider — scales positions in real time around the current
        // screen center. This is dynamic (not a full layout re-run), so
        // the user keeps their pan and zoom while the graph stretches /
        // contracts under their pointer.
        forceInput.addEventListener('input', () => {
          const pct = parseInt(forceInput.value, 10);
          const newMult = pct / 100;
          forceVal.textContent = pct + '%';
          if (currentLayout === 'force' && rawForcePositions && newMult !== forceMult) {
            const ratio = newMult / forceMult;
            // Find the model-space point currently at the canvas center
            // and anchor it there after the scale so the user's view
            // stays put.
            const W = canvas.width / dpr;
            const H = canvas.height / dpr;
            // Scale every node position from the model origin.
            for (let i = 0; i < nodes.length; i++) {
              nodes[i].x *= ratio;
              nodes[i].y *= ratio;
            }
            // Adjust the view translate so the screen content stays
            // anchored. Derivation: the model point at screen center
            // moves from cx to cx*ratio; offset the translate to
            // compensate.
            view.tx = W / 2 * (1 - ratio) + view.tx * ratio;
            view.ty = H / 2 * (1 - ratio) + view.ty * ratio;
            requestDraw();
          }
          forceMult = newMult;
        });
        // Initial visibility — Force layout is the default so the slider
        // is visible; hide if a different layout is active on first paint.
        forceSlider.classList.toggle('hidden', currentLayout !== 'force');
      }

      function updateSelectionPanel() {
        // Reset any dynamic sibling buttons we may have added previously.
        const goB = panel.querySelector('.gs-go-b');
        if (goB) goB.setAttribute('hidden', '');
        const go = panel.querySelector('.gs-go');
        go.textContent = 'Go to page →';
        go.removeAttribute('hidden');
        panel.querySelector('.gs-meta')?.classList?.remove?.('hidden-meta');
        panel.querySelector('.gs-summary')?.setAttribute('hidden', '');

        const nodeCount = selectedNodes.size;
        const edgeCount = selectedEdges.size;
        const total = nodeCount + edgeCount;

        if (total === 0) { panel.setAttribute('hidden', ''); return; }

        // Single edge selected — show both endpoints with go-to links.
        if (total === 1 && edgeCount === 1) {
          const k = selectedEdges.values().next().value;
          const e = edges[k];
          const a = nodes[e[0]], b = nodes[e[1]];
          panel.querySelector('.gs-eyebrow').textContent = 'Connection';
          panel.querySelector('.gs-eyebrow').className = 'gs-eyebrow';
          panel.querySelector('.gs-title').textContent = `${a.title} ↔ ${b.title}`;
          panel.querySelector('.gs-count').textContent = '';
          panel.querySelector('.gs-meta')?.classList?.add?.('hidden-meta');
          panel.querySelector('.gs-bridge').setAttribute('hidden', '');
          panel.querySelector('.gs-hub').setAttribute('hidden', '');
          go.href = `/${TYPE_DIRS[a.type] || 'pages'}/${a.id}/`;
          go.textContent = `Go to ${a.title} →`;
          let goB2 = panel.querySelector('.gs-go-b');
          if (!goB2) {
            goB2 = document.createElement('a');
            goB2.className = 'gs-go gs-go-b';
            go.parentNode.insertBefore(goB2, go.nextSibling);
          }
          goB2.href = `/${TYPE_DIRS[b.type] || 'pages'}/${b.id}/`;
          goB2.textContent = `Go to ${b.title} →`;
          goB2.removeAttribute('hidden');
          panel.removeAttribute('hidden');
          return;
        }

        // Single node selected — original behavior.
        if (total === 1 && nodeCount === 1) {
          const i = selectedNodes.values().next().value;
          const n = nodes[i];
          panel.querySelector('.gs-eyebrow').textContent = TYPE_LABELS[n.type] || '';
          panel.querySelector('.gs-eyebrow').className = `gs-eyebrow type-${n.type}`;
          panel.querySelector('.gs-title').textContent = n.title;
          panel.querySelector('.gs-count').textContent = n.count.toLocaleString();
          const br = panel.querySelector('.gs-bridge');
          if (n.bridgeRank) {
            panel.querySelector('.gs-bridge-rank').textContent = '#' + n.bridgeRank;
            br.removeAttribute('hidden');
          } else br.setAttribute('hidden', '');
          const hu = panel.querySelector('.gs-hub');
          if (n.hubRank) {
            panel.querySelector('.gs-hub-rank').textContent = '#' + n.hubRank;
            hu.removeAttribute('hidden');
          } else hu.setAttribute('hidden', '');
          go.href = `/${TYPE_DIRS[n.type] || 'pages'}/${n.id}/`;
          panel.removeAttribute('hidden');
          return;
        }

        // Multi-select summary — each entity title becomes a clickable
        // link to its entity page. Edges render as A↔B with both sides
        // independently linkable.
        function nodeLink(n) {
          const href = `/${TYPE_DIRS[n.type] || 'pages'}/${n.id}/`;
          return `<a href="${href}" class="gs-summary-link type-${n.type}">${escapeHtml(n.title)}</a>`;
        }
        const pieces = [];
        for (const i of selectedNodes) pieces.push(nodeLink(nodes[i]));
        for (const k of selectedEdges) {
          const e = edges[k];
          pieces.push(`${nodeLink(nodes[e[0]])}<span class="gs-summary-link-sep">↔</span>${nodeLink(nodes[e[1]])}`);
        }
        const MAX_INLINE = 8;
        let html = pieces.slice(0, MAX_INLINE).join(', ');
        if (pieces.length > MAX_INLINE) {
          html += `<span class="gs-summary-more">, +${pieces.length - MAX_INLINE} more</span>`;
        }
        panel.querySelector('.gs-eyebrow').textContent = 'Multi-select';
        panel.querySelector('.gs-eyebrow').className = 'gs-eyebrow';
        const parts = [];
        if (nodeCount) parts.push(`${nodeCount} ${nodeCount === 1 ? 'entity' : 'entities'}`);
        if (edgeCount) parts.push(`${edgeCount} ${edgeCount === 1 ? 'connection' : 'connections'}`);
        panel.querySelector('.gs-title').textContent = parts.join(' · ');
        panel.querySelector('.gs-count').textContent = '';
        panel.querySelector('.gs-meta')?.classList?.add?.('hidden-meta');
        panel.querySelector('.gs-bridge').setAttribute('hidden', '');
        panel.querySelector('.gs-hub').setAttribute('hidden', '');
        const sumEl = panel.querySelector('.gs-summary');
        sumEl.innerHTML = html;
        sumEl.removeAttribute('hidden');
        go.setAttribute('hidden', '');  // no single navigation target
        panel.removeAttribute('hidden');
      }

      function showEdgeTooltip(a, b, sx, sy) {
        const bits = [
          '<div class="gt-pair"><span>' + escapeHtml(a.title) + '</span> ',
          '<span class="gt-link">&mdash;</span> ',
          '<span>' + escapeHtml(b.title) + '</span></div>',
          '<div class="gt-meta">connection &middot; click to pin</div>',
        ];
        tooltip.innerHTML = bits.join('');
        tooltip.removeAttribute('hidden');
        const sr = shell.getBoundingClientRect();
        const maxX = sr.width - tooltip.offsetWidth - 8;
        tooltip.style.left = Math.min(Math.max(8, sx + 14), maxX) + 'px';
        tooltip.style.top = Math.max(8, sy - tooltip.offsetHeight - 10) + 'px';
      }

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, (c) => (
          { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
        ));
      }

      function showTooltip(node, sx, sy) {
        const bits = [
          '<div class="gt-pair"><span>' + escapeHtml(node.title) + '</span></div>',
          '<div class="gt-meta">' + escapeHtml(TYPE_LABELS[node.type] || node.type),
          ' · ' + node.count.toLocaleString() + ' mentions',
          node.bridgeRank ? ' · bridge #' + node.bridgeRank : '',
        node.hubRank ? ' · hub #' + node.hubRank : '',
          '</div>',
        ];
        tooltip.innerHTML = bits.join('');
        tooltip.removeAttribute('hidden');
        const sr = shell.getBoundingClientRect();
        const maxX = sr.width - tooltip.offsetWidth - 8;
        tooltip.style.left = Math.min(Math.max(8, sx + 14), maxX) + 'px';
        tooltip.style.top = Math.max(8, sy - tooltip.offsetHeight - 10) + 'px';
      }

      loadBtn.addEventListener('click', init);
    })();
  </script>
</Base>
