---
import Base from '../layouts/Base.astro';
import { bridgeEntities, hubEntities, hrefFor, renderInlineMd, TYPE_LABELS } from '../lib/data.ts';

const bridges = bridgeEntities();
const hubs = hubEntities();

// Bar scaling: each list normalizes to its own #1 score so the
// strongest entry in each view fills the bar.
const topBridgeScore = bridges[0]?.bridge_score ?? 1;
const topHubScore = hubs[0]?.hub_score ?? 1;

// Cross-reference maps so each row can show "also appears in the
// other list at rank #N" — the most interesting entities sit on both.
const hubRankOf = new Map(hubs.map((e) => [e.id, e.hub_rank!]));
const bridgeRankOf = new Map(bridges.map((e) => [e.id, e.bridge_rank!]));
---
<Base
  bodyClass="utility"
  title="Bridges & Hubs | The Info Web"
  description="Entries that connect different clusters, and entries with the strongest connections across the site."
>
  <article class="bridges-article">
    <div class="entity-eyebrow">
      <span>Tools</span>
    </div>
    <h1 class="entity-title">Bridges &amp; hubs</h1>
    <p class="entity-dek">
      Bridges connect different clusters. Hubs have strong links to other
      well-connected entries. Choose a list to explore either kind of connection.
    </p>

    <div class="br-toggle" role="tablist" aria-label="Structure view">
      <button
        type="button"
        class="br-tab is-active"
        data-view="bridges"
        id="tab-bridges"
        role="tab"
        aria-selected="true"
        aria-controls="panel-bridges-explain panel-bridges-list"
      >
        Bridges <span class="br-tab-count">{bridges.length}</span>
      </button>
      <button
        type="button"
        class="br-tab"
        data-view="hubs"
        id="tab-hubs"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        aria-controls="panel-hubs-explain panel-hubs-list"
      >
        Hubs <span class="br-tab-count">{hubs.length}</span>
      </button>
    </div>

    <section class="br-explain" data-view="bridges" id="panel-bridges-explain" role="tabpanel" aria-labelledby="tab-bridges" tabindex="0">
      <h2 class="br-heading">Bridges</h2>
      <p>A bridge is an entry mentioned by pages from several different clusters.
        It can help you find connections between subjects you might otherwise read separately.</p>
      <p>The ranking favors entries whose mentions are spread across clusters.
        Widely mentioned entries receive less weight, which makes smaller connections easier to find.</p>
      <p class="br-footer-note">An entry needs mentions from at least four pages in at least
        two clusters to qualify. Places are excluded. Ranks change as entries and links are added.</p>
    </section>

    <section class="br-explain" data-view="hubs" id="panel-hubs-explain" role="tabpanel" aria-labelledby="tab-hubs" tabindex="0" hidden>
      <h2 class="br-heading">Hubs</h2>
      <p>A hub has strong links to other well-connected entries.
        These pages are useful starting points for browsing a subject.</p>
      <p>The score uses PageRank, which considers the strength of each connection
        and how well connected the other entry is.</p>
      <p class="br-footer-note">Some entries appear in both lists.
        Their other rank is shown beside the title.</p>
    </section>

    <section class="br-list-section" data-view="bridges" id="panel-bridges-list" role="tabpanel" aria-labelledby="tab-bridges" tabindex="0">
      <h2 class="br-heading">Bridges, ranked</h2>
      <ol class="br-list">
        {bridges.map((e) => {
          const score = e.bridge_score ?? 0;
          const barWidth = topBridgeScore > 0 ? Math.round((score / topBridgeScore) * 100) : 0;
          const alsoHub = hubRankOf.get(e.id);
          return (
            <li class={`br-row type-${e.type}`} id={`br-${e.id}`}>
              <div class="br-rank-col">
                <span class="br-rank-num">{e.bridge_rank!.toString().padStart(2, '0')}</span>
              </div>
              <div class="br-body">
                <div class="br-head">
                  <span class="br-type">{TYPE_LABELS[e.type]}</span>
                  {e.category && <span class="br-cat">{e.category}</span>}
                  <span class="br-mentions">{e.mention_count.toLocaleString()} mentions</span>
                  {e.community_span && (
                    <span class="br-span" title="Number of clusters among the pages that mention this entry.">
                      spans {e.community_span} communities
                    </span>
                  )}
                  {alsoHub && (
                    <a class="br-also" href={`#hu-${e.id}`} title="This entry also appears in the Hubs list.">
                      also Hub #{alsoHub}
                    </a>
                  )}
                </div>
                <a class="br-title" href={hrefFor({ id: e.id, type: e.type })}>{e.title}</a>
                {e.summary && <p class="br-summary" set:html={renderInlineMd(e.summary)} />}
                <div class="br-score-row" title={`Bridge score: ${score.toFixed(4)}. Based on how mentions are spread across clusters.`}>
                  <div class="br-score-bar" aria-hidden="true">
                    <div class="br-score-fill" style={`width: ${barWidth}%`}></div>
                  </div>
                  <span class="br-score-val">{score.toFixed(4)}</span>
                  <span class="br-score-rel">{barWidth}% of #1</span>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="br-list-section" data-view="hubs" id="panel-hubs-list" role="tabpanel" aria-labelledby="tab-hubs" tabindex="0" hidden>
      <h2 class="br-heading">Hubs, ranked</h2>
      <ol class="br-list">
        {hubs.map((e) => {
          const score = e.hub_score ?? 0;
          const barWidth = topHubScore > 0 ? Math.round((score / topHubScore) * 100) : 0;
          const alsoBridge = bridgeRankOf.get(e.id);
          return (
            <li class={`br-row type-${e.type}`} id={`hu-${e.id}`}>
              <div class="br-rank-col">
                <span class="br-rank-num">{e.hub_rank!.toString().padStart(2, '0')}</span>
              </div>
              <div class="br-body">
                <div class="br-head">
                  <span class="br-type">{TYPE_LABELS[e.type]}</span>
                  {e.category && <span class="br-cat">{e.category}</span>}
                  <span class="br-mentions">{e.mention_count.toLocaleString()} mentions</span>
                  {alsoBridge && (
                    <a class="br-also" href={`#br-${e.id}`} title="This entry also appears in the Bridges list.">
                      also Bridge #{alsoBridge}
                    </a>
                  )}
                </div>
                <a class="br-title" href={hrefFor({ id: e.id, type: e.type })}>{e.title}</a>
                {e.summary && <p class="br-summary" set:html={renderInlineMd(e.summary)} />}
                <div class="br-score-row" title={`Hub score: ${score.toFixed(5)}. Based on weighted PageRank.`}>
                  <div class="br-score-bar" aria-hidden="true">
                    <div class="br-score-fill" style={`width: ${barWidth}%`}></div>
                  </div>
                  <span class="br-score-val">{score.toFixed(5)}</span>
                  <span class="br-score-rel">{barWidth}% of #1</span>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <p class="br-cta">
      Find the links between two entries with the <a href="/path/">path finder</a>,
      or explore the <a href="/network/">full network</a>.
    </p>
  </article>

  <script is:inline>
    // View toggle: swap visible <section data-view="..."> blocks based on
    // which tab is active. Uses hidden attr (rather than display:none in
    // CSS) so screen readers + browser find-in-page skip the inactive
    // panel cleanly. Also syncs the URL hash so a deep-linked anchor
    // (#br-foo or #hu-foo) auto-selects the matching view.
    (function () {
      const tabs = document.querySelectorAll('.br-tab');
      const sections = document.querySelectorAll('section[data-view]');

      function setView(view) {
        tabs.forEach((t) => {
          const active = t.getAttribute('data-view') === view;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          // Roving tabindex: only the active tab is in the tab order; the
          // others are reached with arrow keys per the WAI-ARIA tabs pattern.
          t.setAttribute('tabindex', active ? '0' : '-1');
        });
        sections.forEach((s) => {
          const match = s.getAttribute('data-view') === view;
          if (match) s.removeAttribute('hidden');
          else s.setAttribute('hidden', '');
        });
      }

      const tabList = Array.from(tabs);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => {
          const view = t.getAttribute('data-view');
          setView(view);
          // Persist the active tab in the URL (replaceState, no history
          // spam) so a reload or shared link restores it instead of always
          // snapping back to Bridges.
          history.replaceState(null, '', '#' + view);
        });
        // Left/Right (and Home/End) move between tabs and activate, the
        // standard keyboard model for an ARIA tablist.
        t.addEventListener('keydown', (e) => {
          let next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabList.length;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabList.length) % tabList.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabList.length - 1;
          if (next < 0) return;
          e.preventDefault();
          const target = tabList[next];
          const view = target.getAttribute('data-view');
          setView(view);
          history.replaceState(null, '', '#' + view);
          target.focus();
        });
      });

      // Auto-select view from URL hash so /bridges/#hu-cia lands on Hubs
      // and scrolls into view, rather than showing Bridges and silently
      // missing the anchor. Plain #hubs / #bridges markers (written by the
      // tab clicks above) select the view without an entity scroll target.
      function applyHashView() {
        const h = window.location.hash;
        if (h === '#hubs' || h.startsWith('#hu-')) setView('hubs');
        else if (h === '#bridges' || h.startsWith('#br-')) setView('bridges');
        // Re-trigger the browser's anchor scroll after we've unhidden
        // the right panel; otherwise the target was hidden when the
        // browser first tried to focus it.
        if (h && (h.startsWith('#hu-') || h.startsWith('#br-'))) {
          requestAnimationFrame(() => {
            const el = document.querySelector(h);
            if (el) el.scrollIntoView({ block: 'start' });
          });
        }
      }
      applyHashView();
      window.addEventListener('hashchange', applyHashView);
    })();
  </script>
</Base>
