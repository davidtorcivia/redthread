---
import Base from '../layouts/Base.astro';
import { BROWSE_TYPES, TYPE_DIRS, TYPE_PLURALS } from '../lib/data.ts';
---
<Base
  bodyClass="utility"
  title="404"
  description="The page you're looking for isn't in the vault."
  noindex
>
  <article class="error-article">
    <div class="error-code">404</div>
    <h1 class="error-title">Off the trail</h1>
    <p class="error-dek">
      There is no page at this address.
      Either it was never written, the link is stale, or the slug changed.
    </p>

    <div class="error-actions">
      <button type="button" class="error-btn primary" id="error-search">
        Search the vault <kbd>⌘ K</kbd>
      </button>
      <a class="error-btn" href="/random/">Jump to a random entry &rarr;</a>
    </div>

    <section class="error-browse">
      <h2 class="section-heading">Or browse by type</h2>
      <ul class="error-browse-list">
        {BROWSE_TYPES.map((t) => (
          <li><a href={`/${TYPE_DIRS[t]}/`}>{TYPE_PLURALS[t]}</a></li>
        ))}
        <li><a href="/tags/">Tags</a></li>
        <li><a href="/timeline/">Timeline</a></li>
        <li><a href="/network/">Full network</a></li>
      </ul>
    </section>
  </article>

  <script is:inline>
    {
      const button = document.getElementById('error-search');
      button.addEventListener('click', () => document.getElementById('search-open').click());
      if (!/Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent)) button.querySelector('kbd').textContent = 'Ctrl K';
    }
  </script>
</Base>
