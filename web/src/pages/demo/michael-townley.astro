---
import Base from '../../layouts/Base.astro';
import NetworkGraph from '../../components/NetworkGraph.astro';
import Relations from '../../components/Relations.astro';
import { backlinks, edges, entity as getEntity, hrefFor, implicitMentions, related, renderInlineMd, TYPE_LABELS } from '../../lib/data.ts';
import type { Entity } from '../../lib/types.ts';

// One real record, rendered in an alternate layout for comparison. The vault
// and the normal entity template remain unchanged.
const record = getEntity('michael-townley');
if (!record) throw new Error('The entity-page demo needs Michael Townley in the vault');
const e: Entity = record;
const currentHref = hrefFor(e);
const direct = [...new Set(edges()
  .filter((edge) => edge.source === e.id && edge.kind === 'explicit' && edge.target_id)
  .map((edge) => edge.target_id!))]
  .map((id) => getEntity(id))
  .filter((item): item is Entity => Boolean(item));
const shared = related(e.id).slice(0, 8);
const inbound = backlinks(e.id);
const implicit = implicitMentions(e.id).slice(0, 12);
const relations = [...(e.relations ?? []), ...(e.relations_in ?? [])];
const sourceCount = e.footnotes.length;
const locations = e.locations ?? [];
---
<Base
  title={`Entity page preview: ${e.title} | The Info Web`}
  description={`A preview of a more focused reading layout for ${e.title}.`}
  bodyClass="entity-demo"
  noindex
>
  <article class="demo-page">
    <header class="demo-hero">
      <div class="demo-topline">
        <a href="/people/">← People</a>
        <a href={currentHref}>Compare with current page ↗</a>
      </div>
      <div class="demo-hero-grid">
        <div>
          <p class="demo-category">{e.category || TYPE_LABELS[e.type]} <span>· Page layout preview</span></p>
          <h1>{e.title}</h1>
          {e.summary && <p class="demo-summary" set:html={renderInlineMd(e.summary)} />}
        </div>
        <aside class="demo-facts" aria-label="Record at a glance">
          <h2>At a glance</h2>
          <dl>
            {locations.length > 0 && <div><dt>Place</dt><dd>{locations.join(', ')}</dd></div>}
            <div><dt>Sources</dt><dd>{sourceCount} notes in this entry</dd></div>
            <div><dt>In the archive</dt><dd>Mentioned on {e.mention_count} other pages</dd></div>
          </dl>
        </aside>
      </div>
      <nav class="demo-section-nav" aria-label="Page sections">
        <a href="#record">Read the record</a>
        <a href="#sources">Sources</a>
        <a href="#connections">Connections</a>
        <a href="#network">Network</a>
      </nav>
    </header>

    <div class="demo-body">
      <main class="demo-main">
        <section class="demo-section demo-record" id="record" aria-labelledby="record-title">
          <div class="demo-section-head">
            <h2 id="record-title">The record</h2>
            <span>{sourceCount} cited notes · {e.toc.length} sections</span>
          </div>
          <div class="demo-prose prose" set:html={e.body_html} />
        </section>

        <section class="demo-section" id="sources" aria-labelledby="sources-title">
          <div class="demo-section-head">
            <h2 id="sources-title">Sources</h2>
            <span>{sourceCount} notes</span>
          </div>
          <p class="demo-section-intro">Citation numbers in the article lead here. Hover or focus a citation to read a short preview without leaving your place.</p>
          <details class="demo-source-disclosure" id="source-disclosure">
            <summary>Read the source notes <span aria-hidden="true">+</span></summary>
            <ol class="demo-source-list">
              {e.footnotes.map((note) => <li id={`fn-${note.id}`}><span set:html={note.html ?? note.text} /> <a href={`#fnref-${note.id}`} aria-label={`Return to citation ${note.id}`}>↩</a></li>)}
            </ol>
          </details>
        </section>

        <section class="demo-section" id="connections" aria-labelledby="connections-title">
          <div class="demo-section-head">
            <h2 id="connections-title">Connections</h2>
            <span>Follow the evidence</span>
          </div>
          <p class="demo-section-intro">These lists describe different things. A link in this article, a shared appearance elsewhere, and a page that mentions Townley are separate kinds of connection.</p>

          {relations.length > 0 && <div class="demo-relations"><Relations e={e} /></div>}

          <div class="demo-connection-list">
            <details open>
              <summary><span><strong>Linked in this article</strong><small>Entries directly linked from the text above</small></span><b>{direct.length}</b></summary>
              <ul class="demo-link-list">
                {direct.slice(0, 20).map((item) => <li><a href={hrefFor(item)}>{item.title}</a><span>{TYPE_LABELS[item.type]}</span></li>)}
              </ul>
              {direct.length > 20 && <p class="demo-list-note">Showing the first 20 in article order.</p>}
              {implicit.length > 0 && <div class="demo-sublist"><h3>Also named in the text</h3><p>Recognized names without a direct link.</p><div class="demo-chips">{implicit.map((item) => <a href={hrefFor({ id: item.id, type: item.type })}>{item.title}</a>)}</div></div>}
            </details>
            <details>
              <summary><span><strong>Appears together elsewhere</strong><small>Association through other archive pages, with examples</small></span><b>{shared.length}</b></summary>
              <ul class="demo-shared-list">
                {shared.map((item) => <li><a href={hrefFor(item)}>{item.title}</a><span>{item.count} shared pages</span>{item.via?.length > 0 && <p>For example: {item.via.slice(0, 2).map((via, i) => <>{i > 0 && ', '}<a href={hrefFor(via)}>{via.title}</a></>)}</p>}</li>)}
              </ul>
            </details>
            <details>
              <summary><span><strong>Pages mentioning this entry</strong><small>Where else Townley appears in the archive</small></span><b>{inbound.length}</b></summary>
              <ul class="demo-link-list">
                {inbound.slice(0, 24).map((item) => <li><a href={hrefFor({ id: item.source_id, type: item.source_type })}>{item.source_title}</a><span>{TYPE_LABELS[item.source_type]}</span></li>)}
              </ul>
              {inbound.length > 24 && <p class="demo-list-note">Showing 24 of {inbound.length} pages.</p>}
            </details>
          </div>
        </section>

        <section class="demo-section" id="network" aria-labelledby="network-title">
          <div class="demo-section-head"><h2 id="network-title">Explore further</h2></div>
          <p class="demo-section-intro">Use the graph when you want to investigate the wider pattern. It stays out of the reading flow until you open it.</p>
          <div class="demo-explore-links"><a href={`/path/?from=${encodeURIComponent(e.id)}`}>Find a path from {e.title} ↗</a><a href="/network/">Open the full network ↗</a></div>
          <details class="demo-graph-disclosure">
            <summary>Open the local network <span aria-hidden="true">+</span></summary>
            <NetworkGraph id={e.id} title={e.title} />
          </details>
        </section>
      </main>

      <aside class="demo-rail" aria-label="Article contents">
        <div class="demo-rail-inner">
          <h2>In this record</h2>
          <ol>{e.toc.map((item) => <li class={`depth-${item.level}`}><a href={`#${item.id}`}>{item.text}</a></li>)}</ol>
          <a class="demo-rail-source" href="#sources">Browse {sourceCount} source notes ↓</a>
        </div>
      </aside>
    </div>
  </article>

  <div class="demo-citation-preview" id="demo-citation-preview" role="tooltip" hidden></div>
  <script is:inline>
    (() => {
      const disclosure = document.getElementById('source-disclosure');
      const preview = document.getElementById('demo-citation-preview');
      if (!disclosure || !preview) return;
      const openTarget = () => { if (/^#fn-/.test(location.hash)) disclosure.open = true; };
      openTarget();
      window.addEventListener('hashchange', openTarget);
      document.querySelectorAll('.demo-prose a[href^="#fn-"]').forEach((link) => {
        const note = document.querySelector(link.getAttribute('href'));
        if (!note) return;
        const text = note.textContent.trim().replace(/\s+/g, ' ').replace(/↩$/, '').trim();
        const show = () => {
          preview.textContent = text.length > 360 ? text.slice(0, 357).trimEnd() + '…' : text;
          preview.hidden = false;
          const box = link.getBoundingClientRect();
          const width = Math.min(380, innerWidth - 32);
          preview.style.width = width + 'px';
          preview.style.left = Math.max(16, Math.min(box.left, innerWidth - width - 16)) + 'px';
          preview.style.top = Math.min(box.bottom + 10, innerHeight - preview.offsetHeight - 16) + 'px';
        };
        const hide = () => { preview.hidden = true; };
        link.addEventListener('mouseenter', show);
        link.addEventListener('focus', show);
        link.addEventListener('mouseleave', hide);
        link.addEventListener('blur', hide);
        link.addEventListener('click', () => { disclosure.open = true; hide(); });
      });
    })();
  </script>
</Base>

<style>
  .demo-page {color:var(--ink)}
  .demo-hero,.demo-body {padding-left:var(--gutter);padding-right:var(--gutter)}
  .demo-hero {max-width:1550px;margin:auto;padding-top:42px}
  .demo-topline {display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line-2);padding-bottom:16px;font:600 14px/1.3 var(--sans)}
  .demo-topline a {text-decoration:underline;text-underline-offset:3px}
  .demo-hero-grid {display:grid;grid-template-columns:minmax(0,1fr) 275px;gap:clamp(35px,6vw,110px);align-items:end;padding:42px 0 44px}
  .demo-category {font:700 13px/1.3 var(--sans);text-transform:uppercase;letter-spacing:.04em;margin:0 0 15px}
  .demo-category span {font-weight:400;color:var(--muted)}
  .demo-hero h1 {font:800 clamp(56px,8.7vw,138px)/.87 var(--sans);font-variation-settings:"wdth" 88;letter-spacing:-.055em;text-transform:uppercase;margin:0 0 25px;text-wrap:balance}
  .demo-summary {font:400 clamp(20px,2vw,28px)/1.3 var(--serif);max-width:39em;margin:0;text-wrap:pretty}
  .demo-facts {border-top:3px solid var(--ink);font-family:var(--sans);padding-top:12px}
  .demo-facts h2 {font-size:14px;text-transform:uppercase;margin:0 0 13px}
  .demo-facts dl {margin:0}
  .demo-facts dl div {display:grid;grid-template-columns:78px 1fr;gap:8px;border-top:1px solid var(--line);padding:10px 0;font-size:14px;line-height:1.4}
  .demo-facts dt {color:var(--muted)}
  .demo-facts dd {margin:0}
  .demo-section-nav {display:flex;flex-wrap:wrap;gap:4px 34px;border-top:2px solid var(--ink);border-bottom:1px solid var(--line);padding:14px 0;font:600 15px/1.3 var(--sans)}
  .demo-section-nav a:hover,.demo-explore-links a:hover {color:var(--accent)}
  .demo-body {max-width:1550px;margin:auto;display:grid;grid-template-columns:minmax(0,810px) minmax(180px,230px);justify-content:space-between;gap:clamp(35px,5vw,90px);padding-top:54px;padding-bottom:100px}
  .demo-main,.demo-rail {min-width:0}
  .demo-section {scroll-margin-top:25px;margin:0 0 75px}
  .demo-section-head {display:flex;justify-content:space-between;align-items:baseline;gap:15px;border-top:2px solid var(--ink);padding:11px 0 25px;font-family:var(--sans)}
  .demo-section-head h2 {font-size:clamp(26px,3vw,40px);line-height:1.05;letter-spacing:-.035em;margin:0}
  .demo-section-head span {font-size:14px;color:var(--muted);text-align:right}
  .demo-prose {font-size:20px;line-height:1.6;max-width:44rem}
  .demo-prose :global(h2),.demo-prose :global(h3) {scroll-margin-top:25px}
  .demo-section-intro {font-size:18px;line-height:1.45;max-width:38em;margin:0 0 26px;color:var(--muted)}
  .demo-rail-inner {position:sticky;top:24px;border-top:2px solid var(--ink);padding-top:15px;font-family:var(--sans)}
  .demo-rail h2 {font-size:14px;text-transform:uppercase;margin:0 0 12px}
  .demo-rail ol {list-style:none;margin:0;padding:0}
  .demo-rail li {border-top:1px solid var(--line);font-size:14px;line-height:1.35}
  .demo-rail li a {display:block;padding:8px 0}
  .demo-rail li.depth-3 a {padding-left:12px}
  .demo-rail li.depth-4 a {padding-left:24px}
  .demo-rail-source {display:block;border-top:2px solid var(--ink);margin-top:20px;padding-top:12px;font-size:14px;font-weight:600}
  .demo-source-disclosure,.demo-connection-list details,.demo-graph-disclosure {border-top:1px solid var(--line-2)}
  .demo-source-disclosure summary,.demo-graph-disclosure summary {display:flex;justify-content:space-between;gap:20px;cursor:pointer;list-style:none;padding:16px 0;font:700 17px/1.3 var(--sans)}
  summary::-webkit-details-marker {display:none}
  .demo-source-disclosure summary span,.demo-graph-disclosure summary span {font-size:24px;font-weight:400;line-height:16px}
  .demo-source-disclosure[open] summary span,.demo-graph-disclosure[open] summary span {transform:rotate(45deg)}
  .demo-source-list {margin:10px 0 0;padding:0 0 0 28px;font:400 16px/1.55 var(--serif)}
  .demo-source-list li {padding:14px 0 14px 8px;border-top:1px solid var(--line);overflow-wrap:anywhere;scroll-margin-top:24px}
  .demo-source-list li:target {background:var(--highlight)}
  .demo-source-list a {text-decoration:underline;text-underline-offset:2px}
  .demo-connection-list {border-bottom:1px solid var(--line-2);font-family:var(--sans)}
  .demo-connection-list summary {list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:19px 0}
  .demo-connection-list summary strong {display:block;font-size:21px;line-height:1.1;letter-spacing:-.02em}
  .demo-connection-list summary small {display:block;font-size:14px;font-weight:400;color:var(--muted);margin-top:5px}
  .demo-connection-list summary b {font-size:14px;font-weight:500;color:var(--muted);white-space:nowrap}
  .demo-connection-list details[open] summary strong {color:var(--accent)}
  .demo-link-list,.demo-shared-list {list-style:none;padding:0 0 16px;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 25px}
  .demo-link-list li {display:flex;justify-content:space-between;align-items:baseline;gap:10px;border-top:1px solid var(--line);padding:9px 0;font-size:15px;line-height:1.3}
  .demo-link-list li span {color:var(--muted);font-size:12px;white-space:nowrap}
  .demo-link-list a,.demo-shared-list a {font-weight:600}
  .demo-shared-list li {border-top:1px solid var(--line);padding:12px 0;font-size:16px;line-height:1.35}
  .demo-shared-list li>span {display:block;color:var(--muted);font-size:13px;margin-top:3px}
  .demo-shared-list li p {font:400 13px/1.4 var(--serif);color:var(--muted);margin:8px 0 0}
  .demo-shared-list li p a {font-weight:400;text-decoration:underline;text-underline-offset:2px}
  .demo-list-note {font:400 13px/1.4 var(--sans);color:var(--muted)}
  .demo-sublist {border-top:1px solid var(--line);padding:16px 0 25px}
  .demo-sublist h3 {font-size:15px;margin:0 0 2px}
  .demo-sublist p {font-size:13px;color:var(--muted);margin:0 0 12px}
  .demo-chips {display:flex;flex-wrap:wrap;gap:7px}
  .demo-chips a {border:1px solid var(--line-2);padding:5px 9px;font-size:13px}
  .demo-explore-links {display:flex;gap:8px 25px;flex-wrap:wrap;font:600 15px/1.4 var(--sans);margin-bottom:25px}
  .demo-explore-links a {text-decoration:underline;text-underline-offset:3px}
  .demo-graph-disclosure {border-bottom:1px solid var(--line-2)}
  .demo-graph-disclosure :global(.entity-network) {margin:0;padding:0;border:0}
  .demo-citation-preview {position:fixed;z-index:50;background:var(--ink);color:var(--paper);border:1px solid var(--line-2);box-shadow:0 8px 30px #0003;padding:14px 16px;font:400 14px/1.45 var(--sans);pointer-events:none;max-height:45vh;overflow:hidden}
  @media(max-width:950px) {.demo-hero-grid {grid-template-columns:1fr}.demo-facts {max-width:600px}.demo-body {grid-template-columns:1fr}.demo-rail {display:none}}
  @media(max-width:600px) {.demo-hero {padding-top:25px}.demo-hero-grid {padding:32px 0}.demo-hero h1 {font-size:clamp(52px,14vw,82px)}.demo-summary {font-size:20px}.demo-topline {font-size:12px}.demo-section-nav {gap:10px 18px;font-size:13px}.demo-body {padding-top:34px}.demo-prose {font-size:18px}.demo-section {margin-bottom:55px}.demo-link-list,.demo-shared-list {grid-template-columns:1fr}.demo-section-head {padding-bottom:18px}.demo-section-head span {font-size:12px}}
  @media print {.demo-topline,.demo-section-nav,.demo-rail,.demo-connection-list,.demo-graph-disclosure,.demo-explore-links {display:none}.demo-hero-grid,.demo-body {display:block}.demo-source-disclosure {display:block}.demo-source-disclosure summary {display:none}}
</style>
