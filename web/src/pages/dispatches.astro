---
import Base from '../layouts/Base.astro';
import { dispatches, entity, hrefFor, renderInlineMd, TYPE_LABELS } from '../lib/data.ts';

const items = dispatches();

function dayLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---
<Base
  bodyClass="entity type-page"
  title="Dispatches"
  description="Findings that connect records across the vault, newest first."
>
  <article class="entity-article dispatches">
    <header class="statement-band entry-band">
      <h1 class="entity-title">Dispatches</h1>
      <div class="band-row">
        <p class="band-lede">Findings that connect records across the vault, newest first.</p>
      </div>
    </header>

    {items.length === 0 && (
      <div class="statement-wrap"><div class="statement-read"><div class="prose"><p>No dispatches yet.</p></div></div></div>
    )}

    {items.map((d) => (
      <section class="dispatch" id={d.id}>
        <div class="statement-wrap">
          <div class="statement-read">
            <div class="prose">
              <h2><a href={`#${d.id}`}>{d.title}</a></h2>
              <p><time datetime={d.date}>{dayLabel(d.date)}</time></p>
              <Fragment set:html={d.body_html} />
            </div>
          </div>

        {d.footnotes.length > 0 && (
          <section class="footnotes-block">
            <h2 class="section-label">Sources</h2>
            <ol>
              {d.footnotes.map((f) => (
                <li id={`${d.id}-fn-${f.id}`}>
                  <span set:html={f.html ?? renderInlineMd(f.text)} />
                  {' '}<a class="fn-back" href={`#${d.id}-fnref-${f.id}`} aria-label="back to reference">↩</a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {d.entities.length > 0 && (
          <section class="backlinks hc-list-section" data-pagefind-ignore>
            <h2 class="section-heading">Entries <span class="hc-count-badge">{d.entities.length}</span></h2>
            <ul class="hc-list">
              {d.entities.map((id) => entity(id)).filter(Boolean).map((e) => (
                <li class={`hc-item type-${e!.type}`}>
                  <a href={hrefFor(e!)} data-preview>
                    <span class="hc-eyebrow">{TYPE_LABELS[e!.type]}</span>
                    <span class="hc-title">{e!.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        </div>
      </section>
    ))}
  </article>
</Base>
