---
import Base from '../layouts/Base.astro';
import { communities, entities, CLUSTER_MIN_SIZE, hrefFor, TYPE_LABELS, TYPE_PLURALS } from '../lib/data.ts';
import type { EntityType } from '../lib/types.ts';

const MIN_SIZE = CLUSTER_MIN_SIZE;
const all = communities();
const big = all.filter((c) => c.size >= MIN_SIZE).sort((a, b) => b.size - a.size);
const small = all.filter((c) => c.size < MIN_SIZE);
const smallMembers = small.reduce((n, c) => n + c.size, 0);
const members = new Map<number, ReturnType<typeof entities>>();
for (const entity of entities()) {
  if (entity.community_id == null) continue;
  const group = members.get(entity.community_id) ?? [];
  group.push(entity);
  members.set(entity.community_id, group);
}
const overflow = new Map(big.map((c) => {
  const visible = new Set(c.top.map((m) => m.id));
  return [c.id, (members.get(c.id) ?? [])
    .filter((m) => !visible.has(m.id))
    .sort((a, b) => b.mention_count - a.mention_count || a.title.localeCompare(b.title))];
}));
---
<Base
  bodyClass="utility"
  title="Clusters | The Info Web"
  description="Groups of entries with more links to one another than to the rest of the site."
>
  <article class="changelog-article clusters-article">
    <h1 class="entity-title">Clusters</h1>
    <details class="cluster-method"><summary>How are these groups formed?</summary><p>Entries are grouped by denser links within the archive. Each label comes from the group's three most-mentioned members, and groups smaller than {MIN_SIZE} entries appear at the end.</p></details>

    {big.map((c) => (
      <section class="cl-group cluster" id={`c-${c.id}`}>
        <h2 class="cl-month cluster-label">
          <span class="cluster-swatch" style={`background: hsl(${Math.round((c.id * 137.508) % 360)}, 46%, 40%)`}></span>
          {c.label}
        </h2>
        <p class="cluster-meta">
          {c.size.toLocaleString()} entries ·
          {Object.entries(c.types).slice(0, 4).map(([t, n], i) => (
            <>{i > 0 && ', '}{n}{' '}{(TYPE_PLURALS[t as EntityType] ?? t).toLowerCase()}</>
          ))}
        </p>
        <ul class="hc-list cluster-members">
          {c.top.map((m) => (
            <li class={`hc-item type-${m.type}`}>
              <a href={hrefFor({ id: m.id, type: m.type })} data-preview>
                <span class="hc-eyebrow">{TYPE_LABELS[m.type as EntityType]}</span>
                <span class="hc-title">{m.title}</span>
                <span class="hc-mult">{m.mention_count}</span>
              </a>
            </li>
          ))}
        </ul>
        {(overflow.get(c.id)?.length ?? 0) > 0 && (
          <details class="cluster-overflow">
            <summary>
              <span class="cluster-expand">Show {overflow.get(c.id)!.length.toLocaleString()} more pages</span>
              <span class="cluster-collapse">Hide additional pages</span>
            </summary>
            <ul class="hc-list cluster-members">
              {overflow.get(c.id)!.map((m) => (
                <li class={'hc-item type-' + m.type}>
                  <a href={hrefFor({ id: m.id, type: m.type })} data-preview>
                    <span class="hc-eyebrow">{TYPE_LABELS[m.type as EntityType]}</span>
                    <span class="hc-title">{m.title}</span>
                    <span class="hc-mult">{m.mention_count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    ))}

    {small.length > 0 && (
      <section class="cl-group cluster">
        <h2 class="cl-month cluster-label">Smaller groups</h2>
        <p class="cluster-meta">
          {small.length} clusters of fewer than {MIN_SIZE} entries ({smallMembers} entries in total).
        </p>
        <ul class="hc-list cl-small-grid">
          {small.sort((a, b) => b.size - a.size).map((c) => (
            <li class="cl-small" id={`c-${c.id}`}>
              <ul class="hc-list">
                {c.top.map((m) => (
                  <li class={`hc-item type-${m.type}`}>
                    <a href={hrefFor({ id: m.id, type: m.type })} data-preview>
                      <span class="hc-eyebrow">{TYPE_LABELS[m.type as EntityType]}</span>
                      <span class="hc-title">{m.title}</span>
                      <span class="hc-mult">{m.mention_count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .cluster-method {font:400 14px/1.45 var(--sans);color:var(--muted);margin:18px 0 42px;max-width:65ch}
  .cluster-method summary {cursor:pointer;text-decoration:underline;text-underline-offset:3px}
  .cluster-method p {margin:10px 0}
  .cluster-members {grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr))}
  .cluster-overflow {margin-top:12px}
  .cluster-overflow summary {cursor:pointer;width:fit-content;padding:10px 0;font:500 14px/1.45 var(--sans);color:var(--ink)}
  .cluster-overflow summary:hover {color:var(--accent)}
  .cluster-overflow summary:focus-visible {outline:2px solid var(--accent);outline-offset:4px}
  .cluster-overflow .cluster-collapse {display:none}
  .cluster-overflow[open] .cluster-expand {display:none}
  .cluster-overflow[open] .cluster-collapse {display:inline}
  .cluster-overflow[open] .cluster-members {margin-top:8px}
</style>
