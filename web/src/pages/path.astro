---
import Base from '../layouts/Base.astro';
---
<Base
  bodyClass="utility"
  title="Find a path"
  description="Find a chain of connections between two entries."
  preloadAdjacency
>
  <article class="path-article">
    <h1 class="entity-title">Find a path</h1>
    <p class="entity-dek">
      Routes favor specific connections over entries mentioned throughout the site.
    </p>

    <form class="path-form" id="path-form" autocomplete="off">
      <div class="path-row">
        <label class="path-field">
          <span class="path-label">From</span>
          <input
            type="text"
            id="path-from"
            class="path-input"
            placeholder="Search for an entry…"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="path-from-suggest"
          />
          <ul class="path-suggest" id="path-from-suggest" role="listbox" aria-label="From suggestions"></ul>
        </label>
        <button type="button" class="path-swap" id="path-swap" aria-label="Swap endpoints" title="Swap endpoints">⇄</button>
        <label class="path-field">
          <span class="path-label">To</span>
          <input
            type="text"
            id="path-to"
            class="path-input"
            placeholder="Search for an entry…"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="path-to-suggest"
          />
          <ul class="path-suggest" id="path-to-suggest" role="listbox" aria-label="To suggestions"></ul>
        </label>
      </div>
      <div class="path-actions">
        <button type="submit" class="path-go">Find connection <span aria-hidden="true">→</span></button>
        <span class="path-status" id="path-status" role="status" aria-live="polite"></span>
      </div>
    </form>

    <section class="path-result" id="path-result" hidden></section>
  </article>

  <script>
    import { findPath, renderChain, entityCombobox } from '../scripts/path-find';
    import { loadAdjacency } from '../scripts/adjacency';

    const fromInput = document.getElementById('path-from') as HTMLInputElement;
    const toInput = document.getElementById('path-to') as HTMLInputElement;
    const status = document.getElementById('path-status')!;
    const result = document.getElementById('path-result')!;
    // Node indices picked from the suggestions; the typed text is never matched.
    let fromIdx = -1;
    let toIdx = -1;

    const clearResult = () => { result.hidden = true; status.textContent = ''; };
    entityCombobox(fromInput, document.getElementById('path-from-suggest')!, (i) => { fromIdx = i; clearResult(); });
    entityCombobox(toInput, document.getElementById('path-to-suggest')!, (i) => { toIdx = i; clearResult(); });

    document.getElementById('path-swap')!.addEventListener('click', () => {
      clearResult();
      [fromInput.value, toInput.value] = [toInput.value, fromInput.value];
      [fromIdx, toIdx] = [toIdx, fromIdx];
    });

    async function run() {
      result.hidden = true;
      result.replaceChildren();
      if (fromIdx < 0 || toIdx < 0) { status.textContent = 'Pick an entity for both From and To.'; return; }
      if (fromIdx === toIdx) { status.textContent = 'Source and target are the same.'; return; }
      const data = await loadAdjacency();
      const path = findPath(data.adj, data.dir, fromIdx, toIdx);
      if (!path) {
        status.textContent = `No documented path between ${data.titles[fromIdx]} and ${data.titles[toIdx]}.`;
        return;
      }
      // Keep the address bar shareable.
      const url = new URL(location.href);
      url.searchParams.set('from', data.ids[fromIdx]);
      url.searchParams.set('to', data.ids[toIdx]);
      history.replaceState(null, '', url);
      status.textContent = `${path.length - 1} hop${path.length === 2 ? '' : 's'}.`;
      result.append(renderChain(data, path));
      result.hidden = false;
    }
    document.getElementById('path-form')!.addEventListener('submit', (e) => { e.preventDefault(); run(); });

    // Deep links: /path/?from=<id>&to=<id> prefills, and runs when both resolve.
    status.textContent = 'Loading network…';
    loadAdjacency().then((data) => {
      status.textContent = '';
      const params = new URLSearchParams(location.search);
      fromIdx = data.ids.indexOf(params.get('from') ?? '');
      toIdx = data.ids.indexOf(params.get('to') ?? '');
      if (fromIdx >= 0) fromInput.value = data.titles[fromIdx];
      if (toIdx >= 0) toInput.value = data.titles[toIdx];
      if (fromIdx >= 0 && toIdx >= 0) run();
    }, () => { status.textContent = 'Could not load connections. Try again.'; });
  </script>
</Base>
