---
import Base from '../../layouts/Base.astro';
import DirectoryExplorer from '../../components/DirectoryExplorer.astro';
import { BROWSE_TYPES, entitiesByType, TYPE_DIRS, TYPE_PLURALS } from '../../lib/data.ts';
import { collectionPage, SITE_TITLE } from '../../lib/site.ts';
import type { EntityType } from '../../lib/types.ts';

export function getStaticPaths() {
  return BROWSE_TYPES.map((type) => ({ params: { type: TYPE_DIRS[type] }, props: { entityType: type } }));
}

const { entityType } = Astro.props as { entityType: EntityType };
const items = entitiesByType(entityType).sort((a, b) => a.title.localeCompare(b.title));
const plural = TYPE_PLURALS[entityType];
const path = `/${TYPE_DIRS[entityType]}/`;
const description = `Explore ${plural.toLowerCase()} in ${SITE_TITLE} by name and category.`;
---
<Base title={plural} description={description} jsonLd={collectionPage(plural, description, path, items.length)} breadcrumbs={[{ name: plural, item: path }]}>
  <DirectoryExplorer items={items} directory={plural} singular={entityType} />
</Base>
