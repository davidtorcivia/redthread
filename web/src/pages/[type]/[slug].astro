---
import Base from '../../layouts/Base.astro';
import Headline from '../../components/Headline.astro';
import Backlinks from '../../components/Backlinks.astro';
import HiddenConnections from '../../components/HiddenConnections.astro';
import NetworkGraph from '../../components/NetworkGraph.astro';
import PathWidget from '../../components/PathWidget.astro';
import RelatedGrid from '../../components/RelatedGrid.astro';
import Relations from '../../components/Relations.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FootnotePreviews from '../../components/FootnotePreviews.astro';
import { entities, hrefFor, communityOf, CLUSTER_MIN_SIZE, tagHref, renderInlineMd, TYPE_DIRS, TYPE_LABELS, TYPE_PLURALS } from '../../lib/data.ts';
import { formatDates } from '../../lib/dates.ts';
import { absUrl } from '../../lib/site.ts';
import type { Entity } from '../../lib/types.ts';

export function getStaticPaths() {
  // Previous/next links walk each type alphabetically.
  return [...Map.groupBy(entities(), (e) => e.type).values()].flatMap((list) => {
    list.sort((a, b) => a.title.localeCompare(b.title));
    return list.map((entity, i) => ({
      params: { type: TYPE_DIRS[entity.type], slug: entity.id },
      props: { entity, previous: list[i - 1], next: list[i + 1] },
    }));
  });
}

const { entity, previous, next } = Astro.props as { entity: Entity; previous?: Entity; next?: Entity };
const typeLabel = TYPE_LABELS[entity.type];
const typePlural = TYPE_PLURALS[entity.type];
const dir = TYPE_DIRS[entity.type];
const href = hrefFor(entity);

const dates = entity.dates ?? {};
const dateValue = formatDates(dates);
const locations = entity.locations ?? [];
const cluster = communityOf(entity);
const clusterShown = cluster && cluster.size >= CLUSTER_MIN_SIZE ? cluster : null;
const fm = entity.frontmatter;
const rawAliases = Array.isArray(fm.aliases) ? fm.aliases : [];
// Shown under the title and weighted in search, so an alias finds the entry.
const aliases = rawAliases
  .map((a) => String(a).trim())
  .filter((a) => a && a.toLowerCase() !== entity.title.toLowerCase());

// schema.org type closest to each entry type; anything else is a Thing.
const SCHEMA_TYPE: Record<string, string> = {
  person: 'Person',
  organization: 'Organization',
  event: 'Event',
  place: 'Place',
  program: 'CreativeWork',
  concept: 'Thing',
  source: 'CreativeWork',
};
const dated = entity.type === 'event' || entity.type === 'program';
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': SCHEMA_TYPE[entity.type] ?? 'Thing',
  name: entity.title,
};
if (entity.summary) jsonLd.description = entity.summary;
if (dates.born) jsonLd.birthDate = dates.born;
if (dates.died) jsonLd.deathDate = dates.died;
if (dated && (dates.start || dates.date)) jsonLd.startDate = dates.start ?? dates.date;
if (dated && dates.end) jsonLd.endDate = dates.end;
if (locations.length > 0) jsonLd.location = locations.length === 1 ? locations[0] : locations;
if (entity.tags?.length) jsonLd.keywords = entity.tags.map(String).join(', ');
jsonLd.url = absUrl(href);
jsonLd.image = absUrl(`/og/${dir}/${entity.id}.png`);
if (typeof fm.created === 'string' && fm.created) jsonLd.datePublished = fm.created;
const modified = (typeof fm.updated === 'string' && fm.updated) || entity.mtime;
if (modified) jsonLd.dateModified = modified;
if (rawAliases.length > 0) jsonLd.alternateName = rawAliases.length === 1 ? rawAliases[0] : rawAliases;
if (entity.tags?.length) jsonLd.about = entity.tags.map((t) => ({ '@type': 'Thing', name: String(t) }));
---
<Base
  title={entity.title}
  description={entity.summary ?? undefined}
  bodyClass={`entity type-${entity.type}`}
  ogType={entity.type === 'person' ? 'profile' : 'article'}
  ogImage={`/og/${dir}/${entity.id}.png`}
  jsonLd={jsonLd}
  preloadAdjacency
  alternateMd={`/${dir}/${entity.id}.md`}
  breadcrumbs={[
    { name: typePlural, item: `/${dir}/` },
    { name: entity.title, item: href },
  ]}
>
  <article
    class="entity-article"
    data-pagefind-body
    data-pagefind-meta={`title:${entity.title}`}
  >
    <span data-pagefind-filter={`type:${typeLabel}`} hidden></span>
    {entity.category && (
      <span data-pagefind-filter={`category:${entity.category}`} hidden></span>
    )}

    <header class="statement-band entry-band">
      <Headline class={['entity-title', entity.title.length > 22 && 'long-title', entity.title.length > 55 && 'very-long-title'].filter(Boolean).join(' ')} title={entity.title} />
      <div class="band-row">
        {entity.summary && <p class="band-lede" set:html={renderInlineMd(entity.summary)} />}
        <div class="band-facts">
          <div><a href={`/${dir}/`}>{entity.category || typeLabel}</a>{aliases.length > 0 && <span data-pagefind-weight="10"> · {aliases.join(', ')}</span>}</div>
          {(dateValue || locations.length > 0) && <div>{dateValue}{dateValue && locations.length > 0 && ' · '}{locations.join(', ')}</div>}
          <div>Referenced on {entity.mention_count.toLocaleString()} pages{clusterShown && <> · <a href={`/clusters/#c-${clusterShown.id}`}>{clusterShown.label} cluster</a></>}</div>
          {(entity.bridge_rank || entity.hub_rank) && <div>
            {entity.bridge_rank && <a href={`/bridges/#br-${entity.id}`}>Bridge #{entity.bridge_rank}</a>}
            {entity.bridge_rank && entity.hub_rank && ' · '}
            {entity.hub_rank && <a href={`/bridges/#hu-${entity.id}`}>Hub #{entity.hub_rank}</a>}
          </div>}
        </div>
      </div>
    </header>
    <div class="statement-wrap">
      <div class="statement-read">
        <TableOfContents entries={entity.toc ?? []} />
        <div class="prose" set:html={entity.body_html} />
      </div>

    <Relations e={entity} />

    {entity.footnotes.length > 0 && (
      <section class="footnotes-block">
        <h2 class="section-label">Sources</h2>
        <ol>
          {entity.footnotes.map((f) => (
            <li id={`fn-${f.id}`}>
              <span set:html={f.html ?? renderInlineMd(f.text)} />
              {' '}<a class="fn-back" href={`#fnref-${f.id}`} aria-label="back to reference">↩</a>
            </li>
          ))}
        </ol>
      </section>
    )}
    {entity.footnotes.length > 0 && <FootnotePreviews />}

    <RelatedGrid id={entity.id} />

    <HiddenConnections id={entity.id} />

    <PathWidget fromId={entity.id} fromTitle={entity.title} />

    <NetworkGraph id={entity.id} title={entity.title} />

    <Backlinks id={entity.id} />
    {entity.tags.length > 0 && <section class="statement-list" data-pagefind-ignore>
      <h2 class="section-heading">Tags</h2>
      <div class="statement-chips">{entity.tags.map(t => <a href={tagHref(t)}>{t}</a>)}</div>
    </section>}

    <nav class="entry-pagination" aria-label="Adjacent entries">
      <span>{previous && <a href={hrefFor(previous)}>← {previous.title}</a>}</span>
      <span>{next && <a href={hrefFor(next)}>{next.title} →</a>}</span>
    </nav>
    </div>
  </article>
</Base>
