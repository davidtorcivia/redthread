---
import Base from '../../layouts/Base.astro';
import Backlinks from '../../components/Backlinks.astro';
import HiddenConnections from '../../components/HiddenConnections.astro';
import NetworkGraph from '../../components/NetworkGraph.astro';
import PathWidget from '../../components/PathWidget.astro';
import RelatedGrid from '../../components/RelatedGrid.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { entities, tagHref, renderInlineMd, TYPE_DIRS, TYPE_LABELS, TYPE_PLURALS } from '../../lib/data.ts';
import type { Entity } from '../../lib/types.ts';

export function getStaticPaths() {
  return entities().map((e) => ({
    params: { type: TYPE_DIRS[e.type], slug: e.id },
    props: { entity: e },
  }));
}

const { entity } = Astro.props as { entity: Entity };
const typeLabel = TYPE_LABELS[entity.type];
const typePlural = TYPE_PLURALS[entity.type];
const typeHref = `/${TYPE_DIRS[entity.type]}/`;

// Short-form date label: prefer just the year so meta stays terse.
function yearOf(s?: string): string | null {
  if (!s) return null;
  const m = s.match(/^(\d{4})/);
  return m ? m[1] : s;
}
const dates = entity.dates ?? {};
const born = yearOf(dates.born);
const died = yearOf(dates.died);
const start = yearOf(dates.start);
const end = yearOf(dates.end);
const date = yearOf(dates.date);
// Compose a single "Lifespan / Active / Date" line per entity, depending
// on which fields are present. People get born–died; events/programs get
// start–end; single-day events get just the date.
let dateLabel: string | null = null;
let dateValue: string | null = null;
if (born || died) {
  dateLabel = 'Lifespan';
  dateValue = `${born ?? '?'}–${died ?? 'present'}`;
} else if (start || end) {
  dateLabel = 'Active';
  dateValue = `${start ?? '?'}–${end ?? 'present'}`;
} else if (date) {
  dateLabel = 'Date';
  dateValue = date;
}
const locations = entity.locations ?? [];

// Schema.org JSON-LD — maps our entity types to the closest schema.org
// type and emits known dates/locations. Search engines use this for
// knowledge-panel-style results.
const SCHEMA_TYPE: Record<string, string> = {
  person: 'Person',
  organization: 'Organization',
  event: 'Event',
  place: 'Place',
  program: 'CreativeWork',
  concept: 'Thing',
  source: 'CreativeWork',
};
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': SCHEMA_TYPE[entity.type] ?? 'Thing',
  name: entity.title,
};
if (entity.summary) jsonLd.description = entity.summary;
if (dates.born) jsonLd.birthDate = dates.born;
if (dates.died) jsonLd.deathDate = dates.died;
if ((dates.start || dates.date) && (entity.type === 'event' || entity.type === 'program')) {
  jsonLd.startDate = dates.start ?? dates.date;
}
if (dates.end && (entity.type === 'event' || entity.type === 'program')) {
  jsonLd.endDate = dates.end;
}
if (locations.length > 0) jsonLd.location = locations.length === 1 ? locations[0] : locations;
if (entity.tags?.length) jsonLd.keywords = entity.tags.map(String).join(', ');

const ogType = entity.type === 'person' ? 'profile' : 'article';
// Per-entity OG card path mirrors the entity page URL — easy to predict
// and matches the route in src/pages/og/[type]/[slug].png.ts.
const ogImage = `/og/${TYPE_DIRS[entity.type]}/${entity.id}.png`;
// LLM tools auto-discover the clean-markdown companion via rel=alternate.
// The .md sits beside the HTML directory (e.g. /people/foo.md next to
// /people/foo/) and is emitted by parse_vault → build.sh copies into public/.
const mdHref = `/${TYPE_DIRS[entity.type]}/${entity.id}.md`;
---
<Base
  title={`${entity.title} — The Info Web`}
  description={entity.summary ?? undefined}
  bodyClass={`entity type-${entity.type}`}
  ogType={ogType}
  ogImage={ogImage}
  jsonLd={jsonLd}
  preloadAdjacency
  alternateMd={mdHref}
>
  <article
    class="entity-article"
    data-pagefind-body
    data-pagefind-meta={`title:${entity.title}`}
  >
    <span data-pagefind-filter={`type:${typeLabel}`} hidden></span>
    {entity.category && (
      <span data-pagefind-filter={`category:${entity.category}`} hidden></span>
    )}

    <div class="entity-eyebrow">
      <a href={typeHref}>{typePlural}</a>
      {entity.category && (
        <>
          <span class="crumb-sep">·</span>
          <span>{entity.category}</span>
        </>
      )}
    </div>

    <h1 class="entity-title">{entity.title}</h1>

    {entity.summary && <p class="entity-dek" set:html={renderInlineMd(entity.summary)} />}

    <div class="entity-meta">
      {dateLabel && (
        <span class="meta-item">
          <span class="meta-label">{dateLabel}</span>
          <span class="meta-value">{dateValue}</span>
        </span>
      )}
      {locations.length > 0 && (
        <span class="meta-item">
          <span class="meta-label">Location</span>
          <span class="meta-value">{locations.join(', ')}</span>
        </span>
      )}
      {entity.mention_count > 0 && (
        <span class="meta-item">
          <span class="meta-label">Mentions</span>
          <span class="meta-value">{entity.mention_count}</span>
        </span>
      )}
      {entity.bridge_rank && (
        <span class="meta-item">
          <a
            class="bridge-badge"
            href={`/bridges/#br-${entity.id}`}
            title={`Bridge #${entity.bridge_rank}. This entry's neighbors span ${entity.community_span ?? 'multiple'} distinct community clusters — a low-degree connector between otherwise-separate parts of the network. Click for the full Bridges list.`}
          >
            Bridge <span class="bridge-rank">#{entity.bridge_rank}</span>
          </a>
        </span>
      )}
      {entity.hub_rank && (
        <span class="meta-item">
          <a
            class="bridge-badge hub-badge"
            href={`/bridges/#hu-${entity.id}`}
            title={`Hub #${entity.hub_rank}. High weighted PageRank — heavily mentioned and mentioned by other heavily-mentioned entries. Click for the full Hubs list.`}
          >
            Hub <span class="bridge-rank">#{entity.hub_rank}</span>
          </a>
        </span>
      )}
      {entity.tags.length > 0 && (
        <span class="meta-item">
          <span class="meta-label">Tags</span>
          {entity.tags.slice(0, 8).map((t) => (
            <a class="tag" href={tagHref(t)}>{t}</a>
          ))}
        </span>
      )}
    </div>

    <TableOfContents entries={entity.toc ?? []} />

    <div class="prose" set:html={entity.body_html} />

    {entity.footnotes.length > 0 && (
      <section class="footnotes-block">
        <h2 class="section-label">Sources</h2>
        <ol>
          {entity.footnotes.map((f) => (
            <li id={`fn-${f.id}`}>
              <span set:html={f.html ?? f.text} />
              {' '}<a class="fn-back" href={`#fnref-${f.id}`} aria-label="back to reference">↩</a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <RelatedGrid id={entity.id} />

    <HiddenConnections id={entity.id} />

    <PathWidget fromId={entity.id} fromTitle={entity.title} />

    <NetworkGraph id={entity.id} title={entity.title} />

    <Backlinks id={entity.id} />
  </article>
</Base>
