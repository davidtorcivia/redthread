---
import Base from '../../layouts/Base.astro';
import Headline from '../../components/Headline.astro';
import Backlinks from '../../components/Backlinks.astro';
import DispatchLinks from '../../components/DispatchLinks.astro';
import HiddenConnections from '../../components/HiddenConnections.astro';
import NetworkGraph from '../../components/NetworkGraph.astro';
import PathWidget from '../../components/PathWidget.astro';
import RelatedGrid from '../../components/RelatedGrid.astro';
import SimilarEntries from '../../components/SimilarEntries.astro';
import Relations from '../../components/Relations.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FootnotePreviews from '../../components/FootnotePreviews.astro';
import { aliasesOf, BROWSE_TYPES, entities, hrefFor, communityOf, CLUSTER_MIN_SIZE, tagHref, renderInlineMd, TYPE_DIRS, TYPE_LABELS, TYPE_PLURALS } from '../../lib/data.ts';
import { formatDates } from '../../lib/dates.ts';
import { entityJsonLd } from '../../lib/schema.ts';
import type { Entity } from '../../lib/types.ts';

export function getStaticPaths() {
  // Previous/next links walk each type alphabetically.
  return [...Map.groupBy(entities(), (e) => e.type).values()].flatMap((list) => {
    list.sort((a, b) => a.title.localeCompare(b.title));
    return list.map((entity, i) => ({
      params: { type: TYPE_DIRS[entity.type], slug: entity.id },
      props: { entity, previous: list[i - 1], next: list[i + 1] },
    }));
  });
}

const { entity, previous, next } = Astro.props as { entity: Entity; previous?: Entity; next?: Entity };
const typeLabel = TYPE_LABELS[entity.type];
const typePlural = TYPE_PLURALS[entity.type];
const dir = TYPE_DIRS[entity.type];
const href = hrefFor(entity);

const dates = entity.dates ?? {};
const dateValue = formatDates(dates);
const locations = entity.locations ?? [];
const cluster = communityOf(entity);
const clusterShown = cluster && cluster.size >= CLUSTER_MIN_SIZE ? cluster : null;
// Shown under the title and weighted in search, so an alias finds the entry.
const aliases = aliasesOf(entity).filter((a) => a.toLowerCase() !== entity.title.toLowerCase());
// The rest fold behind "+N more"; all stay in the DOM for search, and show without JavaScript.
const ALIASES_SHOWN = 3;
const moreAliases = aliases.length > ALIASES_SHOWN + 1 ? aliases.slice(ALIASES_SHOWN) : [];
const ranks = [
  entity.hub_rank && { href: `/bridges/#hu-${entity.id}`, text: `Hub #${entity.hub_rank}` },
  entity.bridge_rank && { href: `/bridges/#br-${entity.id}`, text: `Bridge #${entity.bridge_rank}` },
].filter(Boolean) as { href: string; text: string }[];

const jsonLd = entityJsonLd(entity);
---
<Base
  title={entity.title}
  description={entity.summary ?? undefined}
  bodyClass={`entity type-${entity.type}`}
  ogType={entity.type === 'person' ? 'profile' : 'article'}
  ogImage={`/og/${dir}/${entity.id}.png`}
  jsonLd={jsonLd}
  preloadAdjacency
  alternateMd={`/${dir}/${entity.id}.md`}
  breadcrumbs={[
    { name: typePlural, item: `/${dir}/` },
    { name: entity.title, item: href },
  ]}
>
  <article
    class="entity-article"
    data-pagefind-body
    data-pagefind-meta={`title:${entity.title}`}
    data-recent-title={entity.title}
    data-recent-type={entity.type}
  >
    <span data-pagefind-filter={`type:${typeLabel}`} hidden></span>
    {entity.category && (
      <span data-pagefind-filter={`category:${entity.category}`} hidden></span>
    )}

    <header class="statement-band entry-band">
      <Headline class={['entity-title', entity.title.length > 22 && 'long-title', entity.title.length > 55 && 'very-long-title'].filter(Boolean).join(' ')} title={entity.title} />
      <div class="band-row">
        {entity.summary && <p class="band-lede" set:html={renderInlineMd(entity.summary)} />}
        <dl class="band-facts">
          <div><dt>Category</dt><dd>{BROWSE_TYPES.includes(entity.type)
            ? <a href={entity.category ? `/${dir}/?category=${encodeURIComponent(entity.category)}#people-index` : `/${dir}/`}>{entity.category || typeLabel}</a>
            : entity.category || typeLabel}</dd></div>
          {aliases.length > 0 && <div><dt>Also known as</dt><dd class="band-aliases">
            <span data-pagefind-weight="10">{(moreAliases.length ? aliases.slice(0, ALIASES_SHOWN) : aliases).join(', ')}{moreAliases.length > 0 && <span class="aliases-more">, {moreAliases.join(', ')}</span>}</span>
            {moreAliases.length > 0 && <button type="button" class="aliases-toggle" aria-expanded="true" data-pagefind-ignore>+{moreAliases.length} more</button>}
          </dd></div>}
          {dateValue && <div><dt>Dates</dt><dd>{dateValue}</dd></div>}
          {locations.length > 0 && <div><dt>Location</dt><dd>{locations.join(', ')}</dd></div>}
          <div><dt>Mentioned on</dt><dd>{entity.mention_count.toLocaleString()} {entity.mention_count === 1 ? 'page' : 'pages'}</dd></div>
          {clusterShown && <div><dt>Cluster</dt><dd><a href={`/clusters/#c-${clusterShown.id}`}>{clusterShown.label}</a></dd></div>}
          {ranks.length > 0 && <div><dt>Rank</dt><dd>{ranks.map((r, i) => <>{i > 0 && ' · '}<a href={r.href}>{r.text}</a></>)}</dd></div>}
        </dl>
      </div>
    </header>
    <div class="statement-wrap">
      <div class="statement-read">
        <TableOfContents entries={entity.toc ?? []} />
        <div class="prose" set:html={entity.body_html} />
      </div>

    <Relations e={entity} />

    {entity.footnotes.length > 0 && (
      <section class="footnotes-block" id="sources" data-fold="narrow">
        <h2 class="section-label">Sources</h2>
        <ol id="sources-list">
          {entity.footnotes.map((f) => (
            <li id={`fn-${f.id}`}>
              <span set:html={f.html ?? renderInlineMd(f.text)} />
              {' '}<a class="fn-back" href={`#fnref-${f.id}`} aria-label="back to reference">↩</a>
            </li>
          ))}
        </ol>
        {entity.footnotes.length > 4 && <button type="button" class="fold-toggle" aria-controls="sources-list" aria-expanded="true" hidden data-pagefind-ignore>Show all {entity.footnotes.length} sources</button>}
      </section>
    )}
    {entity.footnotes.length > 0 && <FootnotePreviews />}

    <RelatedGrid id={entity.id} />

    <SimilarEntries id={entity.id} />

    <HiddenConnections id={entity.id} />

    <PathWidget fromId={entity.id} fromTitle={entity.title} />

    <NetworkGraph id={entity.id} title={entity.title} />

    <DispatchLinks id={entity.id} />

    <Backlinks id={entity.id} />
    {entity.tags.length > 0 && <section class="statement-list" data-pagefind-ignore>
      <h2 class="section-heading">Tags</h2>
      <div class="statement-chips">{entity.tags.map(t => <a href={tagHref(t)}>{t}</a>)}</div>
    </section>}

    <script is:inline>
      // Fold the long alias list, long sections marked data-fold ("always", or "narrow" for
      // phones only), and nothing without JS. Opening is one way: a reader who expanded keeps it.
      (() => {
        const toggle = document.querySelector('.aliases-toggle');
        const more = document.querySelector('.aliases-more');
        if (toggle && more) {
          more.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          toggle.addEventListener('click', () => { more.hidden = false; toggle.remove(); });
        }
        const narrow = matchMedia('(max-width: 700px)');
        for (const block of document.querySelectorAll('[data-fold]')) {
          const button = block.querySelector('.fold-toggle');
          if (!button) continue;
          const open = () => { block.classList.remove('is-folded'); button.hidden = true; button.setAttribute('aria-expanded', 'true'); };
          const phoneOnly = block.dataset.fold === 'narrow';
          if ((phoneOnly && !narrow.matches) || (block.id === 'sources' && location.hash.startsWith('#fn-'))) { open(); continue; }
          block.classList.add('is-folded');
          button.hidden = false;
          button.setAttribute('aria-expanded', 'false');
          button.addEventListener('click', open);
          if (phoneOnly) narrow.addEventListener('change', () => { if (!narrow.matches) open(); });
          if (block.id === 'sources') {
            // A footnote number or a link to one opens the list before the jump lands.
            document.addEventListener('click', (e) => { if (e.target.closest && e.target.closest('a[href^="#fn-"]')) open(); }, true);
            addEventListener('hashchange', () => { if (location.hash.startsWith('#fn-')) open(); });
          }
        }
      })();

      // Each h3 folds the content up to the next h1-h3. Open by default; find-in-page
      // (hidden=until-found) and any in-page link into a folded section reopen it.
      (() => {
        const bodies = new Map();
        for (const h of document.querySelectorAll('.prose > h3')) {
          const body = document.createElement('div');
          body.className = 'h3-body';
          let n = h.nextElementSibling;
          while (n && !/^H[1-3]$/.test(n.tagName)) { const next = n.nextElementSibling; body.append(n); n = next; }
          if (!body.childElementCount) continue;
          body.id = `${h.id || 'section-' + bodies.size}-body`;
          h.after(body);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'h3-toggle';
          button.setAttribute('aria-expanded', 'true');
          button.setAttribute('aria-controls', body.id);
          button.append(...h.childNodes);
          button.insertAdjacentHTML('beforeend', '<svg class="h3-chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg>');
          h.append(button);
          const set = (open) => {
            button.setAttribute('aria-expanded', String(open));
            h.classList.toggle('is-collapsed', !open);
            if (open) body.removeAttribute('hidden'); else body.setAttribute('hidden', 'until-found');
          };
          button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
          body.addEventListener('beforematch', () => set(true));
          bodies.set(body, set);
        }
        if (!bodies.size) return;
        const reveal = (id) => {
          const body = id && document.getElementById(decodeURIComponent(id))?.closest('.h3-body');
          if (body) bodies.get(body)(true);
        };
        // Capture phase, so the section is open before the TOC's own scroll handler measures.
        document.addEventListener('click', (e) => {
          const a = e.target.closest && e.target.closest('a[href^="#"]');
          if (a) reveal(a.getAttribute('href').slice(1));
        }, true);
        addEventListener('hashchange', () => reveal(location.hash.slice(1)));
        reveal(location.hash.slice(1));
      })();
    </script>

    <nav class="entry-pagination" aria-label="Adjacent entries">
      <span>{previous && <a href={hrefFor(previous)}>← {previous.title}</a>}</span>
      <span>{next && <a href={hrefFor(next)}>{next.title} →</a>}</span>
    </nav>
    </div>
  </article>
</Base>
