---
import Base from '../layouts/Base.astro';
import {
  entitiesWithDates,
  primaryYear,
  hrefFor,
  tagHref,
  renderInlineMd,
  TYPE_LABELS,
  TYPE_PLURALS,
} from '../lib/data.ts';
import type { Entity, EntityType } from '../lib/types.ts';

// Bucket by decade, then by year within the decade. Sparse data renders as
// wide gaps; that's honest. Shared years collapse under a single year label.
const dated = entitiesWithDates();
type Item = { entity: Entity; year: number };
type YearGroup = { year: number; items: Item[] };
type DecadeGroup = {
  decade: number;
  years: YearGroup[];
  total: number;
  typeBreakdown: [EntityType, number][];
  yearCounts: number[];
};

const byDecade = new Map<number, Map<number, Item[]>>();
for (const e of dated) {
  const y = primaryYear(e)!;
  const dec = Math.floor(y / 10) * 10;
  let years = byDecade.get(dec);
  if (!years) {
    years = new Map();
    byDecade.set(dec, years);
  }
  const arr = years.get(y) ?? [];
  arr.push({ entity: e, year: y });
  years.set(y, arr);
}

// Sort newest decade and newest year first so the timeline reads present →
// past as the reader scrolls down. The jump nav at the top mirrors that order.
const grouped: DecadeGroup[] = Array.from(byDecade.keys())
  .sort((a, b) => b - a)
  .map((dec) => {
    const years = byDecade.get(dec)!;
    const yearGroups: YearGroup[] = Array.from(years.keys())
      .sort((a, b) => b - a)
      .map((year) => ({
        year,
        items: years
          .get(year)!
          .sort((a, b) => a.entity.title.localeCompare(b.entity.title)),
      }));
    const typeMap = new Map<EntityType, number>();
    const yearCounts = new Array(10).fill(0);
    let total = 0;
    for (const yg of yearGroups) {
      yearCounts[yg.year - dec] = yg.items.length;
      total += yg.items.length;
      for (const { entity } of yg.items) {
        typeMap.set(entity.type, (typeMap.get(entity.type) ?? 0) + 1);
      }
    }
    const typeBreakdown = Array.from(typeMap.entries()).sort(
      ([, a], [, b]) => b - a,
    );
    return { decade: dec, years: yearGroups, total, typeBreakdown, yearCounts };
  });

// Sparkline scale: use the global busiest year so a quiet decade looks quiet
// relative to a loud one, not just relative to its own busiest year.
const globalMaxYearCount = Math.max(1, ...grouped.flatMap((g) => g.yearCounts));

const total = dated.length;

const typeCounts = new Map<EntityType, number>();
for (const e of dated) {
  typeCounts.set(e.type, (typeCounts.get(e.type) ?? 0) + 1);
}
const typesInUse: EntityType[] = Array.from(typeCounts.keys()).sort(
  (a, b) =>
    (typeCounts.get(b)! - typeCounts.get(a)!) ||
    TYPE_LABELS[a].localeCompare(TYPE_LABELS[b]),
);

function yearOf(s?: string): number | null {
  if (!s) return null;
  const m = s.match(/^(-?\d{1,4})/);
  return m ? parseInt(m[1], 10) : null;
}
function rangeFor(e: Entity): { text: string; years: number } | null {
  const a = yearOf(e.dates.born) ?? yearOf(e.dates.start);
  const b = yearOf(e.dates.died) ?? yearOf(e.dates.end);
  if (a == null || b == null) return null;
  if (a === b) return null;
  return { text: `${a}–${b}`, years: b - a };
}
---
<Base
  title="Timeline — The Info Web"
  description="Entries plotted by their primary date."
>
  <header class="browse-header">
    <div class="kicker">Browse · Timeline</div>
    <h1>Timeline</h1>
    <p class="lead">
      {total === 0
        ? 'No entries currently carry frontmatter date fields. Once a backfill pass populates born / died / start / end / date, they appear here automatically.'
        : `${total.toLocaleString()} entr${total === 1 ? 'y' : 'ies'} with a known date, grouped by decade.`}
    </p>
  </header>

  <section class="browse-body">
    {typesInUse.length > 1 && (
      <div class="tl-filters" data-tl-filters>
        <div class="tl-filters-group">
          <span class="tl-filters-label">Show</span>
          <div class="tl-filters-chips">
            {typesInUse.map((t) => (
              <button
                type="button"
                class={`net-chip active type-${t}`}
                data-tl-type={t}
                aria-pressed="true"
              >
                <span class="net-chip-name">{TYPE_LABELS[t]}</span>
                <span class="net-chip-count">{typeCounts.get(t)}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="tl-filters-tools">
          <input
            type="search"
            class="tl-search"
            placeholder="Search title, summary, tags, year…"
            data-tl-search
            aria-label="Search timeline"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            class="net-chip tl-summary-toggle"
            data-tl-summaries
            aria-pressed="false"
            title="Expand or collapse summaries"
          >
            Full summaries
          </button>
        </div>
      </div>
    )}

    {grouped.length > 1 && (
      <nav class="tl-decade-nav" aria-label="Jump to decade">
        <span class="tl-decade-nav-label">Jump</span>
        <ul class="tl-decade-nav-list">
          {grouped.map((g) => (
            <li><a href={`#d-${g.decade}`}>{g.decade}s</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="tl-body" data-tl-body>
      {grouped.map((g) => (
        <section class="tl-decade" id={`d-${g.decade}`}>
          <header class="tl-decade-header">
            <h2 class="tl-decade-label">{g.decade}s</h2>
            <div class="tl-decade-spark" aria-hidden="true">
              {g.yearCounts.map((count, i) => (
                <span
                  class="tl-decade-spark-bar"
                  style={`--h: ${count / globalMaxYearCount}`}
                  title={`${count} in ${g.decade + i}`}
                ></span>
              ))}
            </div>
          </header>
          <p class="tl-decade-meta">
            <span class="tl-decade-meta-total">
              {g.total} {g.total === 1 ? 'entry' : 'entries'}
            </span>
            {g.typeBreakdown.slice(0, 3).map((tb) => (
              <span class="tl-decade-meta-type">
                {tb[1]}{' '}
                {(tb[1] === 1
                  ? TYPE_LABELS[tb[0]]
                  : TYPE_PLURALS[tb[0]]
                ).toLowerCase()}
              </span>
            ))}
          </p>
          <ol class="tl-list">
            {g.years.map((yg) => (
              <li class="tl-year-cluster">
                <span class="tl-year">{yg.year}</span>
                <ul class="tl-cluster-items">
                  {yg.items.map(({ entity, year }) => {
                    const range = rangeFor(entity);
                    const haystack = [
                      entity.title,
                      entity.summary ?? '',
                      ...(entity.tags ?? []),
                      String(year),
                      range?.text ?? '',
                    ]
                      .join(' ')
                      .toLowerCase();
                    const hasPreview =
                      !!entity.summary ||
                      (entity.tags?.length ?? 0) > 0 ||
                      entity.mention_count > 0;
                    return (
                      <li
                        class={`tl-item type-${entity.type}`}
                        data-tl-type={entity.type}
                        data-tl-search={haystack}
                      >
                        <span class="tl-type">{TYPE_LABELS[entity.type]}</span>
                        <div class="tl-title-row">
                          <a class="tl-title" href={hrefFor({ id: entity.id, type: entity.type })}>
                            {entity.title}
                          </a>
                          {range && (
                            <span class="tl-lifespan">
                              <span
                                class="tl-lifespan-bar"
                                style={`--years: ${range.years}`}
                                aria-hidden="true"
                              ></span>
                              <span class="tl-range">{range.text}</span>
                            </span>
                          )}
                        </div>
                        {entity.summary && (
                          <span class="tl-summary" set:html={renderInlineMd(entity.summary)} />
                        )}
                        {hasPreview && (
                          <div class="tl-preview" role="tooltip">
                            {entity.summary && (
                              <p class="tl-preview-summary" set:html={renderInlineMd(entity.summary)} />
                            )}
                            {entity.tags && entity.tags.length > 0 && (
                              <div class="tl-preview-tags">
                                {entity.tags.slice(0, 6).map((t) => (
                                  <a class="tl-preview-tag" href={tagHref(t)}>#{t}</a>
                                ))}
                              </div>
                            )}
                            {entity.mention_count > 0 && (
                              <p class="tl-preview-meta">
                                {entity.mention_count.toLocaleString()} mention
                                {entity.mention_count === 1 ? '' : 's'} across the vault
                              </p>
                            )}
                          </div>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const filters = document.querySelector('[data-tl-filters]');
    if (!filters) return;
    const chips = filters.querySelectorAll('[data-tl-type]');
    const items = document.querySelectorAll('.tl-item[data-tl-type]');
    const search = document.querySelector('[data-tl-search]');
    const summariesBtn = document.querySelector('[data-tl-summaries]');
    const body = document.querySelector('[data-tl-body]');
    const hiddenTypes = new Set();
    let q = '';

    const apply = () => {
      items.forEach((item) => {
        const typeOut = hiddenTypes.has(item.dataset.tlType);
        const searchOut = q && !item.dataset.tlSearch.includes(q);
        item.classList.toggle('tl-out', typeOut || searchOut);
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const t = chip.dataset.tlType;
        const wasActive = chip.classList.contains('active');
        chip.classList.toggle('active');
        chip.setAttribute('aria-pressed', wasActive ? 'false' : 'true');
        if (wasActive) hiddenTypes.add(t);
        else hiddenTypes.delete(t);
        apply();
      });
    });

    if (search) {
      search.addEventListener('input', () => {
        q = search.value.toLowerCase().trim();
        apply();
      });
    }

    if (summariesBtn && body) {
      summariesBtn.addEventListener('click', () => {
        const wasActive = summariesBtn.classList.contains('active');
        summariesBtn.classList.toggle('active');
        summariesBtn.setAttribute('aria-pressed', wasActive ? 'false' : 'true');
        body.classList.toggle('tl-summaries-full');
      });
    }
  })();
</script>
