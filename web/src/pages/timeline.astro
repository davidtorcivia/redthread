---
import Base from '../layouts/Base.astro';
import { timelineRecords } from '../lib/timeline.ts';
import { TYPE_LABELS } from '../lib/data.ts';
import type { EntityType } from '../lib/types.ts';

const records = timelineRecords();
const primaryTypes: EntityType[] = ['event', 'program'];
const typeOrder: EntityType[] = ['event', 'program', 'person', 'organization', 'concept', 'place', 'source', 'misc', 'meta', 'page'];
const types = typeOrder.filter((type) => records.some((record) => record.type === type));
const counts = new Map(types.map((type) => [type, records.filter((record) => record.type === type).length]));
const initial = records.filter((record) => primaryTypes.includes(record.type));
const byDecade = new Map<number, typeof initial>();
for (const record of initial) {
  const decade = Math.floor(record.year / 10) * 10;
  const group = byDecade.get(decade) ?? [];
  group.push(record);
  byDecade.set(decade, group);
}
const decades = [...byDecade].sort(([a], [b]) => b - a);
const initialYearCounts = new Map<number, number>();
for (const record of initial) initialYearCounts.set(record.year, (initialYearCounts.get(record.year) ?? 0) + 1);
const initialPeak = Math.max(1, ...initialYearCounts.values());
const heatHeight = (count: number, peak: number) => count ? `${Math.round((0.16 + 0.84 * count / peak) * 100)}%` : '0';
---
<Base title="Timeline" description="Follow dated events and programs across the archive, with other entry types available as filters.">
  <div class="chronology" id="chronology">
    <header class="browse-header chron-header"><h1>Timeline</h1></header>
    <div class="chron-inner">
      <div class="chron-tools">
        <div class="chron-types" role="group" aria-label="Entry types">
          {types.map((type) => <button type="button" data-chron-type={type} aria-pressed={String(primaryTypes.includes(type))}>
            {TYPE_LABELS[type]} <span>{counts.get(type)}</span>
          </button>)}
        </div>
        <div class="chron-actions">
          <label><span class="sr-only">Search the timeline</span><input type="search" id="chron-search" placeholder="Search names, subjects, or years" autocomplete="off" /></label>
          <button type="button" id="chron-reset">Events &amp; programs</button>
        </div>
      </div>
      <p class="chron-status" id="chron-status" role="status" aria-live="polite">{initial.length.toLocaleString()} dated entries</p>
      <nav class="chron-decades" id="chron-decades" aria-label="Jump to decade; each bar represents one year">
        {decades.map(([decade, items]) => <a href={`#d-${decade}`} aria-label={`${decade}s, ${items.length} dated entries`}>
          <span class="chron-heat" aria-hidden="true">{Array.from({ length: 10 }, (_, offset) => <i style={`height:${heatHeight(initialYearCounts.get(decade + offset) ?? 0, initialPeak)}`} />)}</span>
          <span class="chron-decade-label">{decade}s</span>
        </a>)}
      </nav>
      <div class="chron-list" id="chron-list">
        {decades.map(([decade, items], index) => <details class="chron-decade" id={`d-${decade}`} open={index < 2}>
          <summary><span>{decade}s</span><small>{items.length} {items.length === 1 ? 'entry' : 'entries'}</small><i aria-hidden="true">+</i></summary>
          <ol>
            {items.map((item) => <li class={`chron-row type-${item.type}`}>
              <time>{item.year}</time>
              <div><span class="chron-kind">{item.kind} · {item.typeLabel}</span><a href={item.href}>{item.title}</a>{item.summary && <p>{item.summary}</p>}</div>
              {item.range && <span class="chron-range">{item.range}</span>}
            </li>)}
          </ol>
        </details>)}
      </div>
      <p class="chron-empty" id="chron-empty" hidden>No dated entries match those filters.</p>
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.getElementById('chronology');
      if (!root) return;
      const typeButtons = [...root.querySelectorAll('[data-chron-type]')];
      const allTypes = new Set(typeButtons.map((button) => button.dataset.chronType));
      const defaults = ['event', 'program'].filter((type) => allTypes.has(type));
      const input = root.querySelector('#chron-search');
      const reset = root.querySelector('#chron-reset');
      const list = root.querySelector('#chron-list');
      const nav = root.querySelector('#chron-decades');
      const status = root.querySelector('#chron-status');
      const empty = root.querySelector('#chron-empty');
      const params = new URLSearchParams(location.search);
      const parseTypes = (value) => value === 'none' ? [] : value ? value.split(',').filter((type) => allTypes.has(type)) : defaults;
      let selected = new Set(parseTypes(params.get('types')));
      let query = params.get('q') || '';
      let data = null;
      let pending = null;
      input.value = query;

      const normalize = (text) => (text || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const syncUrl = (push = false) => {
        const url = new URL(location.href);
        url.searchParams.delete('types'); url.searchParams.delete('q');
        const values = [...selected];
        if (values.join(',') !== defaults.join(',')) url.searchParams.set('types', values.length ? values.join(',') : 'none');
        if (query.trim()) url.searchParams.set('q', query.trim());
        history[push ? 'pushState' : 'replaceState'](null, '', url);
      };
      const setButtons = () => typeButtons.forEach((button) => button.setAttribute('aria-pressed', String(selected.has(button.dataset.chronType))));
      const load = () => {
        if (data) return Promise.resolve(data);
        if (!pending) pending = fetch('/timeline-data.json').then((response) => { if (!response.ok) throw Error('Timeline data unavailable'); return response.json(); }).then((records) => { data = records; return records; }).finally(() => { pending = null; });
        return pending;
      };
      const make = (tag, className, text) => {
        const el = document.createElement(tag);
        if (className) el.className = className;
        if (text != null) el.textContent = text;
        return el;
      };
      const render = () => {
        if (!data) return;
        const term = normalize(query.trim());
        const matches = data.filter((item) => selected.has(item.type) && (!term || normalize(item.search).includes(term)));
        status.textContent = `${matches.length.toLocaleString()} dated ${matches.length === 1 ? 'entry' : 'entries'}`;
        empty.hidden = matches.length > 0;
        const groups = new Map();
        const yearCounts = new Map();
        for (const item of matches) {
          const decade = Math.floor(item.year / 10) * 10;
          const group = groups.get(decade) || [];
          group.push(item);
          groups.set(decade, group);
          yearCounts.set(item.year, (yearCounts.get(item.year) || 0) + 1);
        }
        const peak = Math.max(1, ...yearCounts.values());
        list.replaceChildren(); nav.replaceChildren();
        let index = 0;
        for (const [decade, items] of groups) {
          const anchor = make('a');
          anchor.href = `#d-${decade}`;
          anchor.setAttribute('aria-label', `${decade}s, ${items.length} dated entries`);
          const heat = make('span', 'chron-heat');
          heat.setAttribute('aria-hidden', 'true');
          for (let offset = 0; offset < 10; offset++) {
            const count = yearCounts.get(decade + offset) || 0;
            const bar = make('i');
            bar.style.height = count ? `${Math.round((0.16 + 0.84 * count / peak) * 100)}%` : '0';
            heat.append(bar);
          }
          anchor.append(heat, make('span', 'chron-decade-label', `${decade}s`));
          nav.append(anchor);
          const section = make('details', 'chron-decade');
          section.id = `d-${decade}`;
          section.open = Boolean(term) || index++ < 2;
          const summary = make('summary');
          summary.append(make('span', '', `${decade}s`), make('small', '', `${items.length} ${items.length === 1 ? 'entry' : 'entries'}`), make('i', '', '+'));
          summary.lastChild.setAttribute('aria-hidden', 'true');
          section.append(summary);
          const ol = make('ol');
          for (const item of items) {
            const row = make('li', `chron-row type-${item.type}`);
            const year = make('time', '', String(item.year));
            const content = make('div');
            const title = make('a', '', item.title);
            title.href = item.href;
            content.append(make('span', 'chron-kind', `${item.kind} · ${item.typeLabel}`), title);
            if (item.summary) content.append(make('p', '', item.summary));
            row.append(year, content);
            if (item.range) row.append(make('span', 'chron-range', item.range));
            ol.append(row);
          }
          section.append(ol);
          list.append(section);
        }
        if (location.hash.startsWith('#d-')) {
          const target = document.getElementById(location.hash.slice(1));
          if (target) target.open = true;
        }
      };
      const update = async (push = false) => {
        syncUrl(push); setButtons(); status.textContent = 'Loading dates…';
        try { await load(); render(); }
        catch { status.textContent = 'Could not load additional dates. Reload to try again.'; }
      };
      typeButtons.forEach((button) => button.addEventListener('click', () => { const type = button.dataset.chronType; if (selected.has(type)) selected.delete(type); else selected.add(type); update(true); }));
      input.addEventListener('input', () => { query = input.value; update(); });
      reset.addEventListener('click', () => { selected = new Set(defaults); query = ''; input.value = ''; update(true); });
      nav.addEventListener('click', (event) => { const link = event.target.closest('a[href^="#d-"]'); if (!link) return; const target = document.getElementById(link.hash.slice(1)); if (target) target.open = true; });
      window.addEventListener('popstate', () => { const state = new URLSearchParams(location.search); selected = new Set(parseTypes(state.get('types'))); query = state.get('q') || ''; input.value = query; setButtons(); if (data) render(); else if (query || [...selected].join(',') !== defaults.join(',')) update(); });
      setButtons();
      if (query || [...selected].join(',') !== defaults.join(',')) update();
    })();
  </script>
</Base>

<style is:global>
  .chron-header {padding-bottom:34px}
  .chron-inner {padding:32px var(--gutter) 100px;max-width:1500px;margin:auto}
  .chron-tools {display:flex;flex-wrap:wrap;align-items:start;justify-content:space-between;gap:22px 35px;border-bottom:2px solid var(--ink);padding-bottom:24px}
  .chron-types {display:flex;flex-wrap:wrap;gap:6px;max-width:840px}
  .chron-types button {border:1px solid var(--line-2);background:var(--paper);color:var(--ink);padding:8px 10px;cursor:pointer;font:600 14px/1.2 var(--sans)}
  .chron-types button[aria-pressed=true] {background:var(--ink);color:var(--paper);border-color:var(--ink)}
  .chron-types button span {font-weight:400;opacity:.65;padding-left:5px}
  .chron-actions {display:flex;align-items:end;gap:15px;flex:1 1 300px;max-width:530px}
  .chron-actions label {flex:1}
  .chron-actions input {width:100%;border:0;border-bottom:1px solid var(--ink);border-radius:0;background:var(--paper);color:var(--ink);padding:10px 0;font:400 17px/1.3 var(--sans)}
  #chron-reset {border:0;background:none;text-decoration:underline;text-underline-offset:3px;color:var(--ink);white-space:nowrap;cursor:pointer;padding:10px 0;font:600 13px/1.3 var(--sans)}
  .chron-status {font:400 14px/1.3 var(--sans);color:var(--muted);margin:17px 0}
  .chron-decades {display:grid;grid-template-columns:repeat(auto-fit,minmax(95px,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:26px}
  .chron-decades:empty {display:none}
  .chron-decades a {position:relative;display:flex;align-items:end;min-width:0;height:76px;padding:5px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper);font:700 13px/1.2 var(--sans)}
  .chron-decades a:hover {background:var(--paper-2);color:var(--accent)}
  .chron-heat {position:absolute;inset:5px 5px 24px;display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:1px;align-items:end;pointer-events:none}
  .chron-heat i {display:block;background:var(--accent);opacity:.8;min-height:0}
  .chron-decade-label {position:relative;background:var(--paper);padding:1px 3px}
  .chron-decades a:hover .chron-decade-label {background:var(--paper-2)}
  .chron-decade {border-top:2px solid var(--ink);scroll-margin-top:25px}
  .chron-decade summary {display:flex;align-items:baseline;gap:18px;cursor:pointer;list-style:none;padding:18px 0;font-family:var(--sans)}
  .chron-decade summary::-webkit-details-marker {display:none}
  .chron-decade summary span {font-size:clamp(30px,4vw,52px);font-weight:700;line-height:1;letter-spacing:-.04em}
  .chron-decade summary small {font-size:14px;color:var(--muted)}
  .chron-decade summary i {margin-left:auto;font-size:25px;font-weight:300;font-style:normal;line-height:1}
  .chron-decade[open] summary i {transform:rotate(45deg)}
  .chron-decade ol {list-style:none;margin:0 0 35px;padding:0}
  .chron-row {display:grid;grid-template-columns:74px minmax(0,1fr) 110px;gap:12px 25px;border-top:1px solid var(--line);padding:15px 0}
  .chron-row time {font:700 17px/1.2 var(--sans);font-variant-numeric:tabular-nums}
  .chron-row>div {min-width:0}
  .chron-kind {display:block;color:var(--muted);font:600 12px/1.2 var(--sans);text-transform:uppercase;margin-bottom:4px}
  .chron-row a {font:650 clamp(19px,2vw,27px)/1.12 var(--sans);letter-spacing:-.02em;overflow-wrap:anywhere}
  .chron-row a:hover {color:var(--accent)}
  .chron-row p {font:400 16px/1.4 var(--serif);max-width:65ch;margin:7px 0 0;color:var(--muted)}
  .chron-range {font:400 13px/1.3 var(--sans);color:var(--muted);text-align:right}
  .chron-empty {font:400 17px/1.4 var(--sans);padding:30px 0}
  .chron-empty[hidden] {display:none}
  @media(max-width:720px) {.chron-inner {padding-top:25px}.chron-actions {max-width:none}.chron-row {grid-template-columns:55px minmax(0,1fr);gap:10px}.chron-range {grid-column:2;text-align:left}.chron-types button {font-size:13px}.chron-row p {font-size:15px}}
  @media(max-width:450px) {.chron-actions {display:block}.chron-actions label {display:block}#chron-reset {margin-top:6px}.chron-decades {grid-template-columns:repeat(auto-fit,minmax(92px,1fr))}.chron-decades a {height:64px}.chron-heat {bottom:22px}}
</style>
