---
import Base from '../../layouts/Base.astro';
import '../../styles/lineage.css';
import { entity as getEntity, hrefFor, lineageData, renderInlineMd } from '../../lib/data.ts';
import type { Lineage } from '../../scripts/lineage-view.ts';

export function getStaticPaths() {
  return lineageData().lineages.map((l) => ({ params: { id: l.id }, props: { l } }));
}
interface Props { l: Lineage }
const { l } = Astro.props;
const e = getEntity(l.id);
const years = l.rows.flatMap((r) => r.spans.flatMap((s) => [s.start, s.end ?? s.start]));
const meta = [`${l.rows.length} people and families by year`, `${Math.min(...years)}–${Math.max(...years)}`,
  l.events.length ? `${l.events.length} events` : ''].filter(Boolean).join(' · ');
// Inline JSON for the page script; "<" escaped so no entry text can close the tag.
const json = JSON.stringify(l).replace(/</g, '\\u003c');
---
<Base bodyClass="utility" title={`${l.title} lineage`} description={`Who founded and ran ${l.title}, everyone recorded there by year, and where they went next.`}>
  <article class="changelog-article lv-article" id="lv-lineage">
    <p class="lv-h"><a href="/lineage/">Lineages</a></p>
    <h1 class="entity-title">{e ? <a href={hrefFor(e)}>{l.title}</a> : l.title}</h1>
    {l.summary && <p class="entity-dek" set:html={renderInlineMd(l.summary)} />}
    <p class="lv-meta">{meta}</p>
    <div class="lv-tier"><h2 class="lv-h">Origins</h2><div class="lv-origins"></div></div>
    <div class="lv-tier">
      <h2 class="lv-h">People, by year</h2>
      <div>
        <div class="lv-gantt"><svg class="lv-names" aria-hidden="true"></svg><svg class="lv-chart" role="img" aria-label={`People at ${l.title} by year`}></svg></div>
        <div class="lv-key">
          <span><i style="background:var(--accent)"></i>headed</span>
          <span><i style="background:var(--ink)"></i>director</span>
          <span><i style="background:var(--line-2)"></i>member or employed</span>
          <span><i style="background:var(--line-2);opacity:.5"></i>end not recorded</span>
          {l.events.length > 0 && <span><i style="background:linear-gradient(var(--accent),transparent);opacity:.5"></i>event</span>}
        </div>
      </div>
    </div>
    <div class="lv-tier"><h2 class="lv-h">Later roles</h2><div class="lv-later"></div></div>
    <div class="lv-tier"><h2 class="lv-h">Reached by several members</h2><div class="lv-shared"></div></div>
    <script type="application/json" id="lv-data" is:inline set:html={json}></script>
  </article>
</Base>

<script>
  import { renderLineage } from '../../scripts/lineage-view';
  const root = document.getElementById('lv-lineage')!;
  renderLineage(root, JSON.parse(document.getElementById('lv-data')!.textContent!));
</script>
