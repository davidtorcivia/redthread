---
import Base from '../layouts/Base.astro';
import { entities, activity, communities, focus, CLUSTER_MIN_SIZE, hrefFor, renderInlineMd, topHubs, TYPE_DIRS, TYPE_LABELS, TYPE_PLURALS } from '../lib/data.ts';
import type { EntityType } from '../lib/types.ts';

const total = entities().length;
const types: EntityType[] = ['person', 'organization', 'program', 'event', 'concept', 'place'];
const byId = new Map(entities().map((e) => [e.id, e]));
const inFocus = focus();
const featured = inFocus.pages.flatMap(p => byId.has(p.id) ? [{ e: byId.get(p.id)!, reason: p.reason }] : []);
const focusCluster = inFocus.cluster;
const clusters = communities().filter(c => c.size >= CLUSTER_MIN_SIZE);
const featuredClusters = [...clusters].sort((a, b) => b.size - a.size).slice(0, 4);
const recent = activity().slice(0, 6);
const shortDate = (iso: string) => {
  const date = new Date(iso);
  return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
};
---
<Base title="The Info Web" bodyClass="home" description="A research vault on intelligence operations, parapsychology, government programs, and the parapolitical record.">
  <section class="statement-band home-band">
    <h1>The Info<br />Web</h1>
    <div class="band-row">
      <p class="band-lede">An archive of intelligence operations, government programs, parapsychology, and political scandals, with references and connections between the people and organizations involved.</p>
      <div class="band-facts">
        <div>{total.toLocaleString()} entries · <a href="/clusters/">{clusters.length} clusters</a></div>
        <div><a href="/network/">Network</a> · <a href="/path/">Path</a> · <a href="/bridges/">Bridges</a> · <a href="/clusters/">Clusters</a> · <a href="/tags/">Tags</a> · <a href="/sources/">Sources</a> · <a href="/timeline/">Timeline</a></div>
        <div><a href="/random/">Random</a> · <a href="/changelog/">Changelog</a></div>
      </div>
    </div>
  </section>
  <div class="statement-wrap">
    {featured.length > 0 && <section class="statement-list">
      <h2 class="section-heading">In focus <span>most worked on, last {inFocus.days} days</span></h2>
      {featured.map(({ e, reason }) => <article class="statement-item">
        <div class="item-facts"><b>{e.mention_count} pages</b> · {TYPE_LABELS[e.type]}{e.category && <i>{e.category}</i>}{reason && <i>{reason}</i>}</div>
        <a class="item-title" href={hrefFor(e)}>{e.title}</a>
        {e.summary && <p class="item-dek" set:html={renderInlineMd(e.summary)} />}
      </article>)}
      {focusCluster && <article class="statement-item">
        <div class="item-facts"><b>{focusCluster.size} entries</b> · Cluster<i>{focusCluster.edited} pages edited in the last {focusCluster.days} days</i></div>
        <a class="item-title" href={`/clusters/#c-${focusCluster.id}`}>{focusCluster.label}</a>
      </article>}
    </section>}
    <section class="statement-list">
      <h2 class="section-heading">Most mentioned</h2>
      <div class="statement-cols">{types.map(type => <div>
        <h3>{TYPE_PLURALS[type]} <a href={`/${TYPE_DIRS[type]}/`} aria-label={`All ${TYPE_PLURALS[type].toLowerCase()}`}>all</a></h3>
        <ol>{topHubs(8, type).map(e => <li><a href={hrefFor(e)}>{e.title}</a><span>{e.mention_count}</span></li>)}</ol>
      </div>)}</div>
    </section>
    {clusters.length > 0 && <section class="statement-list">
      <h2 class="section-heading">Clusters <span><a href="/clusters/">{featuredClusters.length} largest communities · all {clusters.length}</a></span></h2>
      {featuredClusters.map(c => <div class="statement-item">
        <span class="item-facts"><b>{c.size} entries</b></span>
        <a class="item-title" href={`/clusters/#c-${c.id}`}>{c.label}</a>
      </div>)}
    </section>}
    {recent.length > 0 && <section class="statement-list">
      <h2 class="section-heading">Recently edited <span><a href="/changelog/">changelog</a></span></h2>
      <div class="statement-chips">{recent.map(e => <a href={hrefFor(e)}>{e.title}<i>{shortDate(e.mtime)}</i></a>)}</div>
    </section>}
  </div>
</Base>
