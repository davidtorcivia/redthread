---
import Base from '../../layouts/Base.astro';
import { allTags } from '../../lib/data.ts';

const tags = [...allTags()].sort((a, b) => a.tag.localeCompare(b.tag));
const letters = [...new Set(tags.map((tag) => tag.tag[0]?.toUpperCase() || '#'))];
---
<Base title="All tags" description="Complete alphabetical index of tags in the archive." noindex>
  <div class="all-tags">
    <header class="browse-header"><h1>All tags</h1></header>
    <div class="all-tags-inner">
      <a href="/tags/">← Search tags</a>
      <nav aria-label="Jump to letter">{letters.map((letter) => <a href={`#letter-${letter}`}>{letter}</a>)}</nav>
      {letters.map((letter) => <section id={`letter-${letter}`}><h2>{letter}</h2><ul>{tags.filter((tag) => (tag.tag[0]?.toUpperCase() || '#') === letter).map((tag) => <li><a href={`/tag/${tag.slug}/`}>{tag.tag}</a><span>{tag.count}</span></li>)}</ul></section>)}
    </div>
  </div>
</Base>
<style>
  .all-tags-inner {max-width:1100px;margin:auto;padding:30px var(--gutter) 90px;font-family:var(--sans)}
  .all-tags-inner>a {font-size:14px;text-decoration:underline}
  nav {display:flex;flex-wrap:wrap;gap:10px;margin:25px 0}
  nav a {font-size:14px;border-bottom:1px solid var(--line-2)}
  section {border-top:2px solid var(--ink);margin:35px 0;scroll-margin-top:20px}
  h2 {font-size:28px;margin:10px 0}
  ul {list-style:none;margin:0;padding:0;columns:3;column-gap:25px}
  li {display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line);padding:7px 0;font-size:15px;break-inside:avoid}
  li a {overflow-wrap:anywhere}
  li span {color:var(--muted)}
  @media(max-width:750px) {ul {columns:2}}
  @media(max-width:500px) {ul {columns:1}}
</style>
