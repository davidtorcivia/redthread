---
import Base from '../layouts/Base.astro';
import { TYPE_DIRS } from '../lib/data.ts';
import { tagDirectoryRows } from '../lib/tag-directory.ts';

const rows = tagDirectoryRows();
const initial = rows.slice(0, 50);
// Most-used tags, skipping ones that just repeat an entry type.
const typeWords = new Set([...Object.keys(TYPE_DIRS), ...Object.values(TYPE_DIRS)]);
const startingPoints = rows.filter((row) => !typeWords.has(row.key)).slice(0, 8);
const letters = new Set(rows.map((row) => row.letter));
---
<Base
  title="Tags"
  description="Find subjects across the archive by tag. Search names and variant spellings, or browse the full index."
>
  <div class="tag-directory" id="tag-directory">
    <header class="browse-header tag-header"><h1>Tags</h1></header>
    <div class="tag-inner">
      <section class="tag-start" aria-labelledby="tag-start-title">
        <h2 id="tag-start-title">Start with a subject</h2>
        <div class="tag-start-grid">
          {startingPoints.map((row) => <a href={`/tag/${row.primary.slug}/`}>
            <span>{row.primary.tag}</span><small>{row.count.toLocaleString()} entries ↗</small>
          </a>)}
        </div>
      </section>

      <section class="tag-index" aria-labelledby="tag-index-title">
        <div class="tag-index-head">
          <div><h2 id="tag-index-title">Find a tag</h2><p id="tag-status" role="status" aria-live="polite">{rows.length.toLocaleString()} names</p></div>
          <label class="tag-search"><span class="sr-only">Search tags</span><input id="tag-query" type="search" placeholder="Search tags and spellings" autocomplete="off" /></label>
        </div>
        <div class="tag-index-controls">
          <nav class="tag-letters" aria-label="Filter tags by first letter">
            {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((letter) => letters.has(letter)
              ? <button type="button" data-letter={letter} aria-pressed="false">{letter}</button>
              : <span aria-hidden="true">{letter}</span>)}
          </nav>
          <label class="tag-minimum"><input id="tag-minimum" type="checkbox" /> Used on at least two entries</label>
          <button id="tag-clear" type="button" hidden>Clear filters</button>
        </div>
        <ul class="tag-rows" id="tag-rows">
          {initial.map((row) => <li class="tag-row">
            <div class="tag-row-name">
              {row.variants.length === 1
                ? <a href={`/tag/${row.primary.slug}/`}>{row.primary.tag}</a>
                : <><strong>{row.primary.tag}</strong><div class="tag-variants">{row.variants.map((tag) => <a href={`/tag/${tag.slug}/`}>{tag.tag} <span>{tag.count}</span></a>)}</div></>}
            </div>
            <span class="tag-row-count">{row.variants.length === 1 ? row.primary.count.toLocaleString() : `${row.variants.length} spellings`}</span>
          </li>)}
        </ul>
        <p class="tag-empty" id="tag-empty" hidden>No tags match those filters.</p>
        <button class="tag-more" id="tag-more" type="button">Show 50 more ↓</button>
        <noscript><p><a href="/tags/all/">Browse the complete A–Z list</a></p></noscript>
      </section>
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.getElementById('tag-directory');
      const list = root?.querySelector('#tag-rows');
      if (!list) return;
      const input = root.querySelector('#tag-query');
      const minimum = root.querySelector('#tag-minimum');
      const letters = [...root.querySelectorAll('[data-letter]')];
      const status = root.querySelector('#tag-status');
      const more = root.querySelector('#tag-more');
      const empty = root.querySelector('#tag-empty');
      const clear = root.querySelector('#tag-clear');
      const params = new URLSearchParams(location.search);
      const normalize = (text) => (text || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');
      let query = params.get('q') || '';
      let letter = /^[A-Z]$/.test(params.get('letter') || '') ? params.get('letter') : '';
      let two = params.get('multiple') === '1';
      let limit = 50;
      let data = null;
      let pending = null;
      input.value = query;
      minimum.checked = two;

      const load = () => {
        if (data) return Promise.resolve(data);
        if (!pending) pending = fetch('/tags-index.json').then((response) => { if (!response.ok) throw Error('Tag index unavailable'); return response.json(); }).then((rows) => { data = rows; return rows; }).finally(() => { pending = null; });
        return pending;
      };
      const syncUrl = (push = false) => {
        const url = new URL(location.href);
        ['q', 'letter', 'multiple'].forEach((key) => url.searchParams.delete(key));
        if (query.trim()) url.searchParams.set('q', query.trim());
        if (letter) url.searchParams.set('letter', letter);
        if (two) url.searchParams.set('multiple', '1');
        history[push ? 'pushState' : 'replaceState'](null, '', url);
      };
      const render = () => {
        if (!data) return;
        const term = normalize(query.trim());
        const matches = data.filter((row) => (!term || normalize(`${row.key} ${row.variants.map((tag) => tag.tag).join(' ')}`).includes(term)) && (!letter || row.letter === letter) && (!two || row.count >= 2));
        const fragment = document.createDocumentFragment();
        for (const row of matches.slice(0, limit)) {
          const li = document.createElement('li');
          li.className = 'tag-row';
          const name = document.createElement('div');
          name.className = 'tag-row-name';
          if (row.variants.length === 1) {
            const link = document.createElement('a');
            link.href = `/tag/${row.primary.slug}/`;
            link.textContent = row.primary.tag;
            name.append(link);
          } else {
            const title = document.createElement('strong');
            title.textContent = row.primary.tag;
            const variants = document.createElement('div');
            variants.className = 'tag-variants';
            for (const tag of row.variants) {
              const link = document.createElement('a');
              link.href = `/tag/${tag.slug}/`;
              link.textContent = `${tag.tag} `;
              const count = document.createElement('span');
              count.textContent = tag.count;
              link.append(count);
              variants.append(link);
            }
            name.append(title, variants);
          }
          const count = document.createElement('span');
          count.className = 'tag-row-count';
          count.textContent = row.variants.length === 1 ? row.primary.count.toLocaleString() : `${row.variants.length} spellings`;
          li.append(name, count);
          fragment.append(li);
        }
        list.replaceChildren(fragment);
        status.textContent = `${matches.length.toLocaleString()} ${matches.length === 1 ? 'name' : 'names'}${matches.length > limit ? ` · showing ${limit}` : ''}`;
        more.hidden = matches.length <= limit;
        empty.hidden = matches.length > 0;
        clear.hidden = !(term || letter || two);
        letters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.letter === letter)));
      };
      const update = async (push = false) => {
        syncUrl(push);
        status.textContent = 'Loading tags…';
        try { await load(); render(); }
        catch { status.textContent = 'Could not load the tag index. Reload to try again.'; }
      };
      input.addEventListener('input', () => { query = input.value; letter = ''; limit = 50; update(); });
      minimum.addEventListener('change', () => { two = minimum.checked; limit = 50; update(true); });
      letters.forEach((button) => button.addEventListener('click', () => { letter = letter === button.dataset.letter ? '' : button.dataset.letter; query = ''; input.value = ''; limit = 50; update(true); }));
      clear.addEventListener('click', () => { query = ''; letter = ''; two = false; limit = 50; input.value = ''; minimum.checked = false; update(true); });
      more.addEventListener('click', () => { limit += 50; update(); });
      window.addEventListener('popstate', () => { const state = new URLSearchParams(location.search); query = state.get('q') || ''; letter = /^[A-Z]$/.test(state.get('letter') || '') ? state.get('letter') : ''; two = state.get('multiple') === '1'; input.value = query; minimum.checked = two; limit = 50; if (data) render(); else if (query || letter || two) update(); });
      if (query || letter || two) update();
    })();
  </script>
</Base>

<style is:global>
  .tag-header {padding-bottom:34px}
  .tag-inner {padding:42px var(--gutter) 100px;max-width:1500px;margin:auto}
  .tag-start h2,.tag-index h2 {font:700 clamp(25px,3vw,36px)/1.1 var(--sans);letter-spacing:-.03em;margin:0 0 22px}
  .tag-start-grid {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
  .tag-start-grid a {display:flex;flex-direction:column;justify-content:space-between;min-height:125px;padding:18px;background:var(--paper);font:650 clamp(19px,2vw,26px)/1.1 var(--sans);letter-spacing:-.02em;overflow-wrap:anywhere}
  .tag-start-grid a:hover {background:var(--paper-2);color:var(--accent)}
  .tag-start-grid small {font:400 13px/1.3 var(--sans);letter-spacing:0;color:var(--muted);margin-top:20px}
  .tag-index {margin-top:80px;border-top:2px solid var(--ink);padding-top:18px}
  .tag-index-head {display:flex;justify-content:space-between;align-items:end;gap:25px}
  .tag-index-head h2 {margin-bottom:4px}
  #tag-status {margin:0;color:var(--muted);font:400 14px/1.4 var(--sans)}
  .tag-search {width:min(440px,45%)}
  .tag-search input {width:100%;border:0;border-bottom:2px solid var(--ink);border-radius:0;background:var(--paper);color:var(--ink);padding:12px 0;font:400 18px/1.3 var(--sans)}
  .tag-index-controls {display:flex;flex-wrap:wrap;align-items:center;gap:15px 25px;border-bottom:1px solid var(--line);padding:22px 0}
  .tag-letters {display:flex;flex-wrap:wrap;gap:5px}
  .tag-letters button,.tag-letters span {border:0;background:none;color:var(--ink);min-width:24px;padding:4px 2px;font:600 13px/1 var(--sans);text-align:center}
  .tag-letters span {color:var(--line-2)}
  .tag-letters button {cursor:pointer}
  .tag-letters button:hover,.tag-letters button[aria-pressed=true] {background:var(--ink);color:var(--paper)}
  .tag-minimum,#tag-clear {font:500 13px/1.3 var(--sans)}
  .tag-minimum {display:flex;align-items:center;gap:7px;cursor:pointer}
  .tag-minimum input {accent-color:var(--accent)}
  #tag-clear {border:0;background:none;text-decoration:underline;cursor:pointer;color:var(--ink)}
  .tag-rows {list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:45px}
  .tag-row {display:flex;justify-content:space-between;align-items:start;gap:15px;border-bottom:1px solid var(--line);padding:13px 0;min-width:0}
  .tag-row[hidden] {display:none}
  .tag-row-name {min-width:0;font:600 18px/1.2 var(--sans);overflow-wrap:anywhere}
  .tag-row-name a:hover,.tag-variants a:hover {color:var(--accent)}
  .tag-row-count {font:400 13px/1.4 var(--sans);color:var(--muted);white-space:nowrap}
  .tag-variants {display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:8px;font:400 13px/1.3 var(--sans)}
  .tag-variants a {border-bottom:1px solid var(--line-2)}
  .tag-variants a span {color:var(--muted)}
  .tag-empty {font:400 17px/1.4 var(--sans);padding:30px 0}
  .tag-more {display:block;border:1px solid var(--ink);background:var(--paper);color:var(--ink);padding:13px 20px;margin:26px auto 0;font:600 14px/1.2 var(--sans);cursor:pointer}
  .tag-more[hidden] {display:none}
  .tag-more:hover {background:var(--ink);color:var(--paper)}
  @media(max-width:900px) {.tag-start-grid {grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:650px) {.tag-inner {padding-top:30px}.tag-start-grid a {min-height:105px;padding:14px;font-size:16px}.tag-index {margin-top:60px}.tag-index-head {display:block}.tag-search {display:block;width:100%;margin-top:18px}.tag-rows {grid-template-columns:1fr}.tag-letters {gap:3px}.tag-letters button,.tag-letters span {min-width:22px}}
</style>
