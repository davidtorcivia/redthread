---
import Base from '../layouts/Base.astro';
import { entities, hrefFor } from '../lib/data.ts';

// Inlined on this page only: much smaller than fetching the graph to pick one URL.
const pool = entities().map(hrefFor);
---
<Base
  bodyClass="utility"
  title="Random entry"
  description="Jump to a random entry in the vault."
  noindex
>
  <article class="random-article">
    <p class="random-msg">Loading a random entry&hellip;</p>
    <noscript>
      <p>JavaScript is required to pick a random entry. <a href="/">Return home</a>.</p>
    </noscript>
  </article>

  <script is:inline define:vars={{ pool }}>
    // replace() keeps this page out of history, so Back returns to where the reader came from.
    if (pool.length > 0) {
      const pick = pool[Math.floor(Math.random() * pool.length)];
      window.location.replace(pick);
    } else {
      const msg = document.querySelector('.random-msg');
      if (msg) {
        msg.innerHTML = 'No entries to choose from yet. <a href="/">Return home</a>.';
      }
    }
  </script>

  <style is:inline>
    .random-article {
      max-width: 36rem;
      margin: 0 auto;
      padding: 8rem 1.5rem 4rem;
      font-family: var(--serif);
      font-style: italic;
      color: var(--muted);
      text-align: center;
    }
  </style>
</Base>
