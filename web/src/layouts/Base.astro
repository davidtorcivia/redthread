---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** og:type — "article" for entity pages, "profile" for people, "website" for browse pages (default). */
  ogType?: string;
  /** Optional structured-data block (JSON-LD). Entity pages pass schema.org payload. */
  jsonLd?: Record<string, unknown> | null;
  /** Set true for utility pages (e.g. /random/) we don't want crawlers indexing. */
  noindex?: boolean;
  /**
   * Relative path of the OG image for this page (e.g. "/og/people/marc-dutroux.png").
   * Falls back to the site-wide default card. The path is resolved against
   * Astro.site so crawlers see an absolute URL — required by Facebook,
   * preferred by everyone else.
   */
  ogImage?: string;
  /**
   * Emit a <link rel="preload"> for /adjacency.json. Opt-in: only set on
   * pages that actually fetch it (entity detail pages, /network/, /path/).
   * Listing/browse pages skip the preload so they don't pull ~150 KB of
   * graph data the user never touches.
   */
  preloadAdjacency?: boolean;
  /**
   * Path to a clean-markdown companion for this page (e.g. /people/foo.md).
   * Emitted as <link rel="alternate" type="text/markdown"> so LLM tools
   * fetch source markdown instead of having to parse the rendered HTML.
   */
  alternateMd?: string;
}
const {
  title,
  description,
  bodyClass,
  ogType = 'website',
  jsonLd = null,
  noindex = false,
  ogImage = '/og/site.png',
  preloadAdjacency = false,
  alternateMd,
} = Astro.props;

// Canonical URL is resolved from Astro's `site` config + the current path.
// Falls back to the relative path if site isn't set (e.g. local dev runs
// without SITE_URL exported).
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// OG image absolute URL. Falls back to the relative path when site isn't
// set (dev). Slack/Facebook require absolute URLs; Twitter accepts both
// but normalizes anyway.
const ogImageUrl = Astro.site
  ? new URL(ogImage, Astro.site).href
  : ogImage;

// Optional analytics snippet. Set ANALYTICS_SRC + ANALYTICS_ID in the build
// environment and a script tag gets injected into <head>. Defaults match
// Umami's convention (data-website-id="…"); override the attribute name with
// ANALYTICS_ID_ATTR for Plausible (data-domain), Fathom (data-site), etc.
const analyticsSrc = import.meta.env.ANALYTICS_SRC as string | undefined;
const analyticsId = import.meta.env.ANALYTICS_ID as string | undefined;
const analyticsIdAttr =
  (import.meta.env.ANALYTICS_ID_ATTR as string | undefined) || 'data-website-id';
const analyticsEnabled = Boolean(analyticsSrc && analyticsId);

// Cache-busting version for shared JSON payloads (adjacency.json,
// previews.json). Stamped onto every fetch + preload as ?v=…; see
// build.sh for how it's computed (sha1 of the two JSON files).
// Falls back to 'dev' for local runs that don't go through build.sh.
const V = (import.meta.env.PUBLIC_BUILD_ID as string | undefined) || 'dev';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    {/* Open Graph — used by Slack, Discord, iMessage, Facebook, etc. when
        a link to this page is pasted. The og:image is generated at build
        time per entity (see src/pages/og/[type]/[slug].png.ts); browse
        pages fall through to /og/site.png. */}
    <meta property="og:site_name" content="The Info Web" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    {/* Twitter card — summary_large_image because every page emits a
        1200x630 card. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23f7f2e7'/%3E%3Ctext y='.85em' x='8' font-family='Georgia,serif' font-size='86' font-weight='600' fill='%2394322a'%3EI%3C/text%3E%3C/svg%3E" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    {/* defer: ~120KB of search UI no longer blocks first paint. Pagefind
        only runs when the user opens search, but deferring still ensures
        window.PagefindUI is defined before our DOMContentLoaded init()
        below — no race on the first ⌘K. */}
    <script src="/pagefind/pagefind-ui.js" defer is:inline></script>
    {preloadAdjacency && (
      /* Shared adjacency map for the NetworkGraph widget on entity pages
         and the /network/ + /path/ tools. ~150 KB gzipped. Only preloaded
         where it'll actually be fetched — listing pages skip it. */
      <link rel="preload" as="fetch" href={`/adjacency.json?v=${V}`} crossorigin="anonymous" />
    )}
    {alternateMd && (
      <link rel="alternate" type="text/markdown" href={alternateMd} title="Source markdown" />
    )}
    {/* Exposes the build version to every is:inline fetch site so they
        can append ?v=… without each one needing its own define:vars. */}
    <script is:inline define:vars={{ V }}>window.__V = V;</script>

    {analyticsEnabled && (
      <script
        is:inline
        defer
        src={analyticsSrc}
        {...{ [analyticsIdAttr]: analyticsId }}
      ></script>
    )}
  </head>
  <body class={bodyClass}>
    <header class="site">
      <div class="bar">
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <span class="nav-icon" aria-hidden="true"></span>
        </button>
        <a href="/" class="brand">The Info Web</a>
        <nav id="site-nav">
          <a href="/people/">People</a>
          <a href="/organizations/">Organizations</a>
          <a href="/programs/">Programs</a>
          <a href="/events/">Events</a>
          <a href="/concepts/">Concepts</a>
          <a href="/places/">Places</a>
        </nav>
        <span class="spacer"></span>
        <button class="search-trigger" id="search-open" type="button" aria-label="Open search (Command-K)">
          <span>Search</span>
          <kbd>⌘ K</kbd>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        <a href="/" class="foot-brand">The Info Web</a>
        <nav class="foot-nav">
          <a href="/network/">Network</a>
          <a href="/path/">Path</a>
          <a href="/bridges/">Bridges</a>
          <a href="/tags/">Tags</a>
          <a href="/timeline/">Timeline</a>
          <a href="/random/">Random</a>
          <a href="/changelog/">Changelog</a>
          <a href="#top" class="to-top">↑ Top</a>
        </nav>
      </div>
    </footer>

    <div id="pf-modal" role="dialog" aria-modal="true" aria-label="Search">
      <div class="pf-shell">
        <div id="pf-mount"></div>
      </div>
    </div>

    <script is:inline>
      // ---------- Hover previews on wikilinks ----------
      (function () {
        if (!window.matchMedia('(hover: hover)').matches) return;
        const TYPE_DIRS = {
          person: 'people', organization: 'organizations', program: 'programs',
          event: 'events', concept: 'concepts', place: 'places', source: 'sources',
          meta: 'meta', misc: 'misc', page: 'pages',
        };
        let previews = null;
        let previewsPromise = null;
        let pop = null;
        let openTimer = null;
        let hideTimer = null;
        let currentLink = null;
        function loadAll() {
          if (previews) return Promise.resolve(previews);
          if (previewsPromise) return previewsPromise;
          previewsPromise = fetch('/previews.json?v=' + window.__V)
            .then((r) => (r.ok ? r.json() : null))
            .then((d) => { previews = d || {}; return previews; })
            .catch(() => { previews = {}; return previews; });
          return previewsPromise;
        }

        function ensurePop() {
          if (pop) return pop;
          pop = document.createElement('div');
          pop.className = 'hover-preview';
          pop.addEventListener('mouseenter', () => clearTimeout(hideTimer));
          pop.addEventListener('mouseleave', scheduleHide);
          document.body.appendChild(pop);
          return pop;
        }
        function slugFromHref(href) {
          if (!href) return null;
          const m = href.match(/^\/[^/]+\/([^/?#]+)\/?(#|\?|$)/);
          return m ? m[1] : null;
        }
        function esc(s) {
          return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
            { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
          ));
        }
        // Inline markdown: bold, italic, code, md links, wikilinks (display).
        // Kept in lockstep with renderInlineMd() in lib/data.ts so server-
        // rendered summaries and this client-side popover read identically.
        function inlineMd(s) {
          let h = esc(s);
          h = h.replace(/\[\[([^|\]]+?)\|([^\]]+?)\]\]/g, '$2');
          h = h.replace(/\[\[([^\]]+?)\]\]/g, '$1');
          h = h.replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
          h = h.replace(/(^|[^*\w])\*([^*\n]+?)\*(?!\*)/g, '$1<em>$2</em>');
          h = h.replace(/(^|[^_\w])_([^_\n]+?)_(?!_)/g, '$1<em>$2</em>');
          h = h.replace(/`([^`\n]+?)`/g, '<code>$1</code>');
          h = h.replace(/\[([^\]\n]+?)\]\(([^)\n]+?)\)/g, function (_m, t, u) {
            return '<a href="' + String(u).replace(/"/g, '%22') + '">' + t + '</a>';
          });
          return h;
        }
        async function load(slug) {
          const data = await loadAll();
          const hit = data && data[slug];
          if (!hit) return null;
          return { id: slug, ...hit };
        }
        function render(data, link) {
          const el = ensurePop();
          // related is a bare ID list — look up each neighbour's title/type
          // from the previews map we already loaded. Skips items that aren't
          // in the map (rare; could happen mid-rebuild when a related entity
          // is removed before its referents catch up).
          const rels = (data.related || []).slice(0, 4).map((id) => {
            const r = previews && previews[id];
            if (!r) return null;
            const dir = TYPE_DIRS[r.type] || 'pages';
            return '<a href="/' + dir + '/' + id + '/">' + esc(r.title) + '</a>';
          }).filter(Boolean).join(' · ');
          const type = data.type ? data.type.charAt(0).toUpperCase() + data.type.slice(1) : '';
          el.innerHTML =
            '<div class="hp-eyebrow">' + esc(type) +
            (data.category ? ' &middot; ' + esc(data.category) : '') + '</div>' +
            '<div class="hp-title">' + esc(data.title) + '</div>' +
            (data.summary ? '<p class="hp-summary">' + inlineMd(data.summary) + '</p>' : '') +
            (rels ? '<div class="hp-related"><span class="label">Connected</span> ' + rels + '</div>' : '');
          position(el, link);
          el.classList.add('visible');
        }
        function position(el, link) {
          const r = link.getBoundingClientRect();
          el.style.visibility = 'hidden';
          el.classList.add('visible');
          const w = el.offsetWidth || 352;
          const h = el.offsetHeight || 180;
          el.classList.remove('visible');
          el.style.visibility = '';
          let left = r.left + window.scrollX;
          const maxLeft = window.scrollX + window.innerWidth - w - 12;
          if (left > maxLeft) left = maxLeft;
          if (left < window.scrollX + 8) left = window.scrollX + 8;
          const below = r.bottom + h + 16 < window.scrollY + window.innerHeight ||
                        r.top < window.innerHeight / 2;
          const top = below ? r.bottom + window.scrollY + 6 : r.top + window.scrollY - h - 6;
          el.style.left = left + 'px';
          el.style.top = top + 'px';
        }
        function scheduleHide() {
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => { if (pop) pop.classList.remove('visible'); }, 180);
        }
        document.addEventListener('mouseover', (e) => {
          const link = e.target.closest && e.target.closest('a.wikilink:not(.unresolved)');
          if (!link || link === currentLink) return;
          currentLink = link;
          clearTimeout(openTimer);
          clearTimeout(hideTimer);
          openTimer = setTimeout(async () => {
            const slug = slugFromHref(link.getAttribute('href'));
            if (!slug) return;
            const data = await load(slug);
            if (data && link === currentLink) render(data, link);
          }, 320);
        });
        document.addEventListener('mouseout', (e) => {
          const link = e.target.closest && e.target.closest('a.wikilink');
          if (!link) return;
          if (e.relatedTarget && (
              e.relatedTarget.closest && e.relatedTarget.closest('.hover-preview')
          )) return;
          clearTimeout(openTimer);
          currentLink = null;
          scheduleHide();
        });
      })();

      // Run fn once the DOM is ready. Crucially, fires immediately if the
      // document has already advanced past `loading` by the time this inline
      // script executes — `window.addEventListener('DOMContentLoaded')` after
      // DCL has fired never runs, which was killing both header buttons.
      function onReady(fn) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fn, { once: true });
        } else {
          fn();
        }
      }

      // ---------- Mobile hamburger menu ----------
      onReady(() => {
        const toggle = document.getElementById('nav-toggle');
        const nav = document.getElementById('site-nav');
        if (!toggle || !nav) return;
        function setOpen(open) {
          nav.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.body.classList.toggle('nav-open', open);
        }
        toggle.addEventListener('click', () => {
          setOpen(!nav.classList.contains('open'));
        });
        // Close on link tap and on Escape.
        nav.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('open')) setOpen(false);
        });
      });

      // ---------- ⌘K search modal (Mac convention) ----------
      onReady(() => {
        const modal = document.getElementById('pf-modal');
        const mount = document.getElementById('pf-mount');
        const trigger = document.getElementById('search-open');
        if (!modal || !mount) return;
        let pfReady = false;

        function init() {
          if (pfReady) return;
          if (!window.PagefindUI) return;
          try {
            new window.PagefindUI({
              element: '#pf-mount',
              showImages: false,
              showSubResults: true,
              resetStyles: false,
              placeholder: 'Search the vault…',
            });
            pfReady = true;
          } catch (_) {
            // Swallow — the click listener below still works, and the modal
            // will show an empty shell rather than the whole header dying.
          }
        }

        function focusInput(retries) {
          if (retries === undefined) retries = 12;
          const input = mount.querySelector('input');
          if (input) {
            input.focus();
            try { input.select(); } catch (_) { /* ok */ }
          } else if (retries > 0) {
            setTimeout(() => focusInput(retries - 1), 40);
          }
        }
        function openModal() {
          init();
          modal.classList.add('open');
          // Force a layout flush so the input is reachable, then focus
          // synchronously within the user-gesture so iOS Safari raises
          // the soft keyboard. rAF/setTimeout here would break that chain.
          void modal.offsetHeight;
          focusInput();
        }
        function closeModal() {
          modal.classList.remove('open');
          if (trigger) trigger.focus();
        }

        // Attach the click handler FIRST, before the eager init() call —
        // so even if PagefindUI's constructor explodes, the button still
        // opens the modal.
        trigger && trigger.addEventListener('click', openModal);
        modal.addEventListener('mousedown', (e) => {
          if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', (e) => {
          if (e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (modal.classList.contains('open')) closeModal();
            else openModal();
          } else if (e.key === 'Escape' && modal.classList.contains('open')) {
            closeModal();
          }
        });

        // Eager init AFTER wiring the click — Pagefind mounts its DOM at
        // page-load so the input exists when the modal opens (avoids the
        // "can't type on first open" race).
        init();
      });
    </script>
  </body>
</html>
