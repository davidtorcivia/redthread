---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** og:type — "article" for entity pages, "profile" for people, "website" for browse pages (default). */
  ogType?: string;
  /** Optional structured-data block (JSON-LD). Entity pages pass schema.org payload. */
  jsonLd?: Record<string, unknown> | null;
  /** Set true for utility pages (e.g. /random/) we don't want crawlers indexing. */
  noindex?: boolean;
}
const {
  title,
  description,
  bodyClass,
  ogType = 'website',
  jsonLd = null,
  noindex = false,
} = Astro.props;

// Canonical URL is resolved from Astro's `site` config + the current path.
// Falls back to the relative path if site isn't set (e.g. local dev runs
// without SITE_URL exported).
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// Optional analytics snippet. Set ANALYTICS_SRC + ANALYTICS_ID in the build
// environment and a script tag gets injected into <head>. Defaults match
// Umami's convention (data-website-id="…"); override the attribute name with
// ANALYTICS_ID_ATTR for Plausible (data-domain), Fathom (data-site), etc.
const analyticsSrc = import.meta.env.ANALYTICS_SRC as string | undefined;
const analyticsId = import.meta.env.ANALYTICS_ID as string | undefined;
const analyticsIdAttr =
  (import.meta.env.ANALYTICS_ID_ATTR as string | undefined) || 'data-website-id';
const analyticsEnabled = Boolean(analyticsSrc && analyticsId);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    {/* Open Graph — used by Slack, Discord, iMessage, Facebook, etc. when
        a link to this page is pasted. */}
    <meta property="og:site_name" content="The Info Web" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter card metadata. summary (not summary_large_image) because
        we don't currently emit per-entity OG images. */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23f7f2e7'/%3E%3Ctext y='.85em' x='8' font-family='Georgia,serif' font-size='86' font-weight='600' fill='%2394322a'%3EI%3C/text%3E%3C/svg%3E" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    {/* Preload the shared adjacency map so the per-entity NetworkGraph
        widget on every entity page (and /network/, /path/) starts with
        the data already in cache. ~250KB, served compressed. */}
    <link rel="preload" as="fetch" href="/adjacency.json" crossorigin="anonymous" />

    {analyticsEnabled && (
      <script
        is:inline
        defer
        src={analyticsSrc}
        {...{ [analyticsIdAttr]: analyticsId }}
      ></script>
    )}
  </head>
  <body class={bodyClass}>
    <header class="site">
      <div class="bar">
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <span class="nav-icon" aria-hidden="true"></span>
        </button>
        <a href="/" class="brand">The Info Web</a>
        <nav id="site-nav">
          <a href="/people/">People</a>
          <a href="/organizations/">Organizations</a>
          <a href="/programs/">Programs</a>
          <a href="/events/">Events</a>
          <a href="/concepts/">Concepts</a>
          <a href="/places/">Places</a>
        </nav>
        <span class="spacer"></span>
        <button class="search-trigger" id="search-open" type="button" aria-label="Open search (Command-K)">
          <span>Search</span>
          <kbd>⌘ K</kbd>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        <a href="/" class="foot-brand">The Info Web</a>
        <nav class="foot-nav">
          <a href="/network/">Network</a>
          <a href="/path/">Path</a>
          <a href="/bridges/">Bridges</a>
          <a href="/tags/">Tags</a>
          <a href="/timeline/">Timeline</a>
          <a href="/random/">Random</a>
          <a href="/changelog/">Changelog</a>
          <a href="#top" class="to-top">↑ Top</a>
        </nav>
      </div>
    </footer>

    <div id="pf-modal" role="dialog" aria-modal="true" aria-label="Search">
      <div class="pf-shell">
        <div id="pf-mount"></div>
      </div>
    </div>

    <script is:inline>
      // ---------- Hover previews on wikilinks ----------
      (function () {
        if (!window.matchMedia('(hover: hover)').matches) return;
        const TYPE_DIRS = {
          person: 'people', organization: 'organizations', program: 'programs',
          event: 'events', concept: 'concepts', place: 'places', source: 'sources',
          meta: 'meta', misc: 'misc', page: 'pages',
        };
        let previews = null;
        let previewsPromise = null;
        let pop = null;
        let openTimer = null;
        let hideTimer = null;
        let currentLink = null;
        function loadAll() {
          if (previews) return Promise.resolve(previews);
          if (previewsPromise) return previewsPromise;
          previewsPromise = fetch('/previews.json')
            .then((r) => (r.ok ? r.json() : null))
            .then((d) => { previews = d || {}; return previews; })
            .catch(() => { previews = {}; return previews; });
          return previewsPromise;
        }

        function ensurePop() {
          if (pop) return pop;
          pop = document.createElement('div');
          pop.className = 'hover-preview';
          pop.addEventListener('mouseenter', () => clearTimeout(hideTimer));
          pop.addEventListener('mouseleave', scheduleHide);
          document.body.appendChild(pop);
          return pop;
        }
        function slugFromHref(href) {
          if (!href) return null;
          const m = href.match(/^\/[^/]+\/([^/?#]+)\/?(#|\?|$)/);
          return m ? m[1] : null;
        }
        function esc(s) {
          return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
            { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
          ));
        }
        async function load(slug) {
          const data = await loadAll();
          const hit = data && data[slug];
          if (!hit) return null;
          return { id: slug, ...hit };
        }
        function render(data, link) {
          const el = ensurePop();
          const rels = (data.related || []).slice(0, 4).map((r) => {
            const dir = TYPE_DIRS[r.type] || 'pages';
            return '<a href="/' + dir + '/' + r.id + '/">' + esc(r.title) + '</a>';
          }).join(' · ');
          const type = data.type ? data.type.charAt(0).toUpperCase() + data.type.slice(1) : '';
          el.innerHTML =
            '<div class="hp-eyebrow">' + esc(type) +
            (data.category ? ' &middot; ' + esc(data.category) : '') + '</div>' +
            '<div class="hp-title">' + esc(data.title) + '</div>' +
            (data.summary ? '<p class="hp-summary">' + esc(data.summary) + '</p>' : '') +
            (rels ? '<div class="hp-related"><span class="label">Connected</span> ' + rels + '</div>' : '');
          position(el, link);
          el.classList.add('visible');
        }
        function position(el, link) {
          const r = link.getBoundingClientRect();
          el.style.visibility = 'hidden';
          el.classList.add('visible');
          const w = el.offsetWidth || 352;
          const h = el.offsetHeight || 180;
          el.classList.remove('visible');
          el.style.visibility = '';
          let left = r.left + window.scrollX;
          const maxLeft = window.scrollX + window.innerWidth - w - 12;
          if (left > maxLeft) left = maxLeft;
          if (left < window.scrollX + 8) left = window.scrollX + 8;
          const below = r.bottom + h + 16 < window.scrollY + window.innerHeight ||
                        r.top < window.innerHeight / 2;
          const top = below ? r.bottom + window.scrollY + 6 : r.top + window.scrollY - h - 6;
          el.style.left = left + 'px';
          el.style.top = top + 'px';
        }
        function scheduleHide() {
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => { if (pop) pop.classList.remove('visible'); }, 180);
        }
        document.addEventListener('mouseover', (e) => {
          const link = e.target.closest && e.target.closest('a.wikilink:not(.unresolved)');
          if (!link || link === currentLink) return;
          currentLink = link;
          clearTimeout(openTimer);
          clearTimeout(hideTimer);
          openTimer = setTimeout(async () => {
            const slug = slugFromHref(link.getAttribute('href'));
            if (!slug) return;
            const data = await load(slug);
            if (data && link === currentLink) render(data, link);
          }, 320);
        });
        document.addEventListener('mouseout', (e) => {
          const link = e.target.closest && e.target.closest('a.wikilink');
          if (!link) return;
          if (e.relatedTarget && (
              e.relatedTarget.closest && e.relatedTarget.closest('.hover-preview')
          )) return;
          clearTimeout(openTimer);
          currentLink = null;
          scheduleHide();
        });
      })();

      // ---------- Mobile hamburger menu ----------
      window.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('nav-toggle');
        const nav = document.getElementById('site-nav');
        if (!toggle || !nav) return;
        function setOpen(open) {
          nav.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.body.classList.toggle('nav-open', open);
        }
        toggle.addEventListener('click', () => {
          setOpen(!nav.classList.contains('open'));
        });
        // Close on link tap and on Escape.
        nav.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('open')) setOpen(false);
        });
      });

      // ---------- ⌘K search modal (Mac convention) ----------
      window.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('pf-modal');
        const mount = document.getElementById('pf-mount');
        const trigger = document.getElementById('search-open');
        let pfReady = false;

        function init() {
          if (pfReady) return;
          if (!window.PagefindUI) return;
          new window.PagefindUI({
            element: '#pf-mount',
            showImages: false,
            showSubResults: true,
            resetStyles: false,
            placeholder: 'Search the vault…',
          });
          pfReady = true;
        }
        // Eager init: Pagefind mounts its DOM at page-load so the input
        // exists before the modal is opened (avoids the "can't type" race).
        init();

        function focusInput(retries) {
          if (retries === undefined) retries = 12;
          const input = mount.querySelector('input');
          if (input) {
            input.focus();
            try { input.select(); } catch (_) { /* ok */ }
          } else if (retries > 0) {
            setTimeout(() => focusInput(retries - 1), 40);
          }
        }
        function openModal() {
          init();
          modal.classList.add('open');
          requestAnimationFrame(() => focusInput());
        }
        function closeModal() {
          modal.classList.remove('open');
          if (trigger) trigger.focus();
        }
        trigger && trigger.addEventListener('click', openModal);
        modal && modal.addEventListener('mousedown', (e) => {
          if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', (e) => {
          if (e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (modal.classList.contains('open')) closeModal();
            else openModal();
          } else if (e.key === 'Escape' && modal.classList.contains('open')) {
            closeModal();
          }
        });
      });
    </script>
  </body>
</html>
