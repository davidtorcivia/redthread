---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/statement.css';
import '../styles/graph.css';
import '../styles/path.css';
import { CARD_TEMPLATE_HASH } from '../lib/og-card';
import { absUrl, ANALYTICS, BUILD_ID as V, pageTitle, SITE_DESCRIPTION, SITE_TITLE } from '../lib/site.ts';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** "article" for entries, "profile" for people, "website" (default) for everything else. */
  ogType?: string;
  /** Page-specific schema.org data. */
  jsonLd?: Record<string, unknown> | null;
  noindex?: boolean;
  /** Site path of this page's social card. Defaults to the site-wide card. */
  ogImage?: string;
  /** Preload /adjacency.json. Set only on pages that fetch it. */
  preloadAdjacency?: boolean;
  /** Path of the page's markdown twin, advertised to LLM tools. */
  alternateMd?: string;
  /** Breadcrumb trail after "Home", root first. */
  breadcrumbs?: { name: string; item: string }[];
}
const {
  title: pageName,
  description,
  bodyClass,
  ogType = 'website',
  jsonLd = null,
  noindex = false,
  ogImage = '/og/site.png',
  preloadAdjacency = false,
  alternateMd,
  breadcrumbs,
} = Astro.props;

const title = pageTitle(pageName);
const canonical = absUrl(Astro.url.pathname);
// Versioned so social caches refetch cards when the template changes.
const ogImageUrl = absUrl(`${ogImage}?v=${CARD_TEMPLATE_HASH}`);
// JSON.stringify leaves '<' alone, so a '</script>' inside an entry title would end the tag.
const jsonForScript = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const favicon = 'data:image/svg+xml,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='#ff4a1c'/><text y='.85em' x='8' font-family='Georgia,serif' font-size='86' font-weight='600' fill='#0d0d0d'>${SITE_TITLE.charAt(0).replace(/[<&]/g, '')}</text></svg>`);

const siteHome = absUrl('/');
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteHome}#website`,
      url: siteHome,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: 'en-US',
      publisher: { '@id': `${siteHome}#org` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteHome}#org`,
      name: SITE_TITLE,
      url: siteHome,
      logo: absUrl('/og/site.png'),
    },
  ],
};
const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', item: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: absUrl(b.item),
      })),
    }
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Theme must run before paint, including behind Cloudflare Rocket Loader. */}
    <script is:inline data-cfasync="false">
      {
        let saved = null;
        try { saved = localStorage.getItem('iw-theme'); } catch {}
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light'
          ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    {/* Paint the page canvas before the external stylesheet arrives. */}
    <style is:inline>
      :root { color-scheme: light; background: #fff; }
      :root[data-theme="dark"] { color-scheme: dark; background: #0e0e0e; }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title={`${SITE_TITLE}: Changelog`} href="/feed.xml" />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    {jsonLd && (
      <script type="application/ld+json" set:html={jsonForScript(jsonLd)} is:inline />
    )}
    <script type="application/ld+json" set:html={jsonForScript(siteSchema)} is:inline />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={jsonForScript(breadcrumbSchema)} is:inline />
    )}

    <link rel="icon" href={favicon} />
    <link href="/search-index/pagefind-ui.css" rel="stylesheet" />
    {/* Deferred scripts run in order, so PagefindUI exists before the module script below. */}
    <script src="/search-index/pagefind-ui.js" defer is:inline></script>
    {preloadAdjacency && (
      <link rel="preload" as="fetch" href={`/adjacency.json?v=${V}`} crossorigin="anonymous" />
    )}
    {alternateMd && (
      <link rel="alternate" type="text/markdown" href={alternateMd} title="Source markdown" />
    )}
    {/* Build version for the ?v= cache-buster on client fetches. */}
    <script is:inline define:vars={{ V }}>window.__V = V;</script>

    {ANALYTICS && <script is:inline defer src={ANALYTICS.src} {...{ [ANALYTICS.attr]: ANALYTICS.id }}></script>}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site" id="top">
      <div class="bar">
        <a href="/" class="brand">{SITE_TITLE}</a>
        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">Menu</button>
        <nav id="site-nav" aria-label="Main navigation">
          <a href="/people/">People</a>
          <a href="/organizations/">Organizations</a>
          <a href="/programs/">Programs</a>
          <a href="/events/">Events</a>
          <a href="/concepts/">Concepts</a>
          <a href="/places/">Places</a>
          <a href="/network/">Network</a>
          <button class="search-trigger" id="search-open" type="button" aria-label="Open search" disabled>Search</button>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch theme" title="Switch theme">
            <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" /></svg>
            <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        <a href="/random/" class="foot-brand">Random entry</a>
        <nav class="foot-nav">
          <a href="/network/">Network</a>
          <a href="/path/">Path</a>
          <a href="/bridges/">Bridges</a>
          <a href="/clusters/">Clusters</a>
          <a href="/tags/">Tags</a>
          <a href="/sources/">Sources</a>
          <a href="/timeline/">Timeline</a>
          <a href="/random/">Random</a>
          <a href="/changelog/">Changelog</a>
          <a href="/unresolved/">Unresolved</a>
          <a href="#top" class="to-top">↑ Top</a>
        </nav>
      </div>
    </footer>

    <div id="pf-modal" role="dialog" aria-modal="true" aria-label="Search">
      <div class="pf-shell">
        <div class="pf-header"><span>Search</span><button type="button" id="pf-close" aria-label="Close search">Close</button></div>
        <p id="pf-error" role="status" hidden>Search could not load. <button type="button" id="pf-reload">Reload the page</button> to try again.</p>
        <div id="pf-mount"></div>
      </div>
    </div>

    {/* Bundled into one cached module shared by every page. Modules are deferred, so the DOM is ready. */}
    <script>
      import { loadAdjacency } from '../scripts/adjacency';
      import { entityHref, TYPE_LABELS } from '../scripts/entity-types';
      import { escapeHtml as esc, renderInlineMd } from '../lib/inline-md';

      // Hover previews for wikilinks and [data-preview] links, from previews.json.
      if (matchMedia('(hover: hover)').matches) {
        let previews = {};
        let previewsP = null;
        let pop = null;
        let openTimer = null;
        let hideTimer = null;
        let currentLink = null;
        const loadPreviews = () => previewsP ??= fetch('/previews.json?v=' + window.__V)
          .then((r) => (r.ok ? r.json() : null))
          .catch(() => null)
          .then((d) => (previews = d || {}));
        const slugFromHref = (href) => href?.match(/^\/[^/]+\/([^/?#]+)\/?(#|\?|$)/)?.[1] ?? null;
        const scheduleHide = () => {
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => pop?.classList.remove('visible'), 180);
        };
        const ensurePop = () => {
          if (pop) return pop;
          pop = document.createElement('div');
          pop.className = 'hover-preview';
          pop.addEventListener('mouseenter', () => clearTimeout(hideTimer));
          pop.addEventListener('mouseleave', scheduleHide);
          document.body.appendChild(pop);
          return pop;
        };
        // Below the link if it fits (or has more room), clamped to the viewport.
        const position = (el, link) => {
          const r = link.getBoundingClientRect();
          const wasVisible = el.classList.contains('visible');
          el.style.maxHeight = '';
          el.style.visibility = 'hidden';
          el.classList.add('visible');
          const w = el.offsetWidth || 352;
          const margin = 8;
          const gap = 6;
          const left = Math.max(margin, Math.min(r.left, window.innerWidth - w - margin));
          const roomBelow = window.innerHeight - r.bottom - gap - margin;
          const roomAbove = r.top - gap - margin;
          const below = roomBelow >= el.offsetHeight || roomBelow >= roomAbove;
          el.style.maxHeight = `${Math.max(60, below ? roomBelow : roomAbove)}px`;
          const h = el.offsetHeight || 180;
          if (!wasVisible) el.classList.remove('visible');
          el.style.visibility = '';
          const preferredTop = below ? r.bottom + gap : r.top - h - gap;
          el.style.left = left + 'px';
          el.style.top = Math.max(margin, Math.min(preferredTop, window.innerHeight - h - margin)) + 'px';
        };
        const render = (data, link) => {
          const el = ensurePop();
          // `related` holds ids; neighbours missing from previews.json are skipped.
          const rels = (data.related || []).slice(0, 4).map((id) => {
            const r = previews[id];
            return r ? '<a href="' + esc(entityHref(r.type, id)) + '">' + esc(r.title) + '</a>' : null;
          }).filter(Boolean).join(' · ');
          el.innerHTML =
            '<div class="hp-eyebrow">' + esc(TYPE_LABELS[data.type]) +
            (data.category ? ' &middot; ' + esc(data.category) : '') + '</div>' +
            '<div class="hp-title">' + esc(data.title) + '</div>' +
            (data.summary ? '<p class="hp-summary">' + renderInlineMd(data.summary) + '</p>' : '') +
            (rels ? '<div class="hp-related"><span class="label">Connected</span> ' + rels + '</div>' : '');
          position(el, link);
          el.classList.add('visible');
        };
        const PREVIEW_SEL = 'a.wikilink:not(.unresolved), a[data-preview]';
        document.addEventListener('mouseover', (e) => {
          const link = e.target.closest?.(PREVIEW_SEL);
          if (!link || link === currentLink) return;
          currentLink = link;
          clearTimeout(openTimer);
          clearTimeout(hideTimer);
          openTimer = setTimeout(async () => {
            const slug = slugFromHref(link.getAttribute('href'));
            if (!slug) return;
            const data = (await loadPreviews())[slug];
            if (data && link === currentLink) render(data, link);
          }, 320);
        });
        document.addEventListener('mouseout', (e) => {
          if (!e.target.closest?.(PREVIEW_SEL)) return;
          if (e.relatedTarget?.closest?.('.hover-preview')) return;
          clearTimeout(openTimer);
          currentLink = null;
          scheduleHide();
        });
        const reposition = () => {
          if (!pop?.classList.contains('visible') || !currentLink) return;
          const box = currentLink.getBoundingClientRect();
          if (box.bottom < 0 || box.top > window.innerHeight) scheduleHide();
          else position(pop, currentLink);
        };
        window.addEventListener('scroll', reposition, { passive: true });
        window.addEventListener('resize', reposition);
      }

      // Theme toggle. A saved choice beats the OS setting; canvas graphs listen for themechange.
      {
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        const buttons = document.querySelectorAll('[data-theme-toggle]');
        const setTheme = (theme) => {
          root.dataset.theme = theme;
          const label = 'Switch to ' + (theme === 'dark' ? 'light' : 'dark') + ' theme';
          buttons.forEach((button) => {
            button.setAttribute('aria-label', label);
            button.setAttribute('title', label);
          });
          window.dispatchEvent(new Event('themechange'));
        };
        setTheme(root.dataset.theme || (system.matches ? 'dark' : 'light'));
        buttons.forEach((button) => button.addEventListener('click', () => {
          const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('iw-theme', theme); } catch {}
          setTheme(theme);
        }));
        system.addEventListener('change', () => {
          let saved;
          try { saved = localStorage.getItem('iw-theme'); } catch {}
          if (saved !== 'dark' && saved !== 'light') setTheme(system.matches ? 'dark' : 'light');
        });
      }

      // Mobile menu.
      const navToggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      function setMenuOpen(open) {
        nav.classList.toggle('open', open);
        navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        navToggle.textContent = open ? 'Close' : 'Menu';
        document.querySelector('main').inert = open;
        document.querySelector('footer.site').inert = open;
        document.body.classList.toggle('nav-open', open);
      }
      matchMedia('(min-width: 1101px)').addEventListener('change', (e) => { if (e.matches) setMenuOpen(false); });
      navToggle.addEventListener('click', () => setMenuOpen(!nav.classList.contains('open')));
      nav.addEventListener('click', (e) => {
        if (e.target.closest('a, .search-trigger')) setMenuOpen(false);
      }, true);
      document.addEventListener('keydown', (e) => {
        if (!nav.classList.contains('open')) return;
        if (e.key === 'Escape') { setMenuOpen(false); navToggle.focus(); }
        if (e.key === 'Tab') {
          // Keep focus cycling between the toggle and the last menu item.
          const last = nav.querySelector('[data-theme-toggle]');
          if (e.shiftKey && document.activeElement === navToggle) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); navToggle.focus(); }
        }
      });

      // Search modal (Pagefind), opened with the header button or Cmd/Ctrl+K.
      {
        const modal = document.getElementById('pf-modal');
        const mount = document.getElementById('pf-mount');
        const trigger = document.getElementById('search-open');
        const loadError = document.getElementById('pf-error');
        let pfReady = false;
        // Whatever opened the modal gets focus back on close.
        let opener = null;
        document.getElementById('pf-reload').addEventListener('click', () => location.reload());
        document.getElementById('pf-close').addEventListener('click', closeModal);

        function init() {
          if (pfReady) return;
          if (!window.PagefindUI) { loadError.hidden = false; return; }
          try {
            new window.PagefindUI({
              element: '#pf-mount',
              bundlePath: '/search-index/',
              showImages: false,
              showSubResults: true,
              resetStyles: false,
              placeholder: 'Search the vault…',
            });
            pfReady = true;
            loadError.hidden = true;
          } catch {
            loadError.hidden = false;
          }
        }
        // Pagefind mounts its input asynchronously; poll briefly for it.
        function withInput(fn, retries = 12) {
          const input = mount.querySelector('input');
          if (input) fn(input);
          else if (retries > 0) setTimeout(() => withInput(fn, retries - 1), 40);
        }

        // Pagefind ranks by term frequency with no title boost, so an entry's own page can
        // sink below pages that repeat its name. List title and alias matches above the results.
        let quick = null;
        let namesP = null;
        const loadNames = () => namesP ??= loadAdjacency()
          .then((d) => d.ids.map((id, i) => ({
            title: d.titles[i],
            type: d.types[i],
            href: entityHref(d.types[i], id),
            keys: [d.titles[i], ...(d.aliases?.[String(i)] || [])].map((k) => k.toLowerCase()),
          })))
          .catch(() => []);
        // 0 exact, 1 prefix, 2 word prefix, 3 substring, 9 no match.
        const quickRank = (n, q) => Math.min(...n.keys.map((k) =>
          k === q ? 0 : k.startsWith(q) ? 1 : k.includes(' ' + q) ? 2 : k.includes(q) ? 3 : 9));
        function renderQuick(names, q) {
          quick.replaceChildren();
          const top = q.length < 2 ? [] : names
            .map((n) => [quickRank(n, q), n])
            .filter(([s]) => s < 9)
            .sort((a, b) => a[0] - b[0] || a[1].title.length - b[1].title.length)
            .slice(0, 8);
          quick.hidden = !top.length;
          if (!top.length) return;
          const label = document.createElement('div');
          label.className = 'pf-quick-label';
          label.textContent = 'Entries';
          quick.appendChild(label);
          for (const [, n] of top) {
            const a = document.createElement('a');
            a.className = 'pf-quick-item type-' + n.type;
            a.href = n.href;
            const t = document.createElement('span');
            t.className = 'pf-quick-type';
            t.textContent = TYPE_LABELS[n.type] || n.type;
            a.append(t, n.title);
            quick.appendChild(a);
          }
        }
        function wireQuick(retries = 12) {
          if (quick) return;
          const input = mount.querySelector('input');
          const drawer = mount.querySelector('.pagefind-ui__drawer');
          if (!input || !drawer) {
            if (retries > 0) setTimeout(() => wireQuick(retries - 1), 40);
            return;
          }
          quick = document.createElement('div');
          quick.id = 'pf-quick';
          quick.hidden = true;
          drawer.parentNode.insertBefore(quick, drawer);
          const query = () => input.value.trim().toLowerCase();
          input.addEventListener('input', () => {
            if (!query()) renderQuick([], '');
            loadNames().then((names) => renderQuick(names, query()));
          });
          mount.querySelector('.pagefind-ui__search-clear')?.addEventListener('click', () => renderQuick([], ''));
          // Arrow keys move between the input and the quick matches.
          input.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowDown' || quick.hidden) return;
            const first = quick.querySelector('.pf-quick-item');
            if (first) { e.preventDefault(); first.focus(); }
          });
          quick.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
            const items = [...quick.querySelectorAll('.pf-quick-item')];
            const i = items.indexOf(document.activeElement);
            if (i < 0) return;
            e.preventDefault();
            if (e.key === 'ArrowDown') (items[i + 1] || items[i]).focus();
            else if (i === 0) input.focus();
            else items[i - 1].focus();
          });
        }

        // An unresolved wikilink has no page; clicking it searches for the name instead.
        document.addEventListener('click', (e) => {
          const a = e.target.closest?.('a.wikilink.unresolved');
          if (!a) return;
          e.preventDefault();
          openModal();
          opener = a;
          withInput((input) => {
            input.value = a.dataset.target || a.textContent.trim();
            input.dispatchEvent(new Event('input', { bubbles: true }));
          });
        });
        // Middle-click would open a useless "#" tab.
        document.addEventListener('auxclick', (e) => {
          if (e.target.closest?.('a.wikilink.unresolved')) e.preventDefault();
        });

        // Inert background keeps Tab and assistive tech inside the dialog.
        function setBackgroundInert(on) {
          for (const sel of ['header.site', 'main', 'footer.site']) document.querySelector(sel)?.toggleAttribute('inert', on);
        }
        function openModal() {
          setMenuOpen(false);
          init();
          wireQuick();
          modal.classList.add('open');
          setBackgroundInert(true);
          // Focus synchronously inside the user gesture so iOS raises the keyboard;
          // the forced layout makes the input focusable.
          void modal.offsetHeight;
          withInput((input) => {
            input.focus();
            input.select();
          });
        }
        function closeModal() {
          modal.classList.remove('open');
          setBackgroundInert(false);
          const back = opener && document.contains(opener) ? opener : trigger;
          opener = null;
          if (back.getClientRects().length) back.focus();
          else navToggle.focus();
        }
        // Trap Tab inside the dialog.
        modal.addEventListener('keydown', (e) => {
          if (e.key !== 'Tab' || !modal.classList.contains('open')) return;
          const focusables = [...modal.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )].filter((el) => el.getClientRects().length && getComputedStyle(el).visibility !== 'hidden');
          if (!focusables.length) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });
        modal.addEventListener('mousedown', (e) => {
          if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (modal.classList.contains('open')) closeModal();
            else openModal();
          } else if (e.key === 'Escape' && modal.classList.contains('open')) {
            closeModal();
          }
        });

        // Wire the button before init() so it still opens the modal if Pagefind throws.
        trigger.addEventListener('click', openModal);
        trigger.disabled = false;
        // Mount Pagefind now so its input exists on first open.
        init();
      }
    </script>
  </body>
</html>
