---
import GraphTools from './GraphTools.astro';
import GraphCaption from './GraphCaption.astro';
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<section class="entity-network" data-focal-id={id} data-pagefind-ignore>
  <h2 class="section-heading">Local network</h2>
  <p class="net-blurb">Search or select an entry to see how it connects to {title}.</p>
  <GraphTools id={id} />

  <div class="net-shell entity-net-shell">
    <canvas
      class="net-canvas"
      role="img"
      aria-label={`Network diagram of the connections around ${title}. Search or select an entry to explore its connections.`}
    ></canvas>
    {/* The same neighbors are listed as real links in the Connected and
        Mentioned-in sections of this page, which are keyboard/SR accessible. */}
    <p class="sr-only">
      An interactive diagram of {title}'s connections, drawn on a canvas and explored
      with a pointer. The same connections are listed as links in the Connected and
      Mentioned-in sections below.
    </p>

    <div class="net-status" hidden></div>

    <div class="graph-selection net-selection" hidden>
      <div class="gs-row">
        <span class="gs-eyebrow"></span>
        <span class="gs-title"></span>
      </div>
      <div class="gs-meta"><span class="gs-count"></span> mentions across the vault</div>
      <div class="gs-bridge" hidden>Bridge entity (rank <span class="gs-bridge-rank"></span>)</div>
      <div class="gs-hub" hidden>Hub entity (rank <span class="gs-hub-rank"></span>)</div>
      <div class="gs-summary" hidden></div>
      <div class="gs-actions">
        <a class="gs-go" href="#">Go to page &rarr;</a>
        <button class="gs-deselect" type="button">Clear</button>
      </div>
    </div>

    <div class="graph-tooltip net-tooltip" hidden></div>
  </div>

  <GraphCaption />

  {/* Same key as the full /network/ graph — node colour/size, edge kind,
      bridge ring. Native <details>, collapsed by default. */}
  <details class="net-legend">
    <summary>How to read the graph</summary>
    <div class="net-legend-body">
      <div class="nl-group">
        <span class="nl-group-label">Colour shows the entry type or cluster</span>
        <ul class="nl-types">
          <li><span class="nl-dot t-person"></span>People</li>
          <li><span class="nl-dot t-organization"></span>Organizations</li>
          <li><span class="nl-dot t-program"></span>Programs</li>
          <li><span class="nl-dot t-event"></span>Events</li>
          <li><span class="nl-dot t-concept"></span>Concepts</li>
          <li><span class="nl-dot t-place"></span>Places</li>
        </ul>
      </div>
      <div class="nl-group">
        <span class="nl-group-label">Node size</span>
        <p class="nl-row">
          <span class="nl-dot nl-dot-sm"></span><span class="nl-dot nl-dot-lg"></span>
          Larger = more mentions across the vault.
        </p>
      </div>
      <div class="nl-group">
        <span class="nl-group-label">Connections</span>
        <p class="nl-row"><span class="nl-line"></span> A link from one entry to another.</p>
        <p class="nl-row"><span class="nl-line dashed"></span> A name mentioned in an entry without a direct link. Toggle these with “Inferred”.</p>
      </div>
      <div class="nl-group">
        <span class="nl-group-label">Highlights</span>
        <p class="nl-row"><span class="nl-ring gold"></span> Gold rings mark entries mentioned across several clusters.</p>
        <p class="nl-row"><span class="nl-ring accent"></span> Orange rings mark your selection.</p>
      </div>
    </div>
  </details>
</section>

<script>
  import { GraphEngine, nodeFromAdjacency, loadAdjacency } from '../scripts/graph-canvas';
  /**
   * Per-entity local network: the focal entity plus its 1-hop neighbours
   * (2-hop on demand), rendered by the shared engine in scripts/graph-canvas.
   * This file only builds the neighbourhood, supplies the small-graph
   * layouts and wires the 2-hop toggle.
   */
  (function () {
    const section = document.querySelector('.entity-network');
    if (!section) return;
    const focalId = section.dataset.focalId;
    const status = section.querySelector('.net-status');

    let adjacencyData = null;
    let focalIdx = -1;
    let twoHop = false;
    let initStarted = false;
    /** Positions from the last Force pass; the Force slider rescales
     *  these without re-running the simulation. */
    let cachedForcePositions = null;

    const engine = new GraphEngine(section, {
      profile: 'entity',
      showImplicit: true,
      layouts: [
        { key: 'force', label: 'Force', apply: applyForceLayout },
        { key: 'hierarchy', label: 'Hierarchy', apply: applyHierarchyLayout },
        { key: 'concentric', label: 'Concentric', apply: applyConcentricLayout },
        { key: 'circle', label: 'Circle', apply: applyCircleLayout },
      ],
      onForceSlider(mult, prev, g) {
        if (!cachedForcePositions) return;
        for (let i = 0; i < g.nodes.length; i++) {
          g.nodes[i].x = cachedForcePositions[i][0] * mult;
          g.nodes[i].y = cachedForcePositions[i][1] * mult;
        }
        const ratio = mult / prev;
        const { W, H } = g.canvasSize();
        g.view.tx = W / 2 * (1 - ratio) + g.view.tx * ratio;
        g.view.ty = H / 2 * (1 - ratio) + g.view.ty * ratio;
        g.requestDraw();
      },
    });

    // Lazy init on viewport intersection.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { init(); io.disconnect(); break; }
      }
    }, { rootMargin: '300px' });
    io.observe(section);

    async function init() {
      if (initStarted) return;
      initStarted = true;
      status.textContent = 'Loading network…';
      status.removeAttribute('hidden');
      try {
        adjacencyData = await loadAdjacency();
      } catch (err) {
        status.textContent = 'Failed to load network.';
        console.error('[entity-net]', err);
        return;
      }
      focalIdx = adjacencyData.ids.indexOf(focalId);
      if (focalIdx < 0) {
        status.textContent = 'This entity is not in the network.';
        return;
      }
      engine.communityLabels = adjacencyData.communityLabels || [];
      buildNeighborhood();
      status.setAttribute('hidden', '');
      engine.resize();
      engine.applyLayout();
      engine.wire();
      wireTwoHop();


    }

    // BFS from the focal node to depth 1 or 2, capped. Uncapped, the 2-hop
    // ball had a median of 831 nodes (the United States alone has 650
    // neighbours): never expand through a hub, take only the most-mentioned
    // neighbours per node, and stop at MAX_NODES. With 2-hop on, the first
    // ring is held to 120 so the second ring has room.
    function buildNeighborhood() {
      const maxDepth = twoHop ? 2 : 1;
      const adj = adjacencyData.adj;
      const mentions = adjacencyData.mentions;
      const HUB_DEGREE = 60;
      const PER_NODE_2HOP = 8;
      const MAX_NODES = 250;
      const FIRST_RING = twoHop ? 120 : MAX_NODES;
      const byMentions = (a, b) => (mentions[b] || 0) - (mentions[a] || 0);
      const depth = new Map();
      depth.set(focalIdx, 0);
      const queue = [focalIdx];
      let head = 0;
      while (head < queue.length && depth.size < MAX_NODES) {
        const v = queue[head++];
        const d = depth.get(v);
        if (d >= maxDepth) continue;
        if (d > 0 && adj[v].length > HUB_DEGREE) continue;
        const neigh = adj[v].slice().sort(byMentions).slice(0, d === 0 ? FIRST_RING : PER_NODE_2HOP);
        for (const w of neigh) {
          if (depth.has(w)) continue;
          if (depth.size >= MAX_NODES) break;
          depth.set(w, d + 1);
          queue.push(w);
        }
      }
      const localIdx = new Map();
      const nodes = [];
      for (const [globalIdx, hop] of depth) {
        localIdx.set(globalIdx, nodes.length);
        // sqrt scaling: at small N each node gets more visual weight than
        // the log scaling used on /network/.
        const size = Math.min(15, 5 + Math.log2(1 + (mentions[globalIdx] || 0)) * 1.1);
        const n = nodeFromAdjacency(adjacencyData, globalIdx, size);
        n.hop = hop;
        n.isFocal = globalIdx === focalIdx;
        if (n.isFocal) n.size = 22;
        nodes.push(n);
      }
      const edges = [];
      const pairToIdx = new Map();
      for (const [ga, a] of localIdx) {
        for (const gb of adj[ga]) {
          if (gb <= ga) continue;
          const b = localIdx.get(gb);
          if (b == null) continue;
          pairToIdx.set(ga * 100000 + gb, edges.length);
          edges.push([a, b]);
        }
      }
      const implicit = new Set();
      for (const [ga, gb] of adjacencyData.implicitPairs || []) {
        const idx = pairToIdx.get(ga < gb ? ga * 100000 + gb : gb * 100000 + ga);
        if (idx != null) implicit.add(idx);
      }
      engine.setGraph(nodes, edges, implicit);
    }

    function wireTwoHop() {
      const btn = section.querySelector('.net-twohop');
      if (!btn) return;
      btn.addEventListener('click', () => {
        twoHop = !twoHop;
        btn.setAttribute('aria-pressed', twoHop ? 'true' : 'false');
        btn.textContent = twoHop ? '− 2‑hop' : '+ 2‑hop';
        const keep = engine.selectedIds();
        buildNeighborhood();
        engine.restoreSelection(keep);
        engine.applyLayout();
      });
    }

    // --- Layouts (operate on engine.nodes / engine.edges) ----------------
    function applyConcentricLayout(g) {
      const byHop = new Map();
      g.nodes.forEach((n, i) => {
        if (!byHop.has(n.hop)) byHop.set(n.hop, []);
        byHop.get(n.hop).push(i);
      });
      const radii = { 0: 0, 1: 220, 2: 440 };
      for (const [hop, arr] of byHop) {
        if (hop === 0) { for (const i of arr) { g.nodes[i].x = 0; g.nodes[i].y = 0; } continue; }
        arr.sort((a, b) => g.nodes[b].count - g.nodes[a].count || g.nodes[a].title.localeCompare(g.nodes[b].title));
        const r = radii[hop] ?? (220 + hop * 220);
        arr.forEach((idx, k) => {
          const angle = (k / arr.length) * 2 * Math.PI - Math.PI / 2;
          g.nodes[idx].x = Math.cos(angle) * r;
          g.nodes[idx].y = Math.sin(angle) * r;
        });
      }
    }
    function applyCircleLayout(g) {
      const others = g.nodes.map((_, i) => i).filter((i) => !g.nodes[i].isFocal);
      others.sort((a, b) => g.nodes[b].count - g.nodes[a].count);
      const radius = Math.max(220, g.nodes.length * 11);
      for (const n of g.nodes) if (n.isFocal) { n.x = 0; n.y = 0; }
      others.forEach((idx, k) => {
        const angle = (k / others.length) * 2 * Math.PI - Math.PI / 2;
        g.nodes[idx].x = Math.cos(angle) * radius;
        g.nodes[idx].y = Math.sin(angle) * radius;
      });
    }
    function applyHierarchyLayout(g) {
      // BFS layers stack downward; within a layer, high-mention nodes sit
      // toward the centreline.
      const layers = new Map();
      g.nodes.forEach((n, i) => {
        if (!layers.has(n.hop)) layers.set(n.hop, []);
        layers.get(n.hop).push(i);
      });
      for (const [d, arr] of layers) {
        arr.sort((a, b) => g.nodes[b].count - g.nodes[a].count);
        arr.forEach((idx, k) => {
          const sign = k % 2 === 0 ? 1 : -1;
          g.nodes[idx].x = Math.ceil(k / 2) * sign * 160;
          g.nodes[idx].y = d * 220;
        });
      }
    }
    function applyForceLayout(g) {
      // Small Fruchterman-Reingold pass, focal pinned at the origin.
      const nodes = g.nodes, n = nodes.length;
      const k = Math.sqrt((1100 * 700) / Math.max(1, n));
      for (const node of nodes) {
        if (Math.abs(node.x) < 1 && Math.abs(node.y) < 1) {
          const index = nodes.indexOf(node);
          node.x = Math.cos(index * 2.399963) * (30 + Math.sqrt(index) * 20);
          node.y = Math.sin(index * 2.399963) * (30 + Math.sqrt(index) * 20);
        }
      }
      let temp = 50;
      for (let it = 0; it < 80; it++) {
        const disp = nodes.map(() => ({ x: 0, y: 0 }));
        for (let i = 0; i < n; i++) {
          for (let j = i + 1; j < n; j++) {
            const dx = nodes[i].x - nodes[j].x, dy = nodes[i].y - nodes[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy) || 0.01;
            const f = (k * k) / dist;
            disp[i].x += (dx / dist) * f; disp[i].y += (dy / dist) * f;
            disp[j].x -= (dx / dist) * f; disp[j].y -= (dy / dist) * f;
          }
        }
        for (const [a, b] of g.edges) {
          const dx = nodes[a].x - nodes[b].x, dy = nodes[a].y - nodes[b].y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 0.01;
          const f = (dist * dist) / k;
          disp[a].x -= (dx / dist) * f; disp[a].y -= (dy / dist) * f;
          disp[b].x += (dx / dist) * f; disp[b].y += (dy / dist) * f;
        }
        for (let i = 0; i < n; i++) {
          if (nodes[i].isFocal) { nodes[i].x = 0; nodes[i].y = 0; continue; }
          const d = Math.sqrt(disp[i].x * disp[i].x + disp[i].y * disp[i].y) || 0.01;
          const lim = Math.min(d, temp);
          nodes[i].x += (disp[i].x / d) * lim;
          nodes[i].y += (disp[i].y / d) * lim;
        }
        temp *= 0.95;
      }
      cachedForcePositions = nodes.map((nd) => [nd.x, nd.y]);
      if (g.forceMult !== 1.0) {
        for (let i = 0; i < n; i++) {
          nodes[i].x = cachedForcePositions[i][0] * g.forceMult;
          nodes[i].y = cachedForcePositions[i][1] * g.forceMult;
        }
      }
    }
  })();
</script>
