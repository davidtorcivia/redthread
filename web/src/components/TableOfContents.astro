---
import type { TocEntry } from '../lib/types.ts';

interface Props {
  entries: TocEntry[];
}
const { entries } = Astro.props;
---
{entries.length >= 2 && (
  <aside class="entity-toc" aria-label="Table of contents">
    <details class="toc-disclosure" open>
      <summary><span>On this page</span><span class="toc-count">{entries.length} sections</span><svg class="toc-toggle" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg></summary>
    <ol class="toc-list">
      {entries.map((e) => (
        <li class={`toc-item toc-l${e.level}`} data-toc-id={e.id}>
          <a href={`#${e.id}`}>{e.text}</a>
        </li>
      ))}
    </ol>
    </details>
  </aside>

  <script is:inline>
    // Inline so the disclosure state is set before first paint. The headings
    // come later in the document, so the rest waits for DOMContentLoaded.
    document.querySelector('.toc-disclosure').open = matchMedia('(min-width: 901px)').matches;
    document.addEventListener('DOMContentLoaded', () => {
      const toc = document.querySelector('.entity-toc');
      if (!toc) return;
      const disclosure = toc.querySelector('.toc-disclosure');
      const mobile = matchMedia('(max-width: 900px)');
      mobile.addEventListener('change', () => { disclosure.open = !mobile.matches; });
      const items = Array.from(toc.querySelectorAll('.toc-item'));
      const byId = new Map(items.map((el) => [el.dataset.tocId, el]));
      const headings = items
        .map((el) => document.getElementById(el.dataset.tocId))
        .filter((h) => h);
      if (!headings.length) return;

      // Active = the topmost heading in a band near the top of the viewport,
      // else the last heading scrolled past.
      const visible = new Set();
      function setActive(id) {
        items.forEach((el) => { el.classList.remove('active'); el.querySelector('a').removeAttribute('aria-current'); });
        const el = byId.get(id);
        if (el) { el.classList.add('active'); el.querySelector('a').setAttribute('aria-current', 'location'); }
      }
      function pickActive() {
        if (visible.size > 0) {
          let top = null;
          let topY = Infinity;
          for (const h of headings) {
            if (!visible.has(h.id)) continue;
            const y = h.getBoundingClientRect().top;
            if (y < topY) { topY = y; top = h; }
          }
          if (top) { setActive(top.id); return; }
        }
        let last = headings[0];
        for (const h of headings) {
          if (h.getBoundingClientRect().top <= 120) last = h;
          else break;
        }
        setActive(last.id);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target.id);
            else visible.delete(e.target.id);
          }
          pickActive();
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
      );
      headings.forEach((h) => io.observe(h));
      pickActive();

      // Scroll with a small offset and move focus to the heading.
      toc.addEventListener('click', (e) => {
        const link = e.target.closest('a[href^="#"]');
        if (!link) return;
        const id = decodeURIComponent(link.getAttribute('href').slice(1));
        const target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        if (mobile.matches) disclosure.open = false;
        const y = target.getBoundingClientRect().top + window.scrollY - 24;
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        window.scrollTo({ top: y, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });
  </script>
)}
