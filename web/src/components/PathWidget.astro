---
interface Props {
  fromId: string;
  fromTitle: string;
}
const { fromId, fromTitle } = Astro.props;
const widgetId = `pw-${fromId}`;
---
<section class="path-widget" data-from-id={fromId} id={widgetId} data-pagefind-ignore>
  <div class="pw-head">
    <h2 class="section-heading">Find a path</h2>
    <a href={`/path/?from=${encodeURIComponent(fromId)}`} class="pw-full" aria-label="Open full path finder">
      Full finder &rarr;
    </a>
  </div>
  <p class="pw-intro">Find a chain of links from this entry to another.</p>
  <form class="pw-form" autocomplete="off">
    <div class="pw-from"><span class="path-label">From</span><strong>{fromTitle}</strong></div>
    <span class="pw-direction" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 12h17m-6-6 6 6-6 6" /></svg></span>
    <div class="pw-field">
      <label class="path-label" for={`${widgetId}-input`}>To</label>
      <input
        type="text"
        id={`${widgetId}-input`}
        class="pw-input path-input"
        placeholder="Search for an entry…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Destination entry"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls={`${widgetId}-suggest`}
      />
      <ul class="pw-suggest path-suggest" id={`${widgetId}-suggest`} role="listbox" aria-label="Target suggestions"></ul>
    </div>
    <button type="submit" class="pw-go path-go">Find connection <span aria-hidden="true">→</span></button>
  </form>
  <div class="pw-result" hidden></div>
  <div class="pw-status" role="status" aria-live="polite" hidden></div>
</section>

{/* Processed, not is:inline, so every entity page shares one cached bundle.
    Never add define:vars here: it forces the script inline. */}
<script>
  import { findPath, renderChain, entityCombobox } from '../scripts/path-find';
  import { loadAdjacency } from '../scripts/adjacency';

  const root = document.querySelector<HTMLElement>('.path-widget');
  if (root) {
    const fromId = root.dataset.fromId!;
    const input = root.querySelector<HTMLInputElement>('.pw-input')!;
    const result = root.querySelector<HTMLElement>('.pw-result')!;
    const status = root.querySelector<HTMLElement>('.pw-status')!;
    let toIdx = -1;

    const say = (text: string) => { status.textContent = text; status.hidden = false; };
    entityCombobox(input, root.querySelector('.pw-suggest')!, (i) => {
      toIdx = i;
      result.hidden = true;
      status.hidden = true;
    }, fromId);

    root.querySelector('.pw-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.hidden = true;
      result.replaceChildren();
      if (toIdx < 0) return say('Choose a destination from the suggestions.');
      say('Loading network…');
      const data = await loadAdjacency().catch(() => null);
      if (!data) return say('Could not load connections. Try again.');
      const si = data.ids.indexOf(fromId);
      if (si < 0) return say('Entity missing from network.');
      const path = findPath(data.adj, data.dir, si, toIdx);
      if (!path) return say(`No documented path to ${data.titles[toIdx]}.`);
      say(`${path.length - 1} hop${path.length === 2 ? '' : 's'}.`);
      result.append(renderChain(data, path));
      result.hidden = false;
    });
  }
</script>
