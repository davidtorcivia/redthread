---
// A static redirect page, for URLs that moved: works on any static host, keeps the #fragment.
import { absUrl } from '../lib/site.ts';

interface Props { to: string }
const { to } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={absUrl(to)} />
    <title>Moved</title>
  </head>
  <body><p>This page moved to <a href={to}>{to}</a>.</p></body>
</html>
