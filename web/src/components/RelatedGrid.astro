---
import { related, hrefFor, TYPE_LABELS } from '../lib/data.ts';
interface Props { id: string; limit?: number }
const { id, limit = 8 } = Astro.props;
const items = related(id).slice(0, limit);
---
{items.length > 0 && <section class="related-section statement-list" data-pagefind-ignore>
  <h2 class="section-heading">Connected to <span>by shared pages</span></h2>
  {items.map(r => <div class="statement-item">
    <div class="item-facts">
      <b>{r.count} shared</b> · {TYPE_LABELS[r.type]}
      {r.via?.length > 0 && <i>via {r.via.slice(0, 3).map((v, i) => <>{i > 0 && ', '}<a href={hrefFor(v)} data-preview>{v.title}</a></>)}</i>}
    </div>
    <a class="item-title" href={hrefFor(r)}>{r.title}</a>
  </div>)}
</section>}
